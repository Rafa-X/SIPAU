          "rowTotalColumns": ["Hombres", "Mujeres"],
          "rowTotalLabel": "Total (H + M)",
          "columnTotal": true
        },
        {
          "key": "personal_unidades",
          "text": "III.1 Personal de facultades, escuelas, centros o departamentos",
          "type": "matrix",
          "required": true,
          "rows": [
            "Directivo",
            "Docente (no incluya personal de investigación)",
            "Docente-Investigador y Docente-Auxiliar de Investigador",
            "Investigador",
            "Auxiliar de investigador",
            "Administrativo",
            "Otros (choferes, limpieza, servicios generales)"
          ],
          "columns": ["Hombres", "Mujeres", "Con discapacidad", "Hablantes de lengua indígena"],
          "rowTotal": true,
          "rowTotalColumns": ["Hombres", "Mujeres"],
          "rowTotalLabel": "Total (H + M)",
          "columnTotal": true
        },
        {
          "key": "personal_institucional_total",
          "text": "Total de personal de la institución",
          "type": "number",
          "helpText": "Se calcula con los hombres y las mujeres de los dos cuadros anteriores.",
          "sum": [
            "personal_central[Hombres]",
            "personal_central[Mujeres]",
            "personal_unidades[Hombres]",
            "personal_unidades[Mujeres]"
          ]
        }
      ]
    },
    {
