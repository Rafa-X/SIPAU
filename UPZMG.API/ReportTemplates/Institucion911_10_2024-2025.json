          "key": "ing_total",
          "text": "1. Total de ingresos",
          "type": "number",
          "measure": "amount",
          "helpText": "Se calcula con las cinco fuentes anteriores.",
          "sum": ["ing_federal", "ing_estatal", "ing_inscripciones", "ing_servicios", "ing_otros"]
