          "rows": ["Técnico Superior", "Licenciatura", "Posgrado"],
          "columns": ["Facultades / Escuelas / Centros", "Alumnos"],
          "columnTotal": true,
          "helpText": "Unidades y alumnos son cosas distintas: sólo se totaliza cada columna."
        },
        {
          "key": "unidades_no_escolar",
          "text": "1.1 Modalidad no escolarizada (mixta, abierta, virtual o a distancia)",
