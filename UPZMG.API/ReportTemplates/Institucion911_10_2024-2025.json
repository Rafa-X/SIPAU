        { "key": "nombre_rector", "text": "Nombre del rector o director de la institución", "type": "text", "required": true },
        { "key": "correo_responsable", "text": "Correo del responsable del llenado", "type": "text", "required": true }
      ]
    },
    {
      "key": "unidades",
      "title": "Facultades, escuelas, centros y alumnos",
