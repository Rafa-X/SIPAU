          "rows": ["Técnico Superior", "Licenciatura", "Posgrado"],
          "columns": ["Facultades / Escuelas / Centros", "Alumnos"],
          "columnTotal": true
        }
      ]
    },
    {
      "key": "personal",
      "title": "Personal central y de unidades académicas",
      "description": "Apartados II y III. El total institucional es la suma de las áreas centrales más el personal de facultades, escuelas y centros.",
      "questions": [
        {
          "key": "personal_central",
          "text": "II.1 Personal en áreas centrales (rectoría, oficinas administrativas)",
