        {
          "key": "personal_total",
          "text": "Total de personal de la escuela",
          "type": "number",
          "helpText": "Se calcula con los hombres y las mujeres del cuadro anterior.",
          "sum": ["personal_funcion[Hombres]", "personal_funcion[Mujeres]"]
        }
      ]
