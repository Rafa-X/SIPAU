@*
    Root document for the Blazor Web App (Interactive Server).
    MVC still serves the login POST/logout and the Home/Error pages, which
    keep their own _Layout.cshtml.
*@
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#0B1B3A" />
    <base href="/" />
    <link rel="icon" type="image/png" href="favicon.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400..800&family=Archivo+Narrow:wght@400..700&display=swap"
          rel="stylesheet" />

    <link rel="stylesheet" href="_content/MudBlazor/MudBlazor.min.css" />
    <link rel="stylesheet" href="app.css" />
    <link rel="stylesheet" href="document.css" />

    <HeadOutlet @rendermode="InteractiveServer" />
</head>
<body>
    <Routes @rendermode="InteractiveServer" />

    @* Blazor looks this element up by id and sets its state as a class; without it the notice it
       shows on its own is in English. *@
    <dialog id="components-reconnect-modal" class="sipau-reconnect" data-nosnippet aria-labelledby="sipau-reconnect-title">
        <div class="sipau-reconnect-spinner" aria-hidden="true"></div>
        <p id="sipau-reconnect-title" class="sipau-reconnect-title">Se perdió la conexión con el servidor</p>
        <p class="sipau-reconnect-when-trying">
            Estamos reconectando. Lo que escribiste sigue en pantalla: no cierres esta página.
        </p>
        <p class="sipau-reconnect-when-retrying">
            Sigue sin responder. Próximo intento en <span id="components-seconds-to-next-attempt"></span> s.
            Lo que escribiste sigue en pantalla: no cierres esta página.
        </p>
        <p class="sipau-reconnect-when-failed">
            No pudimos reconectar. Revisa tu conexión y vuelve a intentarlo; si recargas la página,
            se pierde lo que no hayas guardado.
        </p>
        <p class="sipau-reconnect-when-paused">
            Esta pantalla quedó en pausa por inactividad. Continúa donde te quedaste.
        </p>
        <p class="sipau-reconnect-when-resume-failed">
            No se pudo continuar donde te quedaste. Recarga la página; se pierde lo que no hayas guardado.
        </p>
        <div class="sipau-reconnect-actions">
            <button type="button" id="sipau-reconnect-retry" class="sipau-reconnect-btn">Volver a intentar</button>
            <button type="button" id="sipau-reconnect-resume" class="sipau-reconnect-btn">Continuar</button>
            <button type="button" id="sipau-reconnect-reload" class="sipau-reconnect-btn is-quiet">Recargar la página</button>
        </div>
    </dialog>

    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
    <script src="app.js?v=chapter-scroll-1" defer></script>
    <script src="_framework/blazor.web.js"></script>
</body>
</html>
