@*
    Module navigation — all modules are Blazor pages now.
*@
<MudNavMenu Class="pt-2" Bordered="true">

    <MudText Typo="Typo.caption" Class="px-4 pt-3 pb-1" Style="opacity:.55;text-transform:uppercase;letter-spacing:.6px">Operación</MudText>
    <MudNavLink Href="/dashboard" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.SpaceDashboard">Tablero de Control</MudNavLink>
    <MudNavLink Href="/datacapture" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.EditNote">Captura de Datos</MudNavLink>
    <MudNavLink Href="/charts" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.BarChart">Gráficas</MudNavLink>

    <MudText Typo="Typo.caption" Class="px-4 pt-3 pb-1" Style="opacity:.55;text-transform:uppercase;letter-spacing:.6px">Reportes</MudText>
    <MudNavLink OnClick="@(() => Nav.NavigateTo("/Reports", forceLoad: true))" Icon="@Icons.Material.Filled.Description">Reportes 911 / SII</MudNavLink>
    <MudNavLink Href="/boardreport" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Article">Informe de Junta</MudNavLink>
    <MudNavLink Href="/minutes" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Gavel">Actas de Junta</MudNavLink>

    <AuthorizeView Roles="Admin">
        <MudText Typo="Typo.caption" Class="px-4 pt-3 pb-1" Style="opacity:.55;text-transform:uppercase;letter-spacing:.6px">Administración</MudText>
        <MudNavLink Href="/settings" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Settings">Configuración</MudNavLink>
        <MudNavLink Href="/users" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.People">Usuarios</MudNavLink>
        <MudNavLink Href="/security" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Shield">Seguridad</MudNavLink>
    </AuthorizeView>

</MudNavMenu>
