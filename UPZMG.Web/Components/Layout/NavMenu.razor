<MudNavMenu Class="pt-2">

    <span class="sipau-nav-section"><span class="sipau-nav-section-label">Operación</span></span>
    <MudNavLink Href="/dashboard" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.SpaceDashboard">Tablero de Control</MudNavLink>
    <MudNavLink Href="/datacapture" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.EditNote">Captura de Datos</MudNavLink>
    <MudNavLink Href="/charts" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.QueryStats">Gráficas</MudNavLink>

    <span class="sipau-nav-section"><span class="sipau-nav-section-label">Reportes</span></span>
    <MudNavLink Href="/reports" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Description">Reportes 911 / SII</MudNavLink>
    <MudNavLink Href="/boardreport" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Article">Informe de Junta</MudNavLink>
    @* <MudNavLink Href="/minutes" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Gavel">Actas de Junta</MudNavLink> *@

    <AuthorizeView Policy="@AppPermissions.AnyAdministration">
        <span class="sipau-nav-section"><span class="sipau-nav-section-label">Administración</span></span>
        <MudNavLink Href="/settings" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Tune">Configuración</MudNavLink>
        <AuthorizeView Policy="@AppPermissions.ManageUsers" Context="administrator">
            <MudNavLink Href="/users" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.People">Usuarios</MudNavLink>
        </AuthorizeView>
    </AuthorizeView>

    <div class="sipau-rail-foot">
        <div style="font-weight:700;letter-spacing:.04em">SIPAU v@Version</div>
        <div style="opacity:.8">Universidad Politécnica de la ZMG</div>
    </div>

</MudNavMenu>

@code {
    // Read from the assembly so the rail cannot drift from what is actually deployed.
    private static readonly string Version =
        typeof(NavMenu).Assembly.GetName().Version?.ToString(2) ?? "0.0";
}
