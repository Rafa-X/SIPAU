@inject NavigationManager Nav

@*
    The router's answer to a screen the account may not open: say so when somebody is signed
    in, and send them to the login page when nobody is.
*@

<AuthorizeView>
    <Authorized>
        <NoPermissionNotice />
    </Authorized>
    <NotAuthorized>
        @* Not signed in at all: OnInitializedAsync sends them to the login page. *@
    </NotAuthorized>
</AuthorizeView>

@code {
    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState;
        if (state.User.Identity?.IsAuthenticated == true) return;

        // Inside a live connection this can only be a session that ran out, because a page opened
        // without one never gets this far. The person gets told, and comes back to the same screen.
        Nav.NavigateTo(RendererInfo.IsInteractive
            ? $"/login?error=inactividad&ReturnUrl={Uri.EscapeDataString("/" + Nav.ToBaseRelativePath(Nav.Uri))}"
            : "/login", forceLoad: true);
    }

    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = null!;
}
