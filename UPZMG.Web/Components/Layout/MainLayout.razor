@inherits LayoutComponentBase
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject IAuthorizationService Authorization
@using UPZMG.Implementations.Intelligence
@inject IIntelligenceService Ai

<MudThemeProvider @ref="_themeProvider" @bind-IsDarkMode="_isDarkMode" Theme="AppTheme.Institutional" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout Class="@(_isDarkMode ? "sipau-dark" : "sipau-light")">

    @* ─────────────────────────── Header ─────────────────────────── *@
    <MudAppBar Elevation="0">
        <MudTooltip Text="@(_drawerOpen ? "Contraer menú" : "Expandir menú")" Placement="Placement.Bottom">
            <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                           Class="sipau-appbar-btn" OnClick="ToggleDrawer" aria-label="Alternar menú" />
        </MudTooltip>

        <a class="sipau-brand ml-2" href="/dashboard" title="Ir al tablero de control">
            <span class="sipau-brand-seal">
                <img src="logo_UPZMG.png" alt="UPZMG" width="36" height="32" />
            </span>
            <div>
                <div class="sipau-brand-name">SIPAU</div>
                <div class="sipau-appbar-sub d-none d-md-block" style="font-size:10.5px;opacity:.6;letter-spacing:.04em">
                    UPZMG · Planeación
                </div>
            </div>
        </a>

        <MudSpacer />

        @* Quick-nav sits with the other tools on the right, not floating in
           the middle of the bar. *@
        <MudAutocomplete T="NavTarget" @ref="_quickNavRef"
                         Value="_quickNav" ValueChanged="GoToAsync"
                         SearchFunc="SearchNavAsync"
                         ToStringFunc="@(t => t?.Label ?? string.Empty)"
                         Placeholder="Buscar módulo…   Ctrl+K"
                         Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true"
                         Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                         ResetValueOnEmptyText="true" CoerceText="true" MaxItems="8"
                         Class="sipau-quicknav d-none d-md-flex mr-2">
            <ItemTemplate Context="target">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                    <MudIcon Icon="@target.Icon" Size="Size.Small" Color="Color.Secondary" />
                    <MudText Typo="Typo.body2">@target.Label</MudText>
                </MudStack>
            </ItemTemplate>
        </MudAutocomplete>

        @* Statistical alerts over the institutional series. Not a notification centre: there
           is no per-user read state, so the badge counts alerts detected, not unread ones. *@
        <MudMenu @bind-Open="_alertsOpen" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
            <ActivatorContent>
                @* A plain div, not a MudIconButton: a real <button> swallows the
                   click and the menu never opens. Enter and Space are handled here,
                   because a div with role="button" does not get them for free. *@
                <div class="sipau-appbar-trigger" role="button" tabindex="0" title="@AlertsLabel"
                     aria-label="@AlertsLabel" aria-haspopup="menu"
                     aria-expanded="@(_alertsOpen ? "true" : "false")"
                     @onclick="ToggleAlerts" @onclick:stopPropagation="true"
                     @onkeydown="OnAlertsKeyDown" @onkeydown:stopPropagation="true">
                    <MudBadge Content="@_anomalies.Count" Color="Color.Warning" Overlap="true" Bordered="true"
                              Visible="@(_anomalies.Count > 0)">
                        <MudIcon Icon="@(_alertsFailed ? Icons.Material.Filled.NotificationsOff : Icons.Material.Filled.NotificationsNone)" />
                    </MudBadge>
                </div>
            </ActivatorContent>
            <ChildContent>
                <div class="px-4 pt-3 pb-2 sipau-alert-panel">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Spacing="2">
                        <MudText Typo="Typo.subtitle2" Style="font-weight:700">Alertas de indicadores</MudText>
                        <MudIconButton Icon="@Icons.Material.Filled.Refresh" Size="Size.Small" Color="Color.Secondary"
                                       Disabled="_alertsLoading" aria-label="Actualizar alertas"
                                       OnClick="RefreshAlertsAsync" />
                    </MudStack>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@AlertsState</MudText>
                </div>
                <MudDivider />
                @if (_alertsLoading)
                {
                    <div class="px-4 py-3 sipau-alert-panel">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Consultando las series…</MudText>
                    </div>
                }
                else if (_alertsFailed)
                {
                    @* Never "sin desviaciones" on a failed read: that would be a statement about
                       the institution made on the strength of a request that did not happen. *@
                    <div class="px-4 py-3 sipau-alert-panel">
                        <MudStack Row="true" AlignItems="AlignItems.Start" Spacing="3">
                            <MudIcon Icon="@Icons.Material.Filled.CloudOff" Size="Size.Small" Color="Color.Error" />
                            <div>
                                <MudText Typo="Typo.body2" Style="font-weight:650;line-height:1.3">
                                    No se pudieron consultar las alertas
                                </MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    El servicio de indicadores no respondió, así que esta lista no dice nada sobre
                                    la matrícula, la aprobación ni las bajas.
                                </MudText>
                            </div>
                        </MudStack>
                    </div>
                }
                else if (_anomalies.Count == 0)
                {
                    <div class="px-4 py-3 sipau-alert-panel">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            No se detectaron alertas en el corte consultado.
                        </MudText>
                    </div>
                }
                @foreach (var a in _anomalies)
                {
                    <div class="px-4 py-3 sipau-alert-panel">
                        <MudStack Row="true" AlignItems="AlignItems.Start" Spacing="3">
                            <MudIcon Icon="@SeverityIcon(a.Severity)" Size="Size.Small" Color="@SeverityColor(a.Severity)" />
                            <div>
                                <MudText Typo="Typo.body2" Style="font-weight:650;line-height:1.3">@a.Title</MudText>
                                @if (!string.IsNullOrWhiteSpace(a.Period))
                                {
                                    <MudText Typo="Typo.caption" Style="font-weight:600">@a.Period</MudText>
                                }
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@a.Detail</MudText>
                            </div>
                        </MudStack>
                    </div>
                }
                <MudDivider />
                <MudButton FullWidth="true" Variant="Variant.Text" Color="Color.Secondary"
                           StartIcon="@Icons.Material.Filled.QueryStats"
                           OnClick="@(() => { _alertsOpen = false; Nav.NavigateTo("/charts"); })">
                    Ver la proyección de matrícula
                </MudButton>
            </ChildContent>
        </MudMenu>

        <MudTooltip Text="@(_isDarkMode ? "Modo claro" : "Modo oscuro")" Placement="Placement.Bottom">
            <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                           Color="Color.Inherit" Class="sipau-appbar-btn sipau-theme-btn"
                           OnClick="ToggleThemeAsync" aria-label="Cambiar tema" />
        </MudTooltip>

        <AuthorizeView Context="auth">
            <Authorized>
                <MudMenu @bind-Open="_userMenuOpen" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Dense="true">
                    <ActivatorContent>
                        @* Same reason as the bell: a div activator, so it carries its own
                           button semantics and its own keyboard handling. *@
                        <div class="sipau-user-trigger ml-2" role="button" tabindex="0"
                             aria-label="Cuenta y sesión" aria-haspopup="menu"
                             aria-expanded="@(_userMenuOpen ? "true" : "false")"
                             @onclick="@(() => _userMenuOpen = !_userMenuOpen)" @onclick:stopPropagation="true"
                             @onkeydown="OnUserMenuKeyDown" @onkeydown:stopPropagation="true">
                            <MudAvatar Size="Size.Small" Style="background:var(--sipau-plano);color:#fff;font-weight:700">
                                @Initials(auth.User)
                            </MudAvatar>
                            <span class="d-none d-sm-flex">@DisplayName(auth.User)</span>
                            <MudIcon Icon="@Icons.Material.Filled.ExpandMore" Size="Size.Small" />
                        </div>
                    </ActivatorContent>
                    <ChildContent>
                        <div class="px-4 py-3" style="min-width:250px">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                                <MudAvatar Style="background:var(--sipau-plano);color:#fff;font-weight:700">
                                    @Initials(auth.User)
                                </MudAvatar>
                                <div>
                                    <MudText Typo="Typo.body1" Style="font-weight:700;line-height:1.2">@DisplayName(auth.User)</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@Email(auth.User)</MudText>
                                </div>
                            </MudStack>
                            <div class="mt-3">
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Secondary"
                                         Icon="@Icons.Material.Filled.VerifiedUser">@Role(auth.User)</MudChip>
                            </div>
                        </div>
                        <MudDivider />
                        <form method="post" action="/Account/Logout" style="margin:0">
                            <AntiforgeryToken />
                            <button type="submit" class="sipau-logout-btn">
                                <MudIcon Icon="@Icons.Material.Filled.Logout" Size="Size.Small" Class="mr-2" />
                                Cerrar sesión
                            </button>
                        </form>
                    </ChildContent>
                </MudMenu>
            </Authorized>
        </AuthorizeView>
    </MudAppBar>

    @* ──────────────────── Navigation rail (collapsible) ──────────────────── *@
    @* Mini rail. It expands only from the header button — never on hover. *@
    <MudDrawer @bind-Open="_drawerOpen" Variant="DrawerVariant.Mini" OpenMiniOnHover="false"
               Breakpoint="Breakpoint.Md" ClipMode="DrawerClipMode.Always" Elevation="0">
        <NavMenu />
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-6">
            @* Keyed on the route so the entrance animation replays on every navigation. *@
            <div class="sipau-page" @key="Nav.Uri">
                @Body
            </div>
        </MudContainer>
    </MudMainContent>
</MudLayout>

<SessionHeartbeat />

<div id="blazor-error-ui">
    Ocurrió un error inesperado.
    <a href="" class="reload">Recargar</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private MudThemeProvider _themeProvider = null!;
    private bool _isDarkMode;
    private bool _drawerOpen = true;
    private bool _userMenuOpen;
    private bool _alertsOpen;

    private IReadOnlyList<AnomalyAlert> _anomalies = Array.Empty<AnomalyAlert>();
    private bool _alertsLoading = true;
    private bool _alertsFailed;
    private DateTime? _alertsReadAtUtc;

    private const string ThemeKey = "sipau.theme";

    protected override async Task OnInitializedAsync()
    {
        await RefreshAlertsAsync();
        await LoadNavTargetsAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        // Light / dark / system: nothing stored means "follow the operating system", which is
        // also what a reload used to lose because the choice lived only in this field.
        var stored = await ReadThemeAsync();
        var dark = stored switch
        {
            "dark" => true,
            "light" => false,
            _ => await _themeProvider.GetSystemDarkModeAsync(),
        };

        if (dark != _isDarkMode)
        {
            _isDarkMode = dark;
            StateHasChanged();
        }
    }

    /// <summary>
    /// Reads the alerts and remembers whether the read succeeded. The service answers null when
    /// it could not ask, and the panel must not turn that into "no deviations".
    /// </summary>
    private async Task RefreshAlertsAsync()
    {
        _alertsLoading = true;
        var alerts = await Ai.GetAnomaliesAsync();
        _alertsLoading = false;

        _alertsFailed = alerts is null;
        if (alerts is not null)
        {
            // A failed refresh keeps the previous list, marked as such by the state line.
            _anomalies = alerts;
            _alertsReadAtUtc = DateTime.UtcNow;
        }
    }

    private string AlertsLabel => _alertsFailed
        ? "Alertas de indicadores: no disponibles"
        : $"Alertas de indicadores: {_anomalies.Count} detectada(s)";

    private string AlertsState
    {
        get
        {
            if (_alertsLoading) return "Consultando…";
            if (_alertsFailed)
            {
                return _alertsReadAtUtc is { } stale
                    ? $"No disponible · se muestra la consulta de las {stale.ToLocalTime():HH:mm}"
                    : "No disponible";
            }

            var when = _alertsReadAtUtc?.ToLocalTime();
            return when is null
                ? "Desviaciones detectadas por el modelo estadístico"
                : $"{_anomalies.Count} alerta(s) detectada(s) · actualizado {when:HH:mm}";
        }
    }

    private void ToggleAlerts() => _alertsOpen = !_alertsOpen;

    private void OnAlertsKeyDown(KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or " " or "Spacebar") _alertsOpen = !_alertsOpen;
        else if (e.Key == "Escape") _alertsOpen = false;
    }

    private void OnUserMenuKeyDown(KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or " " or "Spacebar") _userMenuOpen = !_userMenuOpen;
        else if (e.Key == "Escape") _userMenuOpen = false;
    }

    private async Task ToggleThemeAsync()
    {
        _isDarkMode = !_isDarkMode;
        await WriteThemeAsync(_isDarkMode ? "dark" : "light");
    }

    // Browser storage can be unavailable (private window, blocked site data); the preference is
    // a convenience, so failing to read or write it must not break the layout.
    private async Task<string?> ReadThemeAsync()
    {
        try
        {
            return await JS.InvokeAsync<string?>("localStorage.getItem", ThemeKey);
        }
        catch (Exception ex) when (ex is JSException or InvalidOperationException)
        {
            return null;
        }
    }

    private async Task WriteThemeAsync(string value)
    {
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", ThemeKey, value);
        }
        catch (Exception ex) when (ex is JSException or InvalidOperationException)
        {
            // Not stored this time; the toggle still works for this session.
        }
    }

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    // ── Quick navigation ────────────────────────────────────────────────────
    /// <summary>
    /// A searchable destination in the header's quick-nav field.
    /// </summary>
    /// <param name="Policy">
    /// The permission the destination's screen requires, so the search offers the same places
    /// the menu does. It used to be a fixed list: everyone was offered usuarios, configuración,
    /// riesgo and finanzas, and the screen then refused them.
    /// </param>
    public sealed record NavTarget(string Label, string Href, string Icon, string? Policy = null);

    private NavTarget? _quickNav;
    private MudAutocomplete<NavTarget>? _quickNavRef;
    private IReadOnlyList<NavTarget> _navTargets = Array.Empty<NavTarget>();

    private static readonly NavTarget[] AllNavTargets =
    {
        new("Tablero de Control", "/dashboard", Icons.Material.Filled.SpaceDashboard),
        new("Captura de Datos", "/datacapture", Icons.Material.Filled.EditNote),
        new("Captura · Alumnos", "/datacapture/students", Icons.Material.Filled.School, AppPermissions.CaptureStudents),
        new("Captura · Docentes", "/datacapture/teachers", Icons.Material.Filled.Groups, AppPermissions.CaptureStaff),
        new("Captura · Infraestructura", "/datacapture/infrastructure", Icons.Material.Filled.Domain, AppPermissions.CaptureFacilities),
        new("Captura · Finanzas", "/datacapture/finance", Icons.Material.Filled.Payments, AppPermissions.CaptureFinance),
        new("Captura · Extensión", "/datacapture/extension", Icons.Material.Filled.Diversity3, AppPermissions.CaptureOutreach),
        new("Captura · Importación masiva", "/datacapture/bulk", Icons.Material.Filled.UploadFile, AppPermissions.CaptureStudentsOrStaff),
        new("Gráficas", "/charts", Icons.Material.Filled.BarChart, AppPermissions.ReadIndicators),
        new("Gráficas · Riesgo de deserción", "/charts/dropout", Icons.Material.Filled.PsychologyAlt, AppPermissions.ReadRisk),
        new("Reportes 911 / SII", "/reports", Icons.Material.Filled.Description, AppPermissions.CaptureReports),
        new("Informe de Junta", "/boardreport", Icons.Material.Filled.Article, AppPermissions.ReadBoardReport),
        new("Configuración", "/settings", Icons.Material.Filled.Settings, AppPermissions.AnyAdministration),
        new("Usuarios", "/users", Icons.Material.Filled.People, AppPermissions.ManageUsers),
    };

    /// <summary>Keeps only the destinations this account may open, asked once per circuit.</summary>
    private async Task LoadNavTargetsAsync()
    {
        var user = (await AuthState).User;
        var allowed = new List<NavTarget>(AllNavTargets.Length);

        foreach (var target in AllNavTargets)
        {
            if (target.Policy is null
                || (await Authorization.AuthorizeAsync(user, target.Policy)).Succeeded)
            {
                allowed.Add(target);
            }
        }

        _navTargets = allowed;
    }

    private Task<IEnumerable<NavTarget>> SearchNavAsync(string? value, CancellationToken token)
    {
        var matches = string.IsNullOrWhiteSpace(value)
            ? _navTargets.AsEnumerable()
            : _navTargets.Where(t => t.Label.Contains(value, StringComparison.OrdinalIgnoreCase));
        return Task.FromResult(matches);
    }

    private async Task GoToAsync(NavTarget? target)
    {
        _quickNav = null;
        if (target is null) return; // re-entry from the Clear below

        // Reset the field *and* its text, otherwise the old query stays visible
        // and an empty dropdown lingers under the header after navigating.
        if (_quickNavRef is not null) await _quickNavRef.ClearAsync();
        Nav.NavigateTo(target.Href);
    }

    // ── Alert presentation ──────────────────────────────────────────────────
    private static string SeverityIcon(string severity) => severity switch
    {
        "error" or "danger" => Icons.Material.Filled.ErrorOutline,
        "warning"           => Icons.Material.Filled.WarningAmber,
        _                   => Icons.Material.Filled.Info,
    };

    private static Color SeverityColor(string severity) => severity switch
    {
        "error" or "danger" => Color.Error,
        "warning"           => Color.Warning,
        _                   => Color.Info,
    };

    // ── Identity helpers ────────────────────────────────────────────────────
    private static string Email(ClaimsPrincipal u) => u.FindFirst(ClaimTypes.Email)?.Value ?? string.Empty;
    private static string Role(ClaimsPrincipal u) => u.FindFirst(ClaimTypes.Role)?.Value ?? "—";

    /// <summary>
    /// The name on the account, or the address when there is none. It used to be invented from
    /// the local part of the email, so "control.escolar@…" was shown a person called
    /// "Control Escolar" — a name the university never recorded.
    /// </summary>
    private static string DisplayName(ClaimsPrincipal u)
    {
        var name = u.FindFirst(ClaimTypes.Name)?.Value;
        if (!string.IsNullOrWhiteSpace(name)) return name;

        var email = Email(u);
        return string.IsNullOrWhiteSpace(email) ? "Usuario" : email;
    }

    private static string Initials(ClaimsPrincipal u)
    {
        var name = DisplayName(u);
        var parts = name.Split([' ', '.', '@'], StringSplitOptions.RemoveEmptyEntries);
        var ini = string.Concat(parts.Take(2).Select(p => char.ToUpperInvariant(p[0])));
        return string.IsNullOrEmpty(ini) ? "U" : ini;
    }

    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = null!;
}
