@inherits LayoutComponentBase
@inject NavigationManager Nav

<MudThemeProvider @ref="_themeProvider" @bind-IsDarkMode="_isDarkMode" Theme="AppTheme.Institutional" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="0">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                       OnClick="ToggleDrawer" aria-label="Menú" />

        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="ml-1">
            <span class="sigie-brand-mark">S</span>
            <MudText Typo="Typo.h6" Style="letter-spacing:.5px;font-weight:800">SIGIE</MudText>
            <MudText Typo="Typo.caption" Class="d-none d-md-flex" Style="opacity:.72">
                UPZMG · Sistema de Gestión Estadística
            </MudText>
        </MudStack>

        <MudSpacer />

        <MudTooltip Text="@(_isDarkMode ? "Modo claro" : "Modo oscuro")">
            <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                           Color="Color.Inherit" OnClick="@(() => _isDarkMode = !_isDarkMode)" aria-label="Tema" />
        </MudTooltip>

        <AuthorizeView Context="auth">
            <Authorized>
                <MudMenu @bind-Open="_userMenuOpen" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Dense="true">
                    <ActivatorContent>
                        <div class="sigie-user-trigger" @onclick="@(() => _userMenuOpen = !_userMenuOpen)" @onclick:stopPropagation="true">
                            <MudAvatar Size="Size.Small" Color="Color.Secondary">@Initials(auth.User)</MudAvatar>
                            <span class="d-none d-sm-flex">@DisplayName(auth.User)</span>
                            <MudIcon Icon="@Icons.Material.Filled.ArrowDropDown" Size="Size.Small" />
                        </div>
                    </ActivatorContent>
                    <ChildContent>
                        <div class="px-4 py-3" style="min-width:236px">
                            <MudText Typo="Typo.body1" Style="font-weight:700">@DisplayName(auth.User)</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@Email(auth.User)</MudText>
                            <div class="mt-1">
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="Color.Secondary">@Role(auth.User)</MudChip>
                            </div>
                        </div>
                        <MudDivider />
                        <form method="post" action="/Account/Logout" style="margin:0">
                            <AntiforgeryToken />
                            <button type="submit" class="sigie-logout-btn">
                                <MudIcon Icon="@Icons.Material.Filled.Logout" Size="Size.Small" Class="mr-2" />
                                Cerrar sesión
                            </button>
                        </form>
                    </ChildContent>
                </MudMenu>
            </Authorized>
        </AuthorizeView>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always"
               Elevation="0" Variant="DrawerVariant.Responsive">
        <NavMenu />
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-6">
            <div class="sigie-page" @key="Nav.Uri">
                @Body
            </div>
        </MudContainer>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui">
    Ocurrió un error inesperado.
    <a href="" class="reload">Recargar</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private MudThemeProvider _themeProvider = null!;
    private bool _isDarkMode;
    private bool _drawerOpen = true;
    private bool _userMenuOpen;

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    private static string Email(ClaimsPrincipal u) => u.FindFirst(ClaimTypes.Email)?.Value ?? string.Empty;
    private static string Role(ClaimsPrincipal u) => u.FindFirst(ClaimTypes.Role)?.Value ?? "—";

    private static string DisplayName(ClaimsPrincipal u)
    {
        var email = Email(u);
        if (string.IsNullOrWhiteSpace(email)) return "Usuario";
        var parts = email.Split('@')[0].Split('.', StringSplitOptions.RemoveEmptyEntries);
        return string.Join(" ", parts.Select(p => char.ToUpperInvariant(p[0]) + p[1..]));
    }

    private static string Initials(ClaimsPrincipal u)
    {
        var name = DisplayName(u);
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        var ini = string.Concat(parts.Take(2).Select(p => char.ToUpperInvariant(p[0])));
        return string.IsNullOrEmpty(ini) ? "U" : ini;
    }
}
