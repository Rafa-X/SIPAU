@page "/boardreport/{Cycle}"
@attribute [Authorize(Policy = AppPermissions.ReadBoardReport)]
@using UPZMG.Implementations.BoardReport
@inject IBoardReportService BoardSvc
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager Nav

@*
    The report as the university reviews it before sending it to the Junta: every figure comes
    from a format that was already sent, and the only editable parts are the narrative blocks.
*@

<PageTitle>Informe @Cycle — SIPAU</PageTitle>

@if (_loading)
{
    <PageHeader Title="@($"Informe del ciclo {Cycle}")" BackHref="/boardreport" />
    <LoadingState Text="Reuniendo las cifras de los formatos enviados…" />
}
else if (_document is null)
{
    <PageHeader Title="Informe no disponible" BackHref="/boardreport" />
    <SectionCard FullHeight="false">
        <EmptyState Title="No se pudo armar el informe"
                    Description="No hay formatos oficiales de este ciclo, o el API no respondió.">
            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="LoadAsync">Reintentar</MudButton>
        </EmptyState>
    </SectionCard>
}
else
{
    <PageHeader Title="@_document.Title" BackHref="/boardreport"
                Subtitle="@($"{_document.Chapters.Count} capítulos · {_document.Sources.Count(s => s.IsSubmitted)} de {_document.Sources.Count} formatos enviados")">
        <Actions>
            <span class="@(_document.IsSubmitted ? "sipau-report-status is-compact is-sent" : "sipau-report-status is-compact is-draft")">
                @(_document.IsSubmitted ? "Enviado" : "Borrador")
            </span>
            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Secondary"
                       StartIcon="@Icons.Material.Filled.Print" Href="@($"/boardreport/{Cycle}/documento")">
                Documento
            </MudButton>
            <AuthorizeView Policy="@AppPermissions.WriteBoardReport">
                @if (!_document.IsSubmitted)
                {
                    @* "Cerrar" and not "Enviar": what this does is freeze the document inside the
                       system. There is no mail or transport behind it, and saying "enviado a la
                       Junta" promised a delivery the system does not perform. *@
                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.LockClock" Disabled="_working" OnClick="ConfirmAndSubmitAsync">
                        Cerrar informe
                    </MudButton>
                }
            </AuthorizeView>
        </Actions>
    </PageHeader>

    @if (_document.Missing.Count > 0)
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mb-4">
            <b>Faltan formatos de este ciclo.</b>
            Los capítulos que dependen de ellos aparecen marcados como pendientes:
            @string.Join(", ", _document.Missing.Select(m => m.DisplayName)).
            <MudLink Href="/reports" Typo="Typo.body2" Class="ml-1">Ir a capturarlos</MudLink>
        </MudAlert>
    }
    else if (!_document.IsSubmitted)
    {
        <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Class="mb-4">
            Todas las áreas enviaron su formato. El informe puede enviarse a la Junta Directiva.
        </MudAlert>
    }

    <div class="sipau-capture">
        <aside class="sipau-capture-index">
            <SectionCard Title="Capítulos" FullHeight="false">
                <ol class="sipau-capture-steps">
                    @foreach (var chapter in _document.Chapters)
                    {
                        <li>
                            <a class="sipau-capture-step" href="@($"#cap-{chapter.Number}")">
                                <span class="sipau-capture-step-num">@chapter.Number</span>
                                <span class="sipau-capture-step-body">
                                    <span class="sipau-capture-step-title">@chapter.Title</span>
                                    <span class="sipau-capture-step-meta">@Pending(chapter)</span>
                                </span>
                            </a>
                        </li>
                    }
                </ol>
            </SectionCard>

            <SectionCard Title="Formatos que alimentan el informe" FullHeight="false">
                <ul class="sipau-risk-list">
                    @foreach (var source in _document.Sources)
                    {
                        <li>
                            <div class="sipau-risk-row">
                                <span class="sipau-risk-label">@source.DisplayName</span>
                                <span class="@(source.IsSubmitted ? "sipau-report-status is-compact is-sent" : "sipau-report-status is-compact is-dirty")">
                                    @(source.IsSubmitted ? "Enviado" : source.Status == "draft" ? "Borrador" : "Sin captura")
                                </span>
                            </div>
                            @if (source.OtherCaptures > 0)
                            {
                                <div class="sipau-risk-sub">
                                    Hay @source.OtherCaptures captura(s) más de este formato; el informe tomó la enviada más reciente.
                                </div>
                            }
                            @if (source.LastModified is { } modified && source.Status != "pending")
                            {
                                <div class="sipau-risk-sub">@ReportUi.Local(modified) @(source.CapturedBy is null ? "" : "· " + source.CapturedBy)</div>
                            }
                        </li>
                    }
                </ul>
            </SectionCard>
        </aside>

        <div class="sipau-capture-main">
            @foreach (var chapter in _document.Chapters)
            {
                <section id="@($"cap-{chapter.Number}")" class="sipau-board-chapter">
                    <SectionCard Title="@($"{chapter.Number}. {chapter.Title}")" Subtitle="@chapter.Summary" FullHeight="false">
                        @foreach (var block in chapter.Blocks)
                        {
                            @if (block.Kind == BoardReportBlockKinds.Narrative && block.BlockKey is { } key)
                            {
                                <div class="sipau-board-block">
                                    <h3 class="sipau-board-block-title">@block.Title</h3>

                                    @if (_editing == key)
                                    {
                                        <MudTextField @bind-Value="_draft" Lines="6" Variant="Variant.Outlined"
                                                      Immediate="true" AutoFocus="true"
                                                      Label="Texto del apartado" Class="mt-1" />
                                        <div class="sipau-editor-actions">
                                            <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                                                       Disabled="_working" OnClick="@(() => SaveAsync(key, _draft))">
                                                Guardar
                                            </MudButton>
                                            <MudButton Size="Size.Small" Variant="Variant.Text"
                                                       OnClick="@(() => _editing = null)">Cancelar</MudButton>
                                            <MudSpacer />
                                            @if (!block.IsSuggested)
                                            {
                                                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Secondary"
                                                           StartIcon="@Icons.Material.Filled.Undo"
                                                           Disabled="_working" OnClick="@(() => SaveAsync(key, null))">
                                                    Restaurar la sugerencia
                                                </MudButton>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <p class="@(block.IsSuggested ? "sipau-board-text is-suggested" : "sipau-board-text")">@block.Text</p>
                                        <div class="sipau-board-meta">
                                            <span class="sipau-doc-note">
                                                @(block.IsSuggested ? "Redacción sugerida por el sistema" : "Redactado por la universidad")
                                            </span>
                                            <AuthorizeView Policy="@AppPermissions.WriteBoardReport">
                                                @if (!_document.IsSubmitted)
                                                {
                                                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Secondary"
                                                               StartIcon="@Icons.Material.Filled.Edit"
                                                               OnClick="@(() => EditAsync(key, block.Text))">
                                                        Redactar
                                                    </MudButton>
                                                }
                                            </AuthorizeView>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <BoardBlock Block="block" />
                            }
                        }
                    </SectionCard>
                </section>
            }
        </div>
    </div>
}

@code {
    [Parameter] public string Cycle { get; set; } = string.Empty;

    private BoardReportDocument? _document;
    private bool _loading = true;
    private bool _working;
    private string? _editing;
    private string _draft = string.Empty;

    // What the open block said when it was opened, to tell an edited draft from an untouched one.
    private string? _editingOriginal;

    protected override Task OnParametersSetAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _document = await BoardSvc.GetDocumentAsync(Cycle);
        _loading = false;
    }

    /// <summary>
    /// Opens one narrative block for writing. Switching blocks with unsaved text used to
    /// replace the draft without asking, so the paragraph somebody had just written was gone.
    /// </summary>
    private async Task EditAsync(string key, string? text)
    {
        if (_editing is not null && _editing != key && _draft != (_editingOriginal ?? string.Empty))
        {
            var keep = await DialogService.ShowMessageBoxAsync(
                "Hay texto sin guardar",
                $"El bloque «{_editing}» tiene cambios que no se han guardado. Si cambias de bloque se descartan.",
                yesText: "Descartar y continuar", cancelText: "Seguir redactando");

            if (keep != true) return;
        }

        _editing = key;
        _draft = text ?? string.Empty;
        _editingOriginal = _draft;
    }

    private async Task SaveAsync(string key, string? text)
    {
        _working = true;
        var result = await BoardSvc.SaveNarrativeAsync(Cycle, key, text);
        _working = false;

        if (!result.Saved)
        {
            Snackbar.Add(result.Message ?? "No se pudo guardar el texto.", Severity.Error);
            return;
        }

        _editing = null;
        _editingOriginal = null;
        await LoadAsync();
        Snackbar.Add(string.IsNullOrWhiteSpace(text) ? "Se restauró la redacción sugerida." : "Texto guardado.", Severity.Success);
    }

    /// <summary>
    /// Closing the report freezes it: the narrative stops being editable and the figures it
    /// consolidates are stored as they are now. One click used to do all of that with no
    /// confirmation and no way back.
    /// </summary>
    private async Task ConfirmAndSubmitAsync()
    {
        if (_document is null) return;

        if (_editing is not null && _draft != (_editingOriginal ?? string.Empty))
        {
            Snackbar.Add("Guarda o descarta el bloque que estás redactando antes de cerrar el informe.", Severity.Warning);
            return;
        }

        var pending = _document.PendingNarratives;
        var detail = pending > 0
            ? $"Quedan {pending} bloque(s) con la redacción sugerida por el sistema. "
            : string.Empty;

        var confirmed = await DialogService.ShowMessageBoxAsync(
            $"Cerrar el informe del ciclo {Cycle}",
            $"{detail}Al cerrarlo, las cifras quedan congeladas tal como están hoy y la redacción ya no se "
            + "podrá cambiar. Para corregir algo habría que generar el informe del ciclo siguiente. "
            + "El documento no se envía por correo: se entrega desde la vista imprimible.",
            yesText: "Cerrar informe", cancelText: "Seguir editando");

        if (confirmed != true) return;

        _working = true;
        var result = await BoardSvc.SubmitAsync(Cycle);
        _working = false;

        if (!result.Saved)
        {
            Snackbar.Add(result.Message ?? "No se pudo cerrar el informe.", Severity.Warning);
            return;
        }

        await LoadAsync();
        Snackbar.Add("Informe cerrado: sus cifras quedaron congeladas y ya puede entregarse.", Severity.Success);
    }

    private static string Pending(BoardReportChapter chapter)
    {
        var pending = chapter.Blocks.Count(b => b.Kind == BoardReportBlockKinds.Pending);
        var suggested = chapter.Blocks.Count(b => b.Kind == BoardReportBlockKinds.Narrative && b.IsSuggested);

        if (pending > 0 && suggested > 0) return $"{pending} sin captura · {suggested} por redactar";
        if (pending > 0) return ReportUi.Plural(pending, "apartado sin captura", "apartados sin captura");
        if (suggested > 0) return ReportUi.Plural(suggested, "texto por redactar", "textos por redactar");
        return "Completo";
    }
}
