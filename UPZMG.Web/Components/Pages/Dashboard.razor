@page "/dashboard"
@attribute [Authorize]
@using UPZMG.Implementations.Dashboard
@using UPZMG.Implementations.Intelligence
@inject IDashboardService DashboardSvc
@inject IIntelligenceService Ai

<PageTitle>Tablero de Control — SIPAU</PageTitle>

<PageHeader Title="Tablero de Control"
            Subtitle="Cifras del periodo activo, contadas directamente de los datos capturados">
    <Actions>
        @if (_summary?.ActivePeriod is { } period)
        {
            <MudChip T="string" Color="Color.Secondary" Variant="Variant.Text" Icon="@Icons.Material.Filled.Event">
                Periodo @period.Period @period.SchoolCycle · @period.Code
            </MudChip>
        }
        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Secondary"
                   StartIcon="@Icons.Material.Filled.Refresh" Disabled="_loading" OnClick="LoadAsync">
            Actualizar
        </MudButton>
    </Actions>
</PageHeader>

@if (_loading)
{
    <LoadingState Text="Contando los datos capturados…" />
}
else if (_summary is null)
{
    <SectionCard FullHeight="false">
        <EmptyState Title="No se pudieron cargar las cifras"
                    Description="El API no respondió. Verifica que UPZMG.API esté corriendo e intenta de nuevo.">
            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="LoadAsync">Reintentar</MudButton>
        </EmptyState>
    </SectionCard>
}
else
{
    @if (_summary.ActivePeriod is null)
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Text" Class="mb-4">
            No hay un periodo activo. Las cifras del periodo aparecerán cuando actives uno en
            <MudLink Href="/settings/periods">Configuración › Periodos escolares</MudLink>.
        </MudAlert>
    }

    <MudGrid>
        <MudItem xs="12" sm="6" lg="3">
            <StatCard Title="Alumnos activos" Value="@_summary.ActiveStudents.ToString("N0")"
                      Subtitle="@($"{_summary.TotalStudents:N0} registrados en total")" />
        </MudItem>
        <MudItem xs="12" sm="6" lg="3">
            <StatCard Title="Nuevo ingreso" Value="@_summary.NewEnrollments.ToString("N0")"
                      Subtitle="en el periodo activo"
                      Delta="_intakeDelta" Spark="_intakeSpark" />
        </MudItem>
        <MudItem xs="12" sm="6" lg="3">
            <StatCard Title="Docentes" Value="@_summary.TotalTeachers.ToString("N0")"
                      Subtitle="@($"{_summary.TeachersWithPostgrad:N0} con posgrado")" />
        </MudItem>
        <MudItem xs="12" sm="6" lg="3">
            <StatCard Title="Grupos del periodo" Value="@_summary.ClassGroups.ToString("N0")"
                      Subtitle="@($"{_summary.GroupEnrolled:N0} inscritos de {_summary.GroupCapacity:N0} lugares")" />
        </MudItem>
    </MudGrid>

    <MudGrid Class="mt-1">
        <MudItem xs="12" lg="7">
            <SectionCard Title="Alumnos activos por carrera"
                         Subtitle="Alumnos con estatus activo, sin importar su periodo de ingreso"
                         Icon="@Icons.Material.Filled.School">
                @if (_summary.StudentsByCareer.Sum(c => c.Students) == 0)
                {
                    <EmptyState Title="Aún no hay alumnos activos"
                                Description="Captura alumnos en Captura de datos › Alumnos y aparecerán aquí por carrera." />
                }
                else
                {
                    <BarChart Labels="_careerLabels" Series="_careerSeries" Height="260"
                              AriaLabel="Alumnos activos por carrera" />
                }
            </SectionCard>
        </MudItem>

        <MudItem xs="12" lg="5">
            <SectionCard Title="Nuevo ingreso por periodo"
                         Subtitle="Alumnos según el periodo en que ingresaron, hasta el periodo activo"
                         Icon="@Icons.Material.Filled.Timeline">
                @if (_intakeLabels.Count < 2)
                {
                    <EmptyState Title="Faltan periodos para trazar la serie"
                                Description="La gráfica necesita al menos dos periodos registrados." />
                }
                else
                {
                    <TrendChart Labels="_intakeLabels" Series="_intakeSeries" Height="260" ShowLegend="false"
                                AriaLabel="Nuevo ingreso por periodo" />
                }
            </SectionCard>
        </MudItem>
    </MudGrid>

    @* Intelligent layer: projection and alerts for every area, dropout risk only for the areas that follow up on students. *@
    <MudGrid Class="mt-1">
        <MudItem xs="12" md="6" lg="@(_canSeeRisk ? 4 : 6)">
            <SectionCard Title="Proyección de matrícula"
                         Subtitle="Regresión lineal sobre los alumnos inscritos en cada periodo"
                         Icon="@Icons.Material.Filled.Timeline">
                <ChildContent>
                    @if (_aiLoading)
                    {
                        <LoadingState Text="Ajustando la regresión…" />
                    }
                    else if (_forecast.Labels.Count == 0)
                    {
                        <EmptyState Title="Sin historial suficiente"
                                    Description="Captura inscripciones en al menos un periodo para mostrar el historial." />
                    }
                    else
                    {
                        @if (_forecast.HasModel)
                        {
                            <div class="sipau-projection">
                                <span class="sipau-projection-figure">@(_forecast.NextValue?.ToString("N0"))</span>
                                <span class="sipau-projection-note">
                                    alumnos en @_forecast.NextLabel@(_forecast.NextMargin is { } margin ? $" · ± {margin:N0}" : "")
                                </span>
                            </div>
                        }
                        <TrendChart Labels="_forecast.Labels" Series="_forecastSeries" Height="150" ShowLegend="false"
                                    ForecastFromIndex="@(_forecast.HasModel ? _forecast.HistoricalCount : null)"
                                    AriaLabel="Matrícula observada y proyectada" />
                    }
                </ChildContent>
                <Footer>
                    @if (_forecast.HasModel)
                    {
                        <span>
                            Pendiente <b>@_forecast.Slope.ToString("+0.0;-0.0")</b> alumnos por periodo ·
                            @if (_forecast.R2 is { } r2)
                            {
                                <text>R² <b>@r2.ToString("0.00")</b> · </text>
                            }
                            <MudLink Href="/charts" Typo="Typo.caption">Ver en Gráficas</MudLink>
                        </span>
                    }
                </Footer>
            </SectionCard>
        </MudItem>

        <MudItem xs="12" md="6" lg="@(_canSeeRisk ? 4 : 6)">
            <SectionCard Title="Alertas del modelo"
                         Subtitle="Desviaciones en la matrícula, la aprobación y las bajas"
                         Icon="@Icons.Material.Filled.NotificationImportant">
                @if (_aiLoading)
                {
                    <LoadingState Text="Buscando desviaciones…" />
                }
                else if (_anomaliesFailed)
                {
                    <EmptyState Icon="@Icons.Material.Filled.CloudOff"
                                Title="No pudimos revisar las series"
                                Description="El servicio de indicadores no respondió, así que esta tarjeta no puede afirmar que no haya desviaciones." />
                }
                else if (_anomalies.Count == 0)
                {
                    <EmptyState Icon="@Icons.Material.Filled.Verified"
                                Title="Sin desviaciones"
                                Description="Ningún periodo se aparta de su comportamiento habitual." />
                }
                else
                {
                    <ul class="sipau-alert-list">
                        @foreach (var alert in _anomalies.Take(4))
                        {
                            <li class="sipau-alert">
                                <MudIcon Icon="@AlertIcon(alert.Severity)" Size="Size.Small" Color="@AlertColor(alert.Severity)" />
                                <div>
                                    <div class="sipau-alert-title">@alert.Title</div>
                                    <div class="sipau-alert-detail">@alert.Detail</div>
                                </div>
                            </li>
                        }
                    </ul>
                }
            </SectionCard>
        </MudItem>

        @if (_canSeeRisk)
        {
            <MudItem xs="12" lg="4">
                <SectionCard Title="Riesgo de deserción"
                             Subtitle="Alumnos activos que el árbol de decisión sugiere atender"
                             Icon="@Icons.Material.Filled.PsychologyAlt">
                    <ChildContent>
                        @if (_aiLoading)
                        {
                            <LoadingState Text="Evaluando trayectorias…" />
                        }
                        else if (_dropout is not { HasModel: true })
                        {
                            <EmptyState Title="Todavía no hay modelo"
                                        Description="@(_dropout?.Status ?? "No se pudo consultar el modelo de deserción.")" />
                        }
                        else
                        {
                            <div class="sipau-projection">
                                <span class="sipau-projection-figure">@_dropout.AtRiskStudents.ToString("N0")</span>
                                <span class="sipau-projection-note">
                                    por atender de @_dropout.ScoredStudents.ToString("N0") evaluados · @_dropout.HighRiskStudents.ToString("N0") en riesgo alto
                                </span>
                            </div>
                            <ul class="sipau-risk-list">
                                @foreach (var career in _dropout.ByCareer)
                                {
                                    <li>
                                        <div class="sipau-risk-row">
                                            <span class="sipau-risk-label">@career.Career</span>
                                            <span class="sipau-risk-num">@career.AtRisk de @career.Students · @career.AtRiskPct.ToString("0") %</span>
                                        </div>
                                        <Meter Value="@career.AtRiskPct" />
                                    </li>
                                }
                            </ul>
                        }
                    </ChildContent>
                    <Footer>
                        @if (_dropout is { HasModel: true })
                        {
                            <span>
                                Detecta el <b>@((_dropout.Quality.Recall * 100).ToString("0")) %</b> de las bajas en validación ·
                                <MudLink Href="/charts/dropout" Typo="Typo.caption">Ver alumnos</MudLink>
                            </span>
                        }
                    </Footer>
                </SectionCard>
            </MudItem>
        }
    </MudGrid>

    <MudGrid Class="mt-1">
        <MudItem xs="12">
            <SectionCard Title="Indicadores académicos"
                         Subtitle="Aprovechamiento, deserción y eficiencia terminal"
                         Icon="@Icons.Material.Filled.Insights" FullHeight="false">
                <ChildContent>
                    @if (_indicators is null)
                    {
                        <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
                    }
                    else if (!_indicators.HasData)
                    {
                        <EmptyState Title="Sin periodos calificados"
                                    Description="En cuanto haya calificaciones capturadas, los tres indicadores se calculan solos." />
                    }
                    else
                    {
                        <div class="sipau-indicators">
                            <div>
                                <span class="sipau-field-label">Aprovechamiento</span>
                                <b>@(_indicators.Achievement?.ToString("0.00") ?? "—")</b>
                                <span class="sipau-indicator-note">promedio de calificaciones · @_indicators.PeriodLabel</span>
                            </div>
                            <div>
                                <span class="sipau-field-label">Deserción</span>
                                <b>@(_indicators.DropoutRate?.ToString("0.00") ?? "—") %</b>
                                <span class="sipau-indicator-note">
                                    @_indicators.WithdrawnStudents.ToString("N0") bajas de @_indicators.EnrolledStudents.ToString("N0") inscritos
                                </span>
                            </div>
                            <div>
                                <span class="sipau-field-label">Eficiencia terminal</span>
                                <b>@(_indicators.TerminalEfficiency?.ToString("0.00") ?? "—") %</b>
                                <span class="sipau-indicator-note">
                                    @if (_indicators.CohortLabel is { } cohort)
                                    {
                                        <text>@_indicators.CohortGraduates.ToString("N0") egresados de @_indicators.CohortEntrants.ToString("N0") · generación @cohort</text>
                                    }
                                    else
                                    {
                                        <text>ninguna generación ha cumplido su duración</text>
                                    }
                                </span>
                            </div>
                        </div>
                    }
                </ChildContent>
                <Footer>
                    <span>Fórmulas del SII: el aprovechamiento es el promedio de calificaciones, no la tasa de aprobación.</span>
                </Footer>
            </SectionCard>
        </MudItem>
    </MudGrid>
}

@code {
    // Areas the API lets see per-student dropout risk.
    private const string RiskRoles = "Admin,Control Escolar,Servicios Estudiantiles,Direccion Academica";

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private DashboardSummary? _summary;
    private AcademicIndicators? _indicators;
    private bool _loading = true;

    private bool _aiLoading = true;
    private bool _canSeeRisk;
    private EnrollmentForecast _forecast = EnrollmentForecast.None;
    private IReadOnlyList<ChartSeriesData> _forecastSeries = [];
    private IReadOnlyList<AnomalyAlert> _anomalies = [];
    private bool _anomaliesFailed;
    private DropoutModelReport? _dropout;

    private IReadOnlyList<string> _careerLabels = [];
    private IReadOnlyList<ChartSeriesData> _careerSeries = [];
    private IReadOnlyList<string> _intakeLabels = [];
    private IReadOnlyList<ChartSeriesData> _intakeSeries = [];
    private double[]? _intakeSpark;
    private double? _intakeDelta;

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null)
        {
            var user = (await AuthState).User;
            _canSeeRisk = RiskRoles.Split(',').Any(user.IsInRole);
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _summary = await DashboardSvc.GetSummaryAsync();
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            // API down or refused the call: show a retry instead of breaking the page.
            _summary = null;
        }
        finally
        {
            _loading = false;
        }

        if (_summary is not null)
            BuildCharts(_summary);

        // Indicators query the records directly, so they are cheap and never block the counts.
        _indicators = await DashboardSvc.GetIndicatorsAsync();

        await LoadIntelligenceAsync();
    }

    // After the counts, so the main figures never wait for a model to train.
    private async Task LoadIntelligenceAsync()
    {
        _aiLoading = true;
        StateHasChanged();

        var forecast = Ai.GetForecastAsync(2);
        var anomalies = Ai.GetAnomaliesAsync();
        var dropout = _canSeeRisk ? Ai.GetDropoutReportAsync() : Task.FromResult<DropoutModelReport?>(null);

        // Null is "the service did not answer", which the cards below say out loud instead of
        // showing the same thing as "there is nothing to report".
        _forecast = await forecast ?? EnrollmentForecast.None;
        var alerts = await anomalies;
        _anomaliesFailed = alerts is null;
        _anomalies = alerts ?? [];
        _dropout = await dropout;

        _forecastSeries = _forecast.HasModel
            ?
            [
                new ChartSeriesData("Matrícula", _forecast.Actual, ChartPalette.Teal, Filled: true),
                new ChartSeriesData("Tendencia", _forecast.Trend, ChartPalette.Neutral, Dashed: true),
            ]
            : [new ChartSeriesData("Matrícula", _forecast.Actual, ChartPalette.Teal, Filled: true)];
        _aiLoading = false;
    }

    private static string AlertIcon(string severity) => severity switch
    {
        "error" => Icons.Material.Filled.ErrorOutline,
        "warning" => Icons.Material.Filled.WarningAmber,
        _ => Icons.Material.Filled.Info,
    };

    private static Color AlertColor(string severity) => severity switch
    {
        "error" => Color.Error,
        "warning" => Color.Warning,
        _ => Color.Info,
    };

    private void BuildCharts(DashboardSummary summary)
    {
        _careerLabels = summary.StudentsByCareer.Select(c => c.Alias).ToList();
        _careerSeries =
        [
            new ChartSeriesData("Alumnos activos", summary.StudentsByCareer.Select(c => (double)c.Students).ToList(), ChartPalette.Navy),
        ];

        var activeIndex = summary.ActivePeriod is null
            ? -1
            : summary.IntakeByPeriod.ToList().FindIndex(p => p.PeriodId == summary.ActivePeriod.Id);

        // The series stops at the active period. The calendar already holds the periods that
        // follow, and with no intake yet they drew the line falling to zero: a collapse that
        // has not happened.
        var shown = activeIndex >= 0
            ? summary.IntakeByPeriod.Take(activeIndex + 1).ToList()
            : summary.IntakeByPeriod.ToList();

        var intake = shown.Select(p => (double)p.Students).ToArray();
        _intakeLabels = shown.Select(p => p.Period).ToList();
        _intakeSeries = [new ChartSeriesData("Nuevo ingreso", intake, ChartPalette.Teal, Filled: true)];
        _intakeSpark = intake.Length > 1 ? intake : null;

        // Compare against the period right before the active one, only if it had intake.
        _intakeDelta = null;

        if (activeIndex > 0 && intake[activeIndex - 1] > 0)
            _intakeDelta = Math.Round((intake[activeIndex] - intake[activeIndex - 1]) / intake[activeIndex - 1] * 100, 1);
    }
}
