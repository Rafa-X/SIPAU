@page "/datacapture/teachers/consult"
@attribute [Authorize(Policy = AppPermissions.CaptureStaff)]
@using UPZMG.Implementations.DataCapture
@inject IDataCaptureService CaptureSvc
@inject IJSRuntime JS

<PageTitle>Consultar personal — SIPAU</PageTitle>

<PageHeader Title="Consultar personal" BackHref="/datacapture"
            Subtitle="Docentes y personal administrativo registrados en el sistema" />

@if (_loading)
{
    <LoadingState Text="Leyendo la plantilla de personal…" />
}
else if (_loadFailed)
{
    <SectionCard FullHeight="false">
        <EmptyState Icon="@Icons.Material.Filled.CloudOff"
                    Title="No pudimos leer el listado"
                    Description="El servicio no respondió, así que esta pantalla no puede afirmar que no haya registros. Vuelve a cargar la página; si sigue así, avisa a Tecnologías." />
    </SectionCard>
}
else if (_staff.Count == 0)
{
    <SectionCard FullHeight="false">
        <EmptyState Icon="@Icons.Material.Filled.Groups"
                    Title="Sin personal registrado"
                    Description="Captura a una persona y aparecerá aquí.">
            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Href="/datacapture/teachers">
                Capturar personal
            </MudButton>
        </EmptyState>
    </SectionCard>
}
else
{
    <SectionCard Flush="true" FullHeight="false">
        <DataToolbar @bind-Search="_search" Placeholder="Buscar por nombre o número de empleado…"
                     Count="Filtered.Count" Total="_staff.Count" OnExport="ExportAsync">
            <Filters>
                <MudSelect T="string" @bind-Value="_kind" Dense="true" Variant="Variant.Outlined" Margin="Margin.Dense"
                           Class="sipau-toolbar-filter-wide mt-0" Placeholder="Tipo de personal" Clearable="true">
                    <MudSelectItem T="string" Value="@(null!)">Todo el personal</MudSelectItem>
                    <MudSelectItem T="string" Value="@Teachers">Docentes</MudSelectItem>
                    <MudSelectItem T="string" Value="@NotTeachers">No docentes</MudSelectItem>
                </MudSelect>
            </Filters>
        </DataToolbar>

        <MudDataGrid T="EmployeeListItem" Items="Filtered" Hover="true" Dense="true" Elevation="0"
                     RowsPerPage="25" SortMode="SortMode.Single">
            <Columns>
                <PropertyColumn Property="x => x.EmployeeNumber" Title="Número" />
                <PropertyColumn Property="x => x.FullName" Title="Nombre" />
                <PropertyColumn Property="x => x.Email" Title="Correo" />
                <TemplateColumn Title="Tipo" SortBy="x => x.IsTeacher">
                    <CellTemplate>@KindOf(context.Item)</CellTemplate>
                </TemplateColumn>
                <PropertyColumn Property="x => x.EducationLevel" Title="Nivel de estudios" />
                <TemplateColumn Title="Primera contratación" SortBy="x => x.FirstHiredDate">
                    <CellTemplate>@context.Item.FirstHiredDate.ToString("dd/MM/yyyy")</CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="" Sortable="false" CellClass="sipau-cell-end">
                    <CellTemplate>
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Edit"
                                   Href="@($"/datacapture/teachers/{context.Item.Id}/editar")">Corregir</MudButton>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <NoRecordsContent>
                <EmptyState Icon="@Icons.Material.Filled.SearchOff" Title="Sin coincidencias"
                            Description="Nadie coincide con la búsqueda." />
            </NoRecordsContent>
            <PagerContent>
                <MudDataGridPager T="EmployeeListItem" PageSizeOptions="@(new[] { 25, 50, 100 })"
                                  RowsPerPageString="Filas por página"
                                  InfoFormat="{first_item}–{last_item} de {all_items}" />
            </PagerContent>
        </MudDataGrid>
    </SectionCard>
}

@code {
    private const string Teachers = "docentes";
    private const string NotTeachers = "no-docentes";

    private IReadOnlyList<EmployeeListItem> _staff = [];
    private bool _loading = true;
    private bool _loadFailed;
    private string _search = string.Empty;
    private string? _kind;

    protected override async Task OnInitializedAsync()
    {
        var rows = await CaptureSvc.GetEmployeesListAsync();
        // Null is "the listing could not be read", which is not the same as having none.
        _loadFailed = rows is null;
        _staff = rows ?? [];
        _loading = false;
    }

    private List<EmployeeListItem> Filtered => _staff.Where(Matches).ToList();

    private static string KindOf(EmployeeListItem employee) => employee.IsTeacher ? "Docente" : "No docente";

    private bool Matches(EmployeeListItem employee)
    {
        if (_kind == Teachers && !employee.IsTeacher) return false;
        if (_kind == NotTeachers && employee.IsTeacher) return false;

        if (string.IsNullOrWhiteSpace(_search)) return true;
        var query = _search.Trim();
        return employee.FullName.Contains(query, StringComparison.CurrentCultureIgnoreCase)
            || employee.EmployeeNumber.ToString().Contains(query, StringComparison.OrdinalIgnoreCase)
            || employee.Email.Contains(query, StringComparison.OrdinalIgnoreCase);
    }

    private async Task ExportAsync()
    {
        var csv = CsvExport.Build(Filtered,
            ("Número", t => t.EmployeeNumber),
            ("Nombre", t => t.FullName),
            ("Correo", t => t.Email),
            ("Tipo", t => KindOf(t)),
            ("Nivel de estudios", t => t.EducationLevel),
            ("Primera contratación", t => t.FirstHiredDate.ToString("dd/MM/yyyy")));

        await JS.InvokeVoidAsync("sigieDownload", CsvExport.FileName("personal"), csv);
    }
}
