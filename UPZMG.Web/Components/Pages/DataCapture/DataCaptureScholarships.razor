@page "/datacapture/scholarships"
@attribute [Authorize]
@using UPZMG.Implementations.DataCapture
@using UPZMG.Shared.Enums
@inject IDataCaptureService CaptureSvc
@inject IGeneralDataService GeneralDataSvc
@inject ISecurityService SecuritySvc
@inject ISnackbar Snackbar
@inject NavigationManager Nav

@*
    One row per grant, per student and period. The 911 and SII ask for the split by source and
    the amount granted, and neither can be recovered from a total typed into a format.
*@

<PageTitle>Captura de Becas — SIPAU</PageTitle>

<PageHeader Eyebrow="Captura de datos" Title="Captura de Becas"
            Subtitle="Becas asignadas por alumno y periodo" BackHref="/datacapture">
    <Actions>
        <MudButton Variant="Variant.Text" Color="Color.Primary" Href="/datacapture/scholarships/consult"
                   StartIcon="@Icons.Material.Filled.ListAlt">Consultar becas</MudButton>
    </Actions>
</PageHeader>

<MudPaper Elevation="1" Class="pa-6">
    <MudForm @ref="_form">
        <MudText Typo="Typo.h6" Class="mb-3">Beca asignada</MudText>
        <MudGrid>
            <MudItem md="4">
                <MudTextField @bind-Value="_enrollmentNumber" Label="Matrícula del alumno"
                              Required="true" RequiredError="Indica la matrícula." MaxLength="20"
                              HelperText="Debe corresponder a un alumno ya capturado." />
            </MudItem>
            <MudItem md="5">
                <MudSelect T="Guid" @bind-Value="_programId" Label="Programa de beca"
                           Required="true" RequiredError="Elige el programa.">
                    @foreach (var program in _programs)
                    {
                        <MudSelectItem T="Guid" Value="@program.Id">@program.Value</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem md="3">
                <MudSelect T="FinantialSource" @bind-Value="_source" Label="Fuente de financiamiento">
                    @foreach (var source in Enum.GetValues<FinantialSource>())
                    {
                        <MudSelectItem T="FinantialSource" Value="@source">@source</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <MudItem md="4">
                <MudSelect T="Guid" @bind-Value="_periodId" Label="Periodo"
                           Required="true" RequiredError="Elige el periodo.">
                    @foreach (var period in _periods)
                    {
                        <MudSelectItem T="Guid" Value="@period.Id">@period.Value</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem md="4">
                <MudNumericField T="decimal" @bind-Value="_amount" Label="Monto" Min="0" Format="N2"
                                 Adornment="Adornment.Start" AdornmentText="$" />
            </MudItem>
            <MudItem md="4">
                <MudDatePicker @bind-Date="_assignedDate" Label="Fecha de asignación" />
            </MudItem>

            <MudItem md="12">
                <MudTextField @bind-Value="_objective" Label="Objetivo de la beca (opcional)" MaxLength="100" />
            </MudItem>
        </MudGrid>

        <MudStack Row="true" Spacing="2" Class="mt-6">
            <MudButton Variant="Variant.Filled" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Save"
                       Disabled="_saving" OnClick="Submit">Guardar beca</MudButton>
            <MudButton Variant="Variant.Outlined" OnClick="@(() => Nav.NavigateTo("/datacapture"))">Cancelar</MudButton>
        </MudStack>
    </MudForm>
</MudPaper>

@code {
    private MudForm _form = null!;
    private bool _saving;

    private IReadOnlyList<LookupOption> _programs = [];
    private IReadOnlyList<PeriodLookupOption> _periods = [];

    private string _enrollmentNumber = string.Empty;
    private Guid _programId;
    private Guid _periodId;
    private FinantialSource _source = FinantialSource.Federal;
    private decimal _amount;
    private DateTime? _assignedDate = DateTime.Today;
    private string _objective = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var programsTask = CaptureSvc.GetScholarshipProgramsAsync();
        var periodsTask = GeneralDataSvc.GetPeriodsAsync();
        await Task.WhenAll(programsTask, periodsTask);

        _programs = await programsTask;
        _periods = await periodsTask;

        // Periods arrive oldest first; grants are almost always captured for the newest.
        _periodId = _periods.LastOrDefault()?.Id ?? Guid.Empty;
        _programId = _programs.FirstOrDefault()?.Id ?? Guid.Empty;
    }

    private async Task Submit()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid) return;

        if (_programId == Guid.Empty || _periodId == Guid.Empty)
        {
            Snackbar.Add("Elige el programa de beca y el periodo.", Severity.Warning);
            return;
        }

        _saving = true;
        try
        {
            await CaptureSvc.CreateScholarship(new CreateScholarship
            {
                RequesterKey = await SecuritySvc.GetRequesterKeyAsync(),
                StudentEnrollmentNumber = _enrollmentNumber.Trim(),
                ScolarshipProgramId = _programId,
                PeriodId = _periodId,
                FinantialSource = _source,
                Amount = _amount,
                ScolarshipObjective = string.IsNullOrWhiteSpace(_objective) ? null : _objective.Trim(),
                AssignedDate = _assignedDate is { } assigned ? DateOnly.FromDateTime(assigned) : null,
            });
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            return;
        }
        finally
        {
            _saving = false;
        }

        Snackbar.Add($"Beca de {_enrollmentNumber.Trim()} guardada correctamente.", Severity.Success);
        Nav.NavigateTo("/datacapture/scholarships/consult");
    }
}
