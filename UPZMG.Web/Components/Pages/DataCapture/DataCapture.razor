@page "/datacapture"
@attribute [Authorize]
@using UPZMG.Implementations.Dashboard
@inject IDashboardService DashboardSvc
@inject IGeneralDataService GeneralDataSvc
@inject IDataCaptureService CaptureSvc
@inject IAuthorizationService Authorization

@*
    What each area has stored today. Areas without a table of their own say so instead of
    showing a progress bar that measures nothing.
*@

<PageTitle>Captura de Datos — SIPAU</PageTitle>

<PageHeader Title="Captura de Datos"
            Subtitle="Registro de la información institucional. Lo capturado aquí alimenta el tablero, las gráficas, los formatos oficiales y el Informe de Junta.">
    <Actions>
        @if (_summary?.ActivePeriod is { } period)
        {
            <MudChip T="string" Color="Color.Secondary" Variant="Variant.Text" Icon="@Icons.Material.Filled.Event">
                Periodo @period.Period @period.SchoolCycle
            </MudChip>
        }
        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Secondary"
                   StartIcon="@Icons.Material.Filled.UploadFile" Href="/datacapture/bulk">
            Importación masiva
        </MudButton>
    </Actions>
</PageHeader>

@if (_loading)
{
    <LoadingState Text="Contando lo capturado…" />
}
else
{
    <MudGrid>
        @foreach (var area in Areas)
        {
            <MudItem xs="12" sm="6" lg="4">
                <SectionCard Title="@area.Name" Subtitle="@area.Responsible" Icon="@area.Icon">
                    <ChildContent>
                        @if (area.Stored is { } stored)
                        {
                            <div class="sipau-projection">
                                <span class="sipau-projection-figure">@stored.ToString("N0")</span>
                                <span class="sipau-projection-note">@area.Unit</span>
                            </div>
                            <div class="sipau-risk-sub">@area.Detail</div>
                        }
                        else
                        {
                            <p class="sipau-board-pending">@area.Detail</p>
                        }
                    </ChildContent>
                    <Footer>
                        <MudStack Row="true" Spacing="2" Style="flex-wrap:wrap">
                            @if (area.CaptureHref is { } capture)
                            {
                                <MudButton Size="Size.Small" Variant="@(area.Stored is null ? Variant.Outlined : Variant.Filled)"
                                           Color="@(area.Stored is null ? Color.Secondary : Color.Primary)"
                                           StartIcon="@Icons.Material.Filled.EditNote" Href="@capture">
                                    @(area.Stored is null ? "Ver formulario" : "Capturar")
                                </MudButton>
                            }
                            @if (area.ConsultHref is { } consult)
                            {
                                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Secondary"
                                           StartIcon="@Icons.Material.Filled.ListAlt" Href="@consult">
                                    Consultar
                                </MudButton>
                            }
                        </MudStack>
                    </Footer>
                </SectionCard>
            </MudItem>
        }
    </MudGrid>
}

@code {
    private DashboardSummary? _summary;
    // Nullable on purpose: null is "this listing could not be read", and the card already
    // knows how to show no figure. A zero is a claim that the area has captured nothing.
    private int? _facilities;
    private int? _outreachProjects;
    private int _outreachHours;
    private int? _fiscalYears;
    private int? _lastFiscalYear;
    private int? _scholarships;
    private int? _titulations;
    private bool _loading = true;

    // Whether this account may read each area's own listing. The API refuses the others, and
    // their cards said "No se pudo leer…" as if something had failed.
    private bool _readsOutreach, _readsScholarships, _readsTitulations, _readsFinance;
    private const string NotYourArea = "Tu rol no consulta esta área.";

    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = null!;

    private sealed record CaptureArea(
        string Name, string Responsible, string Icon, int? Stored, string Unit, string Detail,
        string? CaptureHref, string? ConsultHref);

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthState).User;
        async Task<bool> May(string permission) => (await Authorization.AuthorizeAsync(user, permission)).Succeeded;
        _readsOutreach = await May(AppPermissions.CaptureOutreach);
        _readsScholarships = await May(AppPermissions.CaptureScholarships);
        _readsTitulations = await May(AppPermissions.CaptureTitulation);
        _readsFinance = await May(AppPermissions.CaptureFinance);

        try
        {
            _summary = await DashboardSvc.GetSummaryAsync();
            _facilities = (await GeneralDataSvc.GetFacilitiesAsync()).Count;

            // Each listing keeps its own result. One area failing used to leave the others
            // showing zeros, because every count had already been set to zero by default.
            if (_readsOutreach)
            {
                var projects = await CaptureSvc.GetOutreachListAsync();
                _outreachProjects = projects?.Count;
                _outreachHours = projects?.Sum(p => p.AccreditedHours) ?? 0;
            }

            if (_readsScholarships) _scholarships = (await CaptureSvc.GetScholarshipsAsync())?.Count;
            if (_readsTitulations) _titulations = (await CaptureSvc.GetTitulationsAsync())?.Count;

            if (_readsFinance)
            {
                var finances = await CaptureSvc.GetFinanceListAsync();
                _fiscalYears = finances?.Count;
                _lastFiscalYear = finances is null or { Count: 0 } ? null : finances.Max(f => f.FiscalYear);
            }
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException)
        {
            _summary = null;
        }

        _loading = false;
    }

    private List<CaptureArea> Areas =>
    [
        new("Alumnos", "Control Escolar", Icons.Material.Filled.School,
            _summary?.TotalStudents, "alumnos registrados",
            $"{_summary?.ActiveStudents ?? 0:N0} con estatus activo · {_summary?.NewEnrollments ?? 0:N0} de nuevo ingreso en el periodo",
            "/datacapture/students", "/datacapture/students/consult"),

        new("Docentes y personal", "Recursos Humanos", Icons.Material.Filled.Groups,
            _summary?.TotalTeachers, "docentes registrados",
            $"{_summary?.TeachersWithPostgrad ?? 0:N0} con posgrado",
            "/datacapture/teachers", "/datacapture/teachers/consult"),

        new("Grupos de clase", "Dirección Académica", Icons.Material.Filled.Class,
            _summary?.ClassGroups, "grupos del periodo activo",
            $"{_summary?.GroupEnrolled ?? 0:N0} inscritos de {_summary?.GroupCapacity ?? 0:N0} lugares",
            "/datacapture/class-groups", "/datacapture/class-groups/consult"),

        new("Infraestructura", "Recursos Materiales y Servicios Generales", Icons.Material.Filled.Domain,
            _facilities, "espacios registrados",
            "Los mismos espacios en los que se programan los grupos de clase.",
            "/datacapture/infrastructure", "/datacapture/infrastructure/consult"),

        new("Becas", "Servicios Estudiantiles", Icons.Material.Filled.Savings,
            _scholarships, "becas asignadas",
            _scholarships switch
            {
                null when !_readsScholarships => NotYourArea,
                null => "No se pudo leer el padrón de becas.",
                0 => "Sin becas capturadas todavía.",
                _ => "Alimentan la gráfica por fuente y el capítulo de becas del informe.",
            },
            "/datacapture/scholarships", "/datacapture/scholarships/consult"),

        new("Titulación", "Control Escolar", Icons.Material.Filled.WorkspacePremium,
            _titulations, "procesos registrados",
            _titulations switch
            {
                null when !_readsTitulations => NotYourArea,
                null => "No se pudo leer el registro de titulación.",
                0 => "Sin titulaciones capturadas todavía.",
                _ => "Sólo de alumnos egresados: así la eficiencia de titulación es real.",
            },
            "/datacapture/titulation", "/datacapture/titulation/consult"),

        new("Extensión y vinculación", "Vinculación", Icons.Material.Filled.Diversity3,
            _outreachProjects, "proyectos registrados",
            _outreachProjects switch
            {
                null when !_readsOutreach => NotYourArea,
                null => "No se pudo leer los proyectos de vinculación.",
                0 => "Sin proyectos capturados todavía.",
                _ => $"{_outreachHours:N0} horas acreditadas en total",
            },
            "/datacapture/extension", "/datacapture/extension/consult"),

        new("Finanzas", "Administración y Finanzas", Icons.Material.Filled.Payments,
            _fiscalYears, "ejercicios capturados",
            (_fiscalYears, _lastFiscalYear) switch
            {
                (null, _) when !_readsFinance => NotYourArea,
                (null, _) => "No se pudo leer el resumen financiero.",
                (_, { } year) => $"El más reciente es el ejercicio {year}",
                _ => "Sin ejercicios capturados todavía.",
            },
            "/datacapture/finance", "/datacapture/finance/consult"),
    ];
}
