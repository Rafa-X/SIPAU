@page "/datacapture/infrastructure"
@attribute [Authorize]
@inject IDataCaptureService CaptureSvc
@inject NavigationManager Nav

<PageTitle>Captura de Infraestructura — SIPAU</PageTitle>

<PageHeader Eyebrow="Captura de datos" Title="Captura de Infraestructura" Subtitle="Espacios físicos e inventario TIC" BackHref="/datacapture" />

<MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-4">
    <b>Esta área todavía no tiene dónde guardarse.</b>
    El formulario muestra los campos acordados, pero el sistema aún no tiene tabla para ellos, así que
    el botón de guardar está deshabilitado. Mientras tanto estas cifras se reportan en
    el formato SII · Infraestructura y el Anexo de Tecnologías de la Información, y de ahí las toma el Informe de Junta.
    <MudLink Href="/reports" Typo="Typo.body2" Class="ml-1">Ir a los formatos</MudLink>
</MudAlert>

<MudPaper Elevation="1" Class="pa-6">
    <MudForm @ref="_form">
        <MudText Typo="Typo.h6" Class="mb-3">Espacio físico</MudText>
        <MudGrid>
            <MudItem md="6">
                <MudTextField @bind-Value="_model.SpaceName" Label="Nombre del espacio"
                              Required="true" RequiredError="Requerido." />
            </MudItem>
            <MudItem md="6">
                <MudSelect T="string" @bind-Value="_model.UseType" Label="Tipo de uso">
                    @foreach (var u in CaptureSvc.SpaceUseTypes) { <MudSelectItem T="string" Value="@u">@u</MudSelectItem> }
                </MudSelect>
            </MudItem>

            <MudItem md="6">
                <MudNumericField T="decimal" @bind-Value="_model.SquareMeters" Label="Metros cuadrados" Min="0" Format="0.##" />
            </MudItem>
            <MudItem md="6">
                <MudNumericField T="int" @bind-Value="_model.Capacity" Label="Capacidad (personas)" Min="0" />
            </MudItem>

            <MudItem md="6">
                <MudNumericField T="int" @bind-Value="_model.ComputersInOperation" Label="Computadoras en operación" Min="0" />
            </MudItem>

            <MudItem md="4" Class="d-flex align-center">
                <MudSwitch T="bool" @bind-Value="_model.HasInternet" Color="Color.Secondary" Label="Cuenta con internet" />
            </MudItem>
            <MudItem md="4" Class="d-flex align-center">
                <MudSwitch T="bool" @bind-Value="_model.HasComputerEquipment" Color="Color.Secondary" Label="Equipo de cómputo" />
            </MudItem>
            <MudItem md="4" Class="d-flex align-center">
                <MudSwitch T="bool" @bind-Value="_model.IsAdapted" Color="Color.Secondary" Label="Adaptado (accesibilidad)" />
            </MudItem>
        </MudGrid>

        <MudStack Row="true" Spacing="2" Class="mt-6">
            <MudTooltip Text="Disponible cuando el área tenga almacenamiento propio" Placement="Placement.Top">
                <span>
                    <MudButton Variant="Variant.Filled" Color="Color.Secondary"
                               StartIcon="@Icons.Material.Filled.Save" Disabled="true">Guardar espacio</MudButton>
                </span>
            </MudTooltip>
            <MudButton Variant="Variant.Outlined" OnClick="@(() => Nav.NavigateTo("/datacapture"))">Cancelar</MudButton>
        </MudStack>
    </MudForm>
</MudPaper>

@code {
    private MudForm _form = null!;
    private InfrastructureFormViewModel _model = new();

}
