@page "/datacapture/students/consult"
@attribute [Authorize(Policy = AppPermissions.CaptureStudents)]
@using UPZMG.Implementations.DataCapture
@using UPZMG.Shared.Enums
@inject IGeneralDataService GeneralDataSvc
@inject IStudentsService StudentsSvc
@inject ISecurityService SecuritySvc
@inject IJSRuntime JS

<PageTitle>Consultar Alumnos — SIPAU</PageTitle>

<PageHeader Title="Consultar Alumnos" Subtitle="Alumnos capturados de todos los periodos; filtra por carrera o por periodo de ingreso" BackHref="/datacapture" />

<MudPaper Elevation="1" Class="pa-2">
    <DataToolbar Search="@_name" SearchChanged="OnNameChanged"
                 Placeholder="Buscar por nombre…"
                 Count="_totalCount" Total="_totalCount" OnExport="ExportAsync">
        <Filters>
            <MudTextField T="string" Value="@_enrollmentNumber" ValueChanged="OnEnrollmentNumberChanged"
                          Placeholder="Matrícula" Immediate="true" Clearable="true"
                          Variant="Variant.Outlined" Margin="Margin.Dense" Class="sipau-toolbar-filter mt-0" />
            <MudSelect T="string" Value="@_careerId" ValueChanged="OnCareerChanged" Dense="true"
                       Variant="Variant.Outlined" Margin="Margin.Dense" Class="sipau-toolbar-filter-wide mt-0"
                       Placeholder="Carrera" Clearable="true">
                <MudSelectItem T="string" Value="@(null!)">Todas las carreras</MudSelectItem>
                @foreach (var career in _careers)
                {
                    <MudSelectItem T="string" Value="@career.Id.ToString()">@career.Value</MudSelectItem>
                }
            </MudSelect>
            <MudSelect T="string" Value="@_periodId" ValueChanged="OnPeriodChanged" Dense="true"
                       Variant="Variant.Outlined" Margin="Margin.Dense" Class="sipau-toolbar-filter-wide mt-0"
                       Placeholder="Periodo de ingreso" Clearable="true">
                <MudSelectItem T="string" Value="@(null!)">Todos los periodos</MudSelectItem>
                @foreach (var period in _periods)
                {
                    <MudSelectItem T="string" Value="@period.Id.ToString()">@period.Value</MudSelectItem>
                }
            </MudSelect>
        </Filters>
    </DataToolbar>

    <MudDataGrid T="StudentListItem" @ref="_grid" ServerData="LoadServerDataAsync"
                 Hover="true" Dense="true" Elevation="0" SortMode="SortMode.None">
        <Columns>
            <PropertyColumn Property="x => x.EnrollmentNumber" Title="Matrícula" />
            <PropertyColumn Property="x => x.Name" Title="Nombre" />
            <PropertyColumn Property="x => x.Career" Title="Carrera" />
            <PropertyColumn Property="x => x.Period" Title="Periodo de ingreso" />
            <TemplateColumn Title="Estatus" Sortable="false">
                <CellTemplate>@context.Item.Status.Label()</CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="" Sortable="false" CellClass="sipau-cell-end">
                <CellTemplate>
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Edit"
                               Href="@($"/datacapture/students/{context.Item.Id}/editar")">Corregir</MudButton>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <PagerContent>
            <MudDataGridPager T="StudentListItem" RowsPerPageString="Filas por página" InfoFormat="{first_item}-{last_item} de {all_items}" />
        </PagerContent>
        <NoRecordsContent>
            <EmptyState Icon="@Icons.Material.Filled.SearchOff"
                        Title="Sin coincidencias"
                        Description="Ningún alumno coincide con la búsqueda o los filtros aplicados." />
        </NoRecordsContent>
    </MudDataGrid>
</MudPaper>

@code {
    private IReadOnlyList<LookupOption> _careers = [];
    private IReadOnlyList<PeriodLookupOption> _periods = [];

    protected override async Task OnInitializedAsync()
    {
        _careers = await GeneralDataSvc.GetCareersSelectableAsync();
        _periods = await GeneralDataSvc.GetPeriodsAsync();
    }

    private MudDataGrid<StudentListItem>? _grid;
    private string _name = string.Empty;
    private string _enrollmentNumber = string.Empty;
    private string? _careerId;
    private string? _periodId;
    private int _totalCount;
    private int _nameSearchVersion;
    private int _enrollmentNumberSearchVersion;

    private async Task<GridData<StudentListItem>> LoadServerDataAsync(GridState<StudentListItem> state, CancellationToken cancellationToken)
    {
        var result = await StudentsSvc.GetStudentsListAsync(await RequestAsync(state.Page + 1, state.PageSize));
        if (_totalCount != result.TotalCount)
        {
            // The grid asked for the data, so only the grid re-rendered: the toolbar above it kept
            // saying "0 registros" and its export button stayed disabled.
            _totalCount = result.TotalCount;
            StateHasChanged();
        }

        return new GridData<StudentListItem> { TotalItems = result.TotalCount, Items = result.Items };
    }

    // The filters on screen, for one page of the listing.
    private async Task<StudentsListRequest> RequestAsync(int page, int pageSize) => new()
    {
        RequesterKey = await SecuritySvc.GetRequesterKeyAsync(),
        Name = _name.Trim(),
        EnrollmentNumber = _enrollmentNumber.Trim(),
        CareerId = Guid.TryParse(_careerId, out var careerId) ? careerId : null,
        PeriodId = Guid.TryParse(_periodId, out var periodId) ? periodId : null,
        Page = page,
        PageSize = pageSize,
    };

    /// <summary>
    /// Every student that matches the filters, not only the page on screen. The API hands the
    /// listing out a hundred at a time, so the export walks the pages.
    /// </summary>
    private async Task ExportAsync()
    {
        const int pageSize = 100;
        var rows = new List<StudentListItem>();

        for (var page = 1; ; page++)
        {
            var result = await StudentsSvc.GetStudentsListAsync(await RequestAsync(page, pageSize));
            rows.AddRange(result.Items);
            if (result.Items.Count < pageSize || rows.Count >= result.TotalCount) break;
        }

        var csv = CsvExport.Build(rows,
            ("Matrícula", s => s.EnrollmentNumber),
            ("Nombre", s => s.Name),
            ("Carrera", s => s.Career),
            ("Periodo de ingreso", s => s.Period),
            ("Estatus", s => s.Status.Label()));

        await JS.InvokeVoidAsync("sigieDownload", CsvExport.FileName("alumnos"), csv);
    }

    // Debounce keystrokes so we don't hit the API on every character typed.
    private async Task OnNameChanged(string value)
    {
        _name = value;
        if (!await DebounceAsync(++_nameSearchVersion, () => _nameSearchVersion)) return;
        if (_grid is not null) await _grid.ReloadServerData();
    }

    private async Task OnEnrollmentNumberChanged(string value)
    {
        _enrollmentNumber = value;
        if (!await DebounceAsync(++_enrollmentNumberSearchVersion, () => _enrollmentNumberSearchVersion)) return;
        if (_grid is not null) await _grid.ReloadServerData();
    }

    // Waits, then reports whether a newer keystroke arrived meanwhile - no cancellation exceptions involved.
    private static async Task<bool> DebounceAsync(int version, Func<int> currentVersion)
    {
        await Task.Delay(350);
        return version == currentVersion();
    }

    private async Task OnCareerChanged(string? value)
    {
        _careerId = value;
        if (_grid is not null) await _grid.ReloadServerData();
    }

    private async Task OnPeriodChanged(string? value)
    {
        _periodId = value;
        if (_grid is not null) await _grid.ReloadServerData();
    }
}
