@page "/datacapture/students"
@page "/datacapture/students/{Id:guid}/editar"
@attribute [Authorize(Policy = AppPermissions.CaptureStudents)]
@using UPZMG.Implementations.DataCapture
@using UPZMG.Shared.Enums
@using UPZMG.Web.Services
@inject IStudentsService _studentsService
@inject IGeneralDataService _generalService
@inject ISecurityService _securityService
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<PageTitle>@(IsEditing ? "Corregir alumno" : "Captura de Alumnos") — SIPAU</PageTitle>

<PageHeader
            Title="@(IsEditing ? "Corregir alumno" : "Captura de Alumnos")"
            Subtitle="@(IsEditing ? "Los cambios sustituyen lo capturado antes" : "Registro individual de alumnos del periodo activo")"
            BackHref="@(IsEditing ? "/datacapture/students/consult" : "/datacapture")" />

@if (IsEditing && _notFound)
{
    <SectionCard FullHeight="false">
        <EmptyState Icon="@Icons.Material.Filled.PersonOff"
                    Title="No se encontró al alumno"
                    Description="Puede que se haya eliminado, o que tu área no tenga permiso para consultarlo.">
            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Href="/datacapture/students/consult">
                Volver a la consulta
            </MudButton>
        </EmptyState>
    </SectionCard>
}
else
{

<MudPaper Elevation="1" Class="pa-6">
    <MudForm @ref="_form">
        <MudText Typo="Typo.h6" Class="mb-3">Datos del alumno</MudText>
        <MudGrid>
            <MudItem md="4">
                <MudTextField @bind-Value="_model.EnrollmentNumber" Label="Matrícula" MaxLength="20"
                              Required="true" RequiredError="La matrícula es obligatoria." />
            </MudItem>
            <MudItem md="4">
                <MudTextField @bind-Value="_model.Curp" Label="CURP" MaxLength="18"
                              Validation="@(new Func<string, string?>(ValidateCurp))" Immediate="true" />
            </MudItem>
        </MudGrid>

        <MudGrid>
            <MudItem md="4">
                <MudTextField @bind-Value="_model.FirstName" Label="Nombre(s)" MaxLength="100"
                              Required="true" RequiredError="El nombre es obligatorio." />
            </MudItem>
            @* The record keeps a second given name and the surnames, and every listing prints
               them in that order. Labelled "apellido paterno / materno", what was typed as the
               mother's surname came out in front of the father's. *@
            <MudItem md="4">
                <MudTextField @bind-Value="_model.MiddleName" Label="Segundo nombre" MaxLength="100" />
            </MudItem>
            <MudItem md="4">
                <MudTextField @bind-Value="_model.LastName" Label="Apellidos" MaxLength="100"
                              Required="true" RequiredError="Los apellidos son obligatorios."
                              HelperText="Paterno y materno, en ese orden." />
            </MudItem>
        </MudGrid>

        <MudGrid>
            <MudItem md="8">
                <MudTextField @bind-Value="_model.Address" Label="Domicilio" MaxLength="100"
                              Required="true" RequiredError="El domicilio es obligatorio." />
            </MudItem>
        </MudGrid>

        <MudGrid>
            <MudItem md="4">
                <MudDatePicker @bind-Date="_model.BirthDate" Label="Fecha de nacimiento"
                               MaxDate="DateTime.Today" Required="true" RequiredError="La fecha de nacimiento es obligatoria." />
            </MudItem>
            <MudItem md="4">
                <MudSelect T="Gender" @bind-Value="_model.Gender" Label="Sexo" ToStringFunc="@(g => g.Label())">
                    @foreach (var g in Enum.GetValues(typeof(Gender)).Cast<Gender>())
                    {
                        <MudSelectItem T="Gender" Value="@g">@g.Label()</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
        </MudGrid>

        <MudGrid Class="mt-2">
            <MudItem md="4">
                <MudSelect T="MaritalStatus" @bind-Value="_model.MaritalStatus" Label="Estado civil" ToStringFunc="@(m => m.Label())">
                    @foreach (var m in Enum.GetValues(typeof(MaritalStatus)).Cast<MaritalStatus>())
                    {
                        <MudSelectItem T="MaritalStatus" Value="@m">@m.Label()</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem md="4">
                <MudTextField @bind-Value="_model.NumberOfChildren" Label="Número de hijos"
                              Required="true" RequiredError="El numero es obligatorio." />
            </MudItem>
            <MudItem md="4">
                <MudSelect T="bool" @bind-Value="_model.Works" Label="Trabaja">
                    <MudSelectItem T="bool" Value="true">Sí</MudSelectItem>
                    <MudSelectItem T="bool" Value="false">No</MudSelectItem>
                </MudSelect>
            </MudItem>
        </MudGrid>

        <MudGrid Class="mt-2">
            <MudItem md="6">
                <MudSelect T="string"
                           Label="Lenguas indígenas que habla"
                           MultiSelection="true"
                           @bind-SelectedValues="_model.IndigenousLanguages"
                           Placeholder="Selecciona una o varias lenguas">
                    @* The catalogue the database matches against. The form had its own list, and
                       "Maya" or "Otomí" — not in the catalogue — were dropped on saving. *@
                    @foreach (var language in _languages)
                    {
                        <MudSelectItem T="string" Value="@language.Value">@language.Value</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
        </MudGrid>

        <MudGrid Class="mt-2">
            <MudItem md="4">
                @* Nullable on screen: a Guid has no "nothing chosen", so the empty form showed
                   00000000-0000-… as if it were a career, and "required" let it through. *@
                <MudSelect T="Guid?" Value="@Chosen(_model.CareerId)" ValueChanged="@(id => _model.CareerId = id ?? Guid.Empty)"
                           Label="Carrera" Required="true" RequiredError="Selecciona una carrera.">
                    @foreach (var c in _careers)
                    {
                        <MudSelectItem T="Guid?" Value="@c.Id">@c.Value</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem md="4">
                <MudSelect T="InscriptionType" @bind-Value="_model.InscriptionType" Label="Tipo de inscripción"
                           Required="true" RequiredError="Selecciona un tipo de inscripción.">
                    <MudSelectItem T="InscriptionType" Value="InscriptionType.NuevoIngreso">Nuevo ingreso</MudSelectItem>
                    <MudSelectItem T="InscriptionType" Value="InscriptionType.Reingreso">Reingreso</MudSelectItem>
                    <MudSelectItem T="InscriptionType" Value="InscriptionType.Reinscripcion">Reinscripción</MudSelectItem>
                    <MudSelectItem T="InscriptionType" Value="InscriptionType.Egreso">Egreso</MudSelectItem>
                    <MudSelectItem T="InscriptionType" Value="InscriptionType.Baja">Baja</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem md="4">
                <MudSelect T="StudentStatus" @bind-Value="_model.Status" Label="Estatus del alumno"
                           Required="true" RequiredError="Selecciona un estatus.">
                    <MudSelectItem T="StudentStatus" Value="StudentStatus.Activo">Activo</MudSelectItem>
                    <MudSelectItem T="StudentStatus" Value="StudentStatus.BajaTemporal">Baja temporal</MudSelectItem>
                    <MudSelectItem T="StudentStatus" Value="StudentStatus.BajaDefinitiva">Baja definitiva</MudSelectItem>
                    <MudSelectItem T="StudentStatus" Value="StudentStatus.Egresado">Egresado</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem md="4">
                <MudSelect T="Guid?" Value="@Chosen(_model.PeriodIdStart)" ValueChanged="@(id => _model.PeriodIdStart = id ?? Guid.Empty)"
                           Label="Periodo de inicio" Required="true" RequiredError="Selecciona un periodo.">
                    @foreach (var p in _periods)
                    {
                        <MudSelectItem T="Guid?" Value="@p.Id">@p.Value</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
        </MudGrid>

        <MudGrid Class="mt-2">
            <MudItem md="4">
                <MudTextField @bind-Value="_model.BirthCountry" Label="País de nacimiento"
                              Required="true" RequiredError="El país de nacimiento es obligatorio." />
            </MudItem>
            <MudItem md="4">
                <MudTextField @bind-Value="_model.BirthState" Label="Estado de nacimiento"
                              Required="true" RequiredError="El estado de nacimiento es obligatorio." />
            </MudItem>
        </MudGrid>

        <MudStack Row="true" Spacing="2" Class="mt-6">
            <MudButton Variant="Variant.Filled" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Save"
                       Disabled="_saving" OnClick="Submit">@(IsEditing ? "Guardar cambios" : "Guardar alumno")</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Default"
                       OnClick="@(() => Nav.NavigateTo(IsEditing ? "/datacapture/students/consult" : "/datacapture"))">Cancelar</MudButton>
        </MudStack>
    </MudForm>
</MudPaper>
}


@code {
    [Parameter] public Guid? Id { get; set; }

    private bool IsEditing => Id is not null;

    private MudForm _form = null!;
    private bool _notFound;
    private bool _saving;
    private StudentFormViewModel _model = new();
    private IReadOnlyList<LookupOption> _careers = [];
    private IReadOnlyList<PeriodLookupOption> _periods = [];
    private IReadOnlyList<LookupOption> _languages = [];

    protected override async Task OnInitializedAsync()
    {
        var careersTask = _generalService.GetCareersSelectableAsync();
        var periodsTask = _generalService.GetPeriodsAsync();
        var languagesTask = _generalService.GetIndigenousLanguagesAsync();
        await Task.WhenAll(careersTask, periodsTask, languagesTask);

        _careers = await careersTask;
        _periods = await periodsTask;
        _languages = await languagesTask;

        if (Id is { } id) await LoadAsync(id);
        else _model.PeriodIdStart = _periods.FirstOrDefault(p => p.IsActive)?.Id ?? Guid.Empty;
    }

    // Editing starts from what is stored, so an untouched field is saved exactly as it was.
    private async Task LoadAsync(Guid id)
    {
        var student = await _studentsService.GetStudentAsync(id);
        if (student is null)
        {
            _notFound = true;
            return;
        }

        _model = new StudentFormViewModel
        {
            EnrollmentNumber = student.EnrollmentNumber,
            Curp = student.CURP,
            FirstName = student.Name,
            MiddleName = student.MiddleName,
            LastName = student.LastName,
            BirthDate = student.BirthDate == default ? null : student.BirthDate.ToDateTime(TimeOnly.MinValue),
            Gender = student.Gender,
            CareerId = student.CareerId,
            PeriodIdStart = student.PeriodIdStart,
            InscriptionType = student.InscriptionType,
            Status = student.Status,
            IndigenousLanguages = student.IndigenousLanguages,
            EnglishLevel = student.EnglishLevel,
            MaritalStatus = student.MaritalStatus,
            NumberOfChildren = student.NumberOfChildren,
            Works = student.Works,
            BirthCountry = student.BirthCountry ?? string.Empty,
            BirthState = student.BirthState ?? string.Empty,
            Address = student.Address,
        };
    }

    private static Guid? Chosen(Guid id) => id == Guid.Empty ? null : id;

    private static string? ValidateCurp(string? curp)
    {
        if (string.IsNullOrWhiteSpace(curp)) return null; // optional
        return curp.Trim().Length == 18 ? null : "La CURP debe tener 18 caracteres.";
    }

    private async Task Submit()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid) return;

        var requesterKey = await _securityService.GetRequesterKeyAsync();
        var request = new UpdateStudent
        {
            Id = Id ?? Guid.Empty,
            RequesterKey = requesterKey,
            EnrollmentNumber = _model.EnrollmentNumber.Trim(),
            CURP = _model.Curp.Trim(),
            Name = _model.FirstName.Trim(),
            MiddleName = _model.MiddleName.Trim(),
            LastName = _model.LastName.Trim(),
            BirthDate = _model.BirthDate is { } birthDate ? DateOnly.FromDateTime(birthDate) : default,
            Gender = _model.Gender,
            IndigenousLanguages = _model.IndigenousLanguages.ToList(),
            EnglishLevel = _model.EnglishLevel,
            MaritalStatus = _model.MaritalStatus,
            NumberOfChildren = _model.NumberOfChildren,
            Works = _model.Works,
            Address = _model.Address.Trim(),
            CareerId = _model.CareerId,
            PeriodIdStart = _model.PeriodIdStart,
            InscriptionType = _model.InscriptionType,
            Status = _model.Status,
            BirthCountry = _model.BirthCountry.Trim(),
            BirthState = _model.BirthState.Trim(),
        };

        _saving = true;
        try
        {
            if (IsEditing) await _studentsService.UpdateStudent(request);
            else await _studentsService.CreateStudent(request);
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            return;
        }
        finally
        {
            _saving = false;
        }

        Snackbar.Add(IsEditing
            ? $"Cambios de {_model.FirstName} {_model.LastName} guardados correctamente."
            : $"Alumno {_model.FirstName} {_model.LastName} guardado correctamente.", Severity.Success);
        Nav.NavigateTo(IsEditing ? "/datacapture/students/consult" : "/datacapture");
    }
}
