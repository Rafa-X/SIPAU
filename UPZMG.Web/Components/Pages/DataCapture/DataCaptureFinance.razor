@page "/datacapture/finance"
@attribute [Authorize]
@inject NavigationManager Nav

<PageTitle>Captura de Finanzas — SIPAU</PageTitle>

<PageHeader Eyebrow="Captura de datos" Title="Captura de Finanzas" Subtitle="Resumen financiero anual" BackHref="/datacapture" />

<MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-4">
    <b>Esta área todavía no tiene dónde guardarse.</b>
    El formulario muestra los campos acordados, pero el sistema aún no tiene tabla para ellos, así que
    el botón de guardar está deshabilitado. Mientras tanto estas cifras se reportan en
    el formato 911.10 · Institución, apartado de finanzas, y de ahí las toma el Informe de Junta.
    <MudLink Href="/reports" Typo="Typo.body2" Class="ml-1">Ir a los formatos</MudLink>
</MudAlert>

<MudPaper Elevation="1" Class="pa-6">
    <MudForm @ref="_form">
        <MudGrid>
            <MudItem md="4">
                <MudNumericField T="int" @bind-Value="_model.FiscalYear" Label="Ejercicio fiscal" Min="2000" Max="2100" />
            </MudItem>

            <MudItem xs="12"><MudDivider Class="my-2" /><MudText Typo="Typo.subtitle1">Ingresos por fuente</MudText></MudItem>
            <MudItem xs="12" md="3"><MudNumericField T="decimal" @bind-Value="_model.FederalIncome" Label="Federal" Min="0" Format="N2" Adornment="Adornment.Start" AdornmentText="$" /></MudItem>
            <MudItem xs="12" md="3"><MudNumericField T="decimal" @bind-Value="_model.StateIncome" Label="Estatal" Min="0" Format="N2" Adornment="Adornment.Start" AdornmentText="$" /></MudItem>
            <MudItem xs="12" md="3"><MudNumericField T="decimal" @bind-Value="_model.OwnIncomeEnrollment" Label="Propios: inscripciones" Min="0" Format="N2" Adornment="Adornment.Start" AdornmentText="$" /></MudItem>
            <MudItem xs="12" md="3"><MudNumericField T="decimal" @bind-Value="_model.OwnIncomeServices" Label="Propios: servicios" Min="0" Format="N2" Adornment="Adornment.Start" AdornmentText="$" /></MudItem>

            <MudItem xs="12"><MudDivider Class="my-2" /><MudText Typo="Typo.subtitle1">Egresos por tipo</MudText></MudItem>
            <MudItem xs="12" md="3"><MudNumericField T="decimal" @bind-Value="_model.PayrollExpense" Label="Nómina" Min="0" Format="N2" Adornment="Adornment.Start" AdornmentText="$" /></MudItem>
            <MudItem xs="12" md="3"><MudNumericField T="decimal" @bind-Value="_model.MaterialsExpense" Label="Materiales" Min="0" Format="N2" Adornment="Adornment.Start" AdornmentText="$" /></MudItem>
            <MudItem xs="12" md="3"><MudNumericField T="decimal" @bind-Value="_model.ServicesExpense" Label="Servicios" Min="0" Format="N2" Adornment="Adornment.Start" AdornmentText="$" /></MudItem>
            <MudItem xs="12" md="3"><MudNumericField T="decimal" @bind-Value="_model.InvestmentExpense" Label="Inversión" Min="0" Format="N2" Adornment="Adornment.Start" AdornmentText="$" /></MudItem>

            <MudItem xs="12">
                <MudTextField @bind-Value="_model.Notes" Label="Notas" Lines="3" />
            </MudItem>
        </MudGrid>

        <MudStack Row="true" Spacing="2" Class="mt-6">
            <MudTooltip Text="Disponible cuando el área tenga almacenamiento propio" Placement="Placement.Top">
                <span>
                    <MudButton Variant="Variant.Filled" Color="Color.Secondary"
                               StartIcon="@Icons.Material.Filled.Save" Disabled="true">Guardar resumen</MudButton>
                </span>
            </MudTooltip>
            <MudButton Variant="Variant.Outlined" OnClick="@(() => Nav.NavigateTo("/datacapture"))">Cancelar</MudButton>
        </MudStack>
    </MudForm>
</MudPaper>

@code {
    private MudForm _form = null!;
    private FinanceFormViewModel _model = new() { FiscalYear = DateTime.Now.Year };

}
