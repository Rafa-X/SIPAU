@page "/datacapture/finance"
@attribute [Authorize(Policy = AppPermissions.CaptureFinance)]
@using UPZMG.Implementations.DataCapture
@inject IDataCaptureService CaptureSvc
@inject ISecurityService SecuritySvc
@inject ISnackbar Snackbar
@inject NavigationManager Nav

@*
    One summary per fiscal year: saving a year that already exists updates it instead of
    creating a second budget. Totals are computed here and recomputed on the server; the
    area never captures a total that could disagree with its own parts.
*@

<PageTitle>Captura de Finanzas — SIPAU</PageTitle>

<PageHeader Title="Captura de Finanzas"
            Subtitle="Resumen financiero anual de la institución" BackHref="/datacapture">
    <Actions>
        <MudButton Variant="Variant.Text" Color="Color.Primary" Href="/datacapture/finance/consult"
                   StartIcon="@Icons.Material.Filled.ListAlt">Consultar ejercicios</MudButton>
    </Actions>
</PageHeader>

@if (_existingUnknown)
{
    @* Saving here UPDATES the year when it already has figures, so the form cannot offer a
       save without knowing whether it would overwrite the institution's only set of them. *@
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-4">
        No pudimos leer los ejercicios ya capturados, así que no sabemos si <b>@_fiscalYear</b> ya tiene
        cifras. Guardar a ciegas podría sobrescribirlas: el guardado queda deshabilitado hasta poder consultarlas.
        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Inherit" OnClick="LoadExistingAsync">
            Reintentar
        </MudButton>
    </MudAlert>
}
else if (_existing is not null)
{
    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mb-4">
        El ejercicio <b>@_fiscalYear</b> ya tiene un resumen capturado
        (última modificación @_existing.LastModified.ToLocalTime().ToString("dd/MM/yyyy HH:mm")).
        Si guardas, se <b>actualiza</b>: la institución tiene un solo juego de cifras por año.
    </MudAlert>
}

<MudPaper Elevation="1" Class="pa-6">
    <MudForm @ref="_form">
        <MudGrid>
            <MudItem md="4">
                <MudNumericField T="int" Value="_fiscalYear" ValueChanged="OnYearChanged" Label="Ejercicio fiscal"
                                 Min="2000" Max="2100" Immediate="true" />
            </MudItem>

            <MudItem xs="12"><MudDivider Class="my-2" /><MudText Typo="Typo.subtitle1">Ingresos por fuente</MudText></MudItem>
            <MudItem xs="12" md="3"><MudNumericField T="decimal" @bind-Value="_federal" Label="Federal" Min="0" Format="N2" Adornment="Adornment.Start" AdornmentText="$" Immediate="true" /></MudItem>
            <MudItem xs="12" md="3"><MudNumericField T="decimal" @bind-Value="_state" Label="Estatal" Min="0" Format="N2" Adornment="Adornment.Start" AdornmentText="$" Immediate="true" /></MudItem>
            <MudItem xs="12" md="3"><MudNumericField T="decimal" @bind-Value="_enrollment" Label="Propios: inscripciones" Min="0" Format="N2" Adornment="Adornment.Start" AdornmentText="$" Immediate="true" /></MudItem>
            <MudItem xs="12" md="3"><MudNumericField T="decimal" @bind-Value="_services" Label="Propios: servicios" Min="0" Format="N2" Adornment="Adornment.Start" AdornmentText="$" Immediate="true" /></MudItem>

            <MudItem xs="12"><MudDivider Class="my-2" /><MudText Typo="Typo.subtitle1">Egresos por tipo</MudText></MudItem>
            <MudItem xs="12" md="3"><MudNumericField T="decimal" @bind-Value="_payroll" Label="Nómina" Min="0" Format="N2" Adornment="Adornment.Start" AdornmentText="$" Immediate="true" /></MudItem>
            <MudItem xs="12" md="3"><MudNumericField T="decimal" @bind-Value="_materials" Label="Materiales" Min="0" Format="N2" Adornment="Adornment.Start" AdornmentText="$" Immediate="true" /></MudItem>
            <MudItem xs="12" md="3"><MudNumericField T="decimal" @bind-Value="_servicesExpense" Label="Servicios" Min="0" Format="N2" Adornment="Adornment.Start" AdornmentText="$" Immediate="true" /></MudItem>
            <MudItem xs="12" md="3"><MudNumericField T="decimal" @bind-Value="_investment" Label="Inversión" Min="0" Format="N2" Adornment="Adornment.Start" AdornmentText="$" Immediate="true" /></MudItem>

            <MudItem xs="12">
                <MudTextField @bind-Value="_notes" Label="Notas" Lines="3" MaxLength="1000" />
            </MudItem>
        </MudGrid>

        <div class="sipau-finance-totals mt-4">
            <div>
                <span class="sipau-field-label">Total de ingresos</span>
                <b>@TotalIncome.ToString("C0", Mx)</b>
            </div>
            <div>
                <span class="sipau-field-label">Total de egresos</span>
                <b>@TotalExpense.ToString("C0", Mx)</b>
            </div>
            <div>
                <span class="sipau-field-label">Balance</span>
                <b class="@(Balance < 0 ? "sipau-negative" : null)">@Balance.ToString("C0", Mx)</b>
            </div>
        </div>

        @if (Balance < 0)
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mt-3">
                Los egresos superan a los ingresos en @((-Balance).ToString("C0", Mx)). Se puede guardar:
                un ejercicio deficitario es un hecho, no un error de captura, pero conviene explicarlo en las notas.
            </MudAlert>
        }

        <MudStack Row="true" Spacing="2" Class="mt-6">
            <MudButton Variant="Variant.Filled" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Save"
                       Disabled="@(_saving || _existingUnknown)" OnClick="Submit">Guardar resumen</MudButton>
            <MudButton Variant="Variant.Outlined" OnClick="@(() => Nav.NavigateTo("/datacapture"))">Cancelar</MudButton>
        </MudStack>
    </MudForm>
</MudPaper>

@code {
    private static readonly System.Globalization.CultureInfo Mx = new("es-MX");

    // The listing's "Editar" says which year it means.
    [SupplyParameterFromQuery(Name = "ejercicio")] public int? RequestedYear { get; set; }

    private MudForm _form = null!;
    private bool _saving;

    private IReadOnlyList<FinanceListItem> _summaries = [];
    private FinanceListItem? _existing;

    private int _fiscalYear = DateTime.Now.Year;
    private decimal _federal, _state, _enrollment, _services;
    private decimal _payroll, _materials, _servicesExpense, _investment;
    private string _notes = string.Empty;

    private decimal TotalIncome => _federal + _state + _enrollment + _services;
    private decimal TotalExpense => _payroll + _materials + _servicesExpense + _investment;
    private decimal Balance => TotalIncome - TotalExpense;

    // True while the captured exercises could not be read. A null listing used to be assigned
    // straight to the field, which crashed the page on its next line; treating it as an empty
    // list instead would have been worse, opening a blank form over a year that has figures.
    private bool _existingUnknown;

    protected override Task OnInitializedAsync()
    {
        if (RequestedYear is >= 2000 and <= 2100) _fiscalYear = RequestedYear.Value;
        return LoadExistingAsync();
    }

    private async Task LoadExistingAsync()
    {
        var summaries = await CaptureSvc.GetFinanceListAsync();
        _existingUnknown = summaries is null;
        _summaries = summaries ?? [];
        LoadYear(_fiscalYear);
    }

    private void OnYearChanged(int year)
    {
        _fiscalYear = year;
        LoadYear(year);
    }

    // Whether the figures on screen were read from a captured year rather than typed.
    private bool _showingCapturedYear;

    // Opening a year that was already captured shows its figures instead of an empty form.
    private void LoadYear(int year)
    {
        _existing = _summaries.FirstOrDefault(s => s.FiscalYear == year);
        if (_existing is null)
        {
            // Another year's figures are not this year's: left on screen, saving stored them under
            // both years. What somebody typed for a new year stays when they correct the year.
            if (_showingCapturedYear) ClearFigures();
            _showingCapturedYear = false;
            return;
        }

        _showingCapturedYear = true;
        _federal = _existing.FederalIncome;
        _state = _existing.StateIncome;
        _enrollment = _existing.OwnIncomeEnrollment;
        _services = _existing.OwnIncomeServices;
        _payroll = _existing.PayrollExpense;
        _materials = _existing.MaterialsExpense;
        _servicesExpense = _existing.ServicesExpense;
        _investment = _existing.InvestmentExpense;
        _notes = _existing.Notes ?? string.Empty;
    }

    private void ClearFigures()
    {
        _federal = _state = _enrollment = _services = 0;
        _payroll = _materials = _servicesExpense = _investment = 0;
        _notes = string.Empty;
    }

    private async Task Submit()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid) return;

        _saving = true;
        try
        {
            await CaptureSvc.SaveFinance(new SaveAnnualFinance
            {
                RequesterKey = await SecuritySvc.GetRequesterKeyAsync(),
                FiscalYear = _fiscalYear,
                FederalIncome = _federal,
                StateIncome = _state,
                OwnIncomeEnrollment = _enrollment,
                OwnIncomeServices = _services,
                PayrollExpense = _payroll,
                MaterialsExpense = _materials,
                ServicesExpense = _servicesExpense,
                InvestmentExpense = _investment,
                Notes = string.IsNullOrWhiteSpace(_notes) ? null : _notes.Trim(),
            });
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            return;
        }
        finally
        {
            _saving = false;
        }

        Snackbar.Add($"Resumen financiero {_fiscalYear} guardado correctamente.", Severity.Success);
        Nav.NavigateTo("/datacapture/finance/consult");
    }
}
