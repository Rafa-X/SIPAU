@page "/datacapture/teachers"
@page "/datacapture/teachers/{Id:guid}/editar"
@attribute [Authorize]
@using UPZMG.Implementations.DataCapture
@using UPZMG.Shared.Enums
@inject IDataCaptureService _captureService
@inject IGeneralDataService _generalService
@inject ISecurityService _securityService
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<PageTitle>@(IsEditing ? "Corregir docente" : "Captura de Docentes") — SIPAU</PageTitle>

<PageHeader Eyebrow="Captura de datos"
            Title="@(IsEditing ? "Corregir docente o empleado" : "Captura de Docentes / RRHH")"
            Subtitle="@(IsEditing ? "Los cambios sustituyen lo capturado antes" : "Registro de personal docente y administrativo")"
            BackHref="@(IsEditing ? "/datacapture/teachers/consult" : "/datacapture")" />

@if (IsEditing && _notFound)
{
    <SectionCard FullHeight="false">
        <EmptyState Icon="@Icons.Material.Filled.PersonOff"
                    Title="No se encontró al empleado"
                    Description="Puede que se haya eliminado, o que tu área no tenga permiso para consultarlo.">
            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Href="/datacapture/teachers/consult">
                Volver a la consulta
            </MudButton>
        </EmptyState>
    </SectionCard>
}
else
{

<MudPaper Elevation="1" Class="pa-6">
    <MudForm @ref="_form">
        <MudText Typo="Typo.h6" Class="mb-3">Datos del empleado</MudText>
        <MudGrid>
            <MudItem md="4">
                <MudNumericField T="int" @bind-Value="_model.EmployeeNumber" Label="Número de empleado"
                                 Min="1" Required="true" RequiredError="El número de empleado es obligatorio." />
            </MudItem>
        </MudGrid>

        <MudGrid>
            <MudItem md="4">
                <MudTextField @bind-Value="_model.Email" Label="Correo electrónico" InputType="InputType.Email"
                              Required="true" RequiredError="El correo electrónico es obligatorio." />
            </MudItem>
            <MudItem md="4">
                <MudTextField @bind-Value="_model.Rfc" Label="RFC" />
            </MudItem>
            <MudItem md="4">
                <MudTextField @bind-Value="_model.Curp" Label="CURP" />
            </MudItem>
        </MudGrid>

        <MudGrid Class="mt-1">
            <MudItem md="4">
                <MudTextField @bind-Value="_model.FirstName" Label="Nombre(s)" Required="true" RequiredError="Requerido." />
            </MudItem>
            <MudItem md="4">
                <MudTextField @bind-Value="_model.LastName" Label="Apellido paterno" Required="true" RequiredError="Requerido." />
            </MudItem>
            <MudItem md="4">
                <MudTextField @bind-Value="_model.MiddleName" Label="Apellido materno" />
            </MudItem>
        </MudGrid>
        <MudGrid>
            <MudItem md="4">
                <MudSelect T="Gender" @bind-Value="_model.Gender" Label="Sexo">
                    @foreach (var g in Enum.GetValues(typeof(Gender)).Cast<Gender>()) { <MudSelectItem T="Gender" Value="@g">@g</MudSelectItem> }
                </MudSelect>
            </MudItem>
            <MudItem md="4">
                <MudDatePicker @bind-Date="_model.BirthDate" Label="Fecha de nacimiento" MaxDate="DateTime.Today" />
            </MudItem>
            <MudItem md="4">
                <MudSelect T="string" @bind-Value="_model.MaxDegree" Label="Grado máximo de estudios">
                    @foreach (var degree in _maxDegrees)
                    {
                        <MudSelectItem T="string" Value="@degree.Value">@degree.Value</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
        </MudGrid>

        <MudGrid Class="mt-2">
            <MudItem md="4">
                <MudSelect T="string" @bind-Value="_model.ContractType" Label="Tipo de contrato">
                    @foreach (var contractType in _contractTypes)
                    {
                        <MudSelectItem T="string" Value="@contractType.Value">@contractType.Value</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem md="4">
                <MudNumericField T="int" @bind-Value="_model.WeeklyHours" Label="Horas semanales" Min="0" Max="48" />
            </MudItem>
            <MudItem md="4">
                <MudSelect T="Guid?" @bind-Value="_model.AreaId" Label="Área de adscripción">
                    @foreach (var area in _internalAreas)
                    {
                        <MudSelectItem T="Guid?" Value="@area.Id">@area.Value</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
        </MudGrid>

        <MudGrid Class="mt-2">
            <MudItem md="4">
                <MudSelect T="EducationLevel" @bind-Value="_model.HighestEducationLevel" Label="Nivel máximo de estudios">
                    @foreach (var educationLevel in Enum.GetValues(typeof(EducationLevel)).Cast<EducationLevel>())
                    {
                        <MudSelectItem T="EducationLevel" Value="@educationLevel">@educationLevel</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem md="4">
                <MudSelect T="TitleStatus" @bind-Value="_model.TitleStatus" Label="Estatus de titulación">
                    @foreach (var titleStatus in Enum.GetValues(typeof(TitleStatus)).Cast<TitleStatus>())
                    {
                        <MudSelectItem T="TitleStatus" Value="@titleStatus">@titleStatus</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem md="4">
                <MudDatePicker @bind-Date="_model.FirstHiredDate" Label="Fecha de primera contratación" MaxDate="DateTime.Today" />
            </MudItem>
        </MudGrid>

        <MudGrid Class="mt-2">
            <MudItem md="6">
                <MudSelect T="string"
                           Label="Lenguas indígenas que habla"
                           MultiSelection="true"
                           @bind-SelectedValues="_model.IndigenousLanguages"
                           Placeholder="Selecciona una o varias lenguas">
                    @foreach (var language in Enum.GetValues(typeof(IndigenousLanguage)).Cast<IndigenousLanguage>())
                    {
                        <MudSelectItem T="string" Value="@language.ToString()">@language</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem md="6" Class="d-flex align-center">
                <MudSwitch T="bool" @bind-Value="_model.HasPostgraduate" Color="Color.Secondary" Label="Cuenta con posgrado" />
            </MudItem>
        </MudGrid>

        <MudGrid Class="mt-2">
            <MudItem md="4">
                <MudSwitch T="bool" @bind-Value="_model.IsTeacher" Color="Color.Secondary" Label="Es personal docente" />
            </MudItem>
            <MudItem md="4">
                <MudSwitch T="bool" @bind-Value="_model.HasDisability" Color="Color.Secondary" Label="Tiene alguna discapacidad" />
            </MudItem>
            <MudItem md="4">
                <MudNumericField T="int" @bind-Value="_model.ExternalXPYears" Label="Años de experiencia externa" Min="0" />
            </MudItem>
        </MudGrid>

        <MudStack Row="true" Spacing="2" Class="mt-6">
            <MudButton Variant="Variant.Filled" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Save"
                       Disabled="_saving" OnClick="Submit">@(IsEditing ? "Guardar cambios" : "Guardar Empleado")</MudButton>
            <MudButton Variant="Variant.Outlined" OnClick="@(() => Nav.NavigateTo("/datacapture"))">Cancelar</MudButton>
        </MudStack>
    </MudForm>
</MudPaper>

}

@code {
    [Parameter] public Guid? Id { get; set; }

    private bool IsEditing => Id is not null;

    private MudForm _form = null!;
    private bool _notFound;
    private bool _saving;
    private EmployeeFormViewModel _model = new();
    private IReadOnlyList<LookupOption> _maxDegrees = [];
    private IReadOnlyList<LookupOption> _contractTypes = [];
    private IReadOnlyList<LookupOption> _internalAreas = [];
        
    protected override async Task OnInitializedAsync()
    {
        var maxDegreesTask = _generalService.GetMaxDegreesAsync();
        var contractTypesTask = _generalService.GetContractTypesAsync();
        var internalAreasTask = _generalService.GetInternalAreasAsync();
        await Task.WhenAll(maxDegreesTask, contractTypesTask, internalAreasTask);

        _maxDegrees = await maxDegreesTask;
        _contractTypes = await contractTypesTask;
        _internalAreas = await internalAreasTask;

        if (Id is { } id) await LoadAsync(id);
    }

    // Editing starts from what is stored, so an untouched field is saved exactly as it was.
    private async Task LoadAsync(Guid id)
    {
        var employee = await _captureService.GetTeacherAsync(id);
        if (employee is null)
        {
            _notFound = true;
            return;
        }

        // The full name is stored as one field; split it back for the three inputs.
        var parts = employee.FullName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        _model = new EmployeeFormViewModel
        {
            EmployeeNumber = employee.EmployeeNumber,
            FirstName = parts.Length > 0 ? parts[0] : string.Empty,
            MiddleName = parts.Length > 2 ? string.Join(' ', parts[1..^1]) : string.Empty,
            LastName = parts.Length > 1 ? parts[^1] : string.Empty,
            Email = employee.Email,
            Rfc = employee.Rfc,
            Curp = employee.Curp,
            Gender = employee.Gender,
            BirthDate = employee.BirthDate == default ? null : employee.BirthDate.ToDateTime(TimeOnly.MinValue),
            HighestEducationLevel = employee.HighestEducationLevel,
            TitleStatus = employee.TitleStatus,
            IndigenousLanguages = employee.IndigenousLanguages,
            HasDisability = employee.HasDisability,
            ExternalXPYears = employee.ExternalXPYears,
            FirstHiredDate = employee.FirstHiredDate == default ? null : employee.FirstHiredDate.ToDateTime(TimeOnly.MinValue),
            IsTeacher = employee.IsTeacher,
        };
    }

    private async Task Submit()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid) return;

        var request = new UpdateEmployee
        {
            Id = Id ?? Guid.Empty,
            RequesterKey = await _securityService.GetRequesterKeyAsync(),
            EmployeeNumber = _model.EmployeeNumber,
            FullName = string.Join(' ', new[] { _model.FirstName, _model.MiddleName, _model.LastName }).Trim(),
            Email = _model.Email.Trim(),
            Rfc = _model.Rfc.Trim(),
            Curp = _model.Curp.Trim(),
            Gender = _model.Gender,
            BirthDate = _model.BirthDate is { } birthDate ? DateOnly.FromDateTime(birthDate) : default,
            HighestEducationLevel = _model.HighestEducationLevel,
            TitleStatus = _model.TitleStatus,
            IndigenousLanguages = _model.IndigenousLanguages.ToList(),
            HasDisability = _model.HasDisability,
            ExternalXPYears = _model.ExternalXPYears,
            FirstHiredDate = _model.FirstHiredDate is { } firstHiredDate ? DateOnly.FromDateTime(firstHiredDate) : default,
            IsTeacher = _model.IsTeacher,
        };

        _saving = true;
        try
        {
            if (IsEditing) await _captureService.UpdateTeacher(request);
            else await _captureService.CreateTeacher(request);
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            return;
        }
        finally
        {
            _saving = false;
        }

        Snackbar.Add(IsEditing
            ? $"Cambios de {_model.FirstName} {_model.LastName} guardados correctamente."
            : $"Docente {_model.FirstName} {_model.LastName} guardado correctamente.", Severity.Success);
        Nav.NavigateTo(IsEditing ? "/datacapture/teachers/consult" : "/datacapture");
    }
}
