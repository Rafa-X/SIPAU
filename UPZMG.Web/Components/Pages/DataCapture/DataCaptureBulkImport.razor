@page "/datacapture/bulk"
@attribute [Authorize(Policy = AppPermissions.CaptureStudentsOrStaff)]
@using System.Globalization
@using System.Reflection
@using System.Text
@using System.Text.Json
@using CsvHelper
@using CsvHelper.Configuration
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.Components.Forms
@using MudBlazor
@using UPZMG.Implementations.DataCapture
@using UPZMG.Shared.Enums
@using UPZMG.Web.Components.Shared
@inject IDataCaptureService CaptureSvc
@inject IGeneralDataService GeneralDataSvc
@inject ISecurityService SecuritySvc
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@inject ILogger<DataCaptureBulkImport> Logger

<PageTitle>Importación masiva — SIPAU</PageTitle>

<PageHeader Title="Importación masiva" BackHref="/datacapture"
            Subtitle="Carga un CSV con una fila por registro, revisa qué filas se aceptan y confirma la importación" />

<MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-4">
    En <b>Carrera</b> escribe la clave de la carrera, por ejemplo <b>INCO</b>, y en <b>Periodo de inicio</b> la del periodo, por ejemplo <b>2026-EA</b>.
    La columna de lenguas indígenas puede quedar vacía; para varias lenguas usa una celda entre comillas, por ejemplo <b>"Nahuatl,Maya Yucateco"</b>. Las lenguas válidas son las del catálogo.
    Las fechas van como <b>AAAA-MM-DD</b> o <b>DD/MM/AAAA</b>, con el día primero.
</MudAlert>

<MudPaper Elevation="1" Class="bulk-import-container pa-6">
    <MudForm @ref="_form">
        <MudGrid Class="bulk-import-grid" Spacing="3">
            <MudItem xs="12" md="6" Class="d-flex justify-center">
                @* Not while a review is in flight: its answer would land on another area's table, and
                   confirming it then sent one area's rows as the other's. *@
                <MudSelect T="string" @bind-Value="_areaKey" @bind-Value:after="Reset" Label="Área destino"
                           Disabled="_busy" Required="true" RequiredError="Selecciona un área.">
                    @foreach (var area in CaptureSvc.BulkAreas)
                    {
                        <MudSelectItem T="string" Value="@area.Value">@area.Text</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="6" Class="d-flex justify-center">
                <MudButton Variant="Variant.Outlined" Color="Color.Secondary"
                           StartIcon="@Icons.Material.Filled.Download"
                           Disabled="@string.IsNullOrWhiteSpace(_areaKey)"
                           Href="@TemplateUrl" download="@TemplateFileName">
                    Descargar plantilla CSV
                </MudButton>
            </MudItem>
            <MudItem xs="12" Class="d-flex justify-center mt-2">
                <MudFileUpload T="IBrowserFile" @bind-Files="_file" @bind-Files:after="Reset" Accept=".csv,text/csv" Hidden="true">
                    <CustomContent Context="upload">
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AttachFile"
                                   Disabled="_busy" OnClick="@(() => upload.OpenFilePickerAsync())">
                            Seleccionar archivo (.csv)
                        </MudButton>
                    </CustomContent>
                </MudFileUpload>
            </MudItem>
        </MudGrid>

        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="mt-4">
            Primero se revisa el archivo completo y no se guarda nada. Después confirmas: las filas aceptadas se
            guardan juntas, en una sola operación, y si alguna falla al guardarse no se guarda ninguna.
        </MudAlert>

        @if (_message is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mt-4">@_message</MudAlert>
        }

        <MudStack Row="true" Justify="Justify.Center" Spacing="2" Class="mt-6">
            <MudButton Variant="Variant.Filled" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.FactCheck"
                       Disabled="@(_busy || _file is null || string.IsNullOrWhiteSpace(_areaKey))" OnClick="ReviewAsync">
                @(_busy && _review.Count == 0 ? "Revisando…" : "Revisar archivo")
            </MudButton>
            <MudButton Variant="Variant.Outlined" Disabled="_busy"
                       OnClick="@(() => Nav.NavigateTo("/datacapture"))">
                Volver a Captura
            </MudButton>
        </MudStack>
    </MudForm>
</MudPaper>

@if (_review.Count > 0)
{
    <SectionCard Title="Revisión del archivo" Flush="true" FullHeight="false" Class="mt-4"
                 Subtitle="@($"{ReportUi.Plural(Accepted, "fila aceptada", "filas aceptadas")} y {ReportUi.Plural(Refused, "rechazada", "rechazadas")}. Todavía no se ha guardado nada.")"
                 Icon="@Icons.Material.Filled.FactCheck">
        <Actions>
            <MudButton Variant="Variant.Filled" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.CloudUpload"
                       Disabled="@(_busy || Accepted == 0)" OnClick="ImportAsync">
                @(_busy ? "Importando…" : $"Importar {ReportUi.Plural(Accepted, "fila aceptada", "filas aceptadas")}")
            </MudButton>
        </Actions>
        <ChildContent>
            <MudDataGrid T="ImportRowResult" Items="_review" Dense="true" Hover="true" Elevation="0"
                         RowsPerPage="15" SortMode="SortMode.None">
                <Columns>
                    <PropertyColumn Property="x => x.Line" Title="Fila" HeaderClass="sipau-cell-end" CellClass="sipau-cell-end" />
                    <PropertyColumn Property="x => x.Key" Title="@KeyTitle" />
                    <PropertyColumn Property="x => x.Name" Title="Nombre" />
                    <TemplateColumn Title="Resultado">
                        <CellTemplate>
                            @if (context.Item.Accepted)
                            {
                                <span class="sipau-report-status is-compact is-sent">Aceptada</span>
                            }
                            else
                            {
                                <span class="sipau-report-status is-compact is-rejected">Rechazada</span>
                                <ul class="sipau-import-problems">
                                    @foreach (var problem in context.Item.Problems)
                                    {
                                        <li>@problem</li>
                                    }
                                </ul>
                            }
                        </CellTemplate>
                    </TemplateColumn>
                </Columns>
                <PagerContent>
                    <MudDataGridPager T="ImportRowResult" PageSizeOptions="@(new[] { 15, 50, 200 })"
                                      RowsPerPageString="Filas por página"
                                      InfoFormat="{first_item}–{last_item} de {all_items}" />
                </PagerContent>
            </MudDataGrid>
        </ChildContent>
        <Footer>
            @if (Refused > 0)
            {
                <span>
                    Las filas rechazadas no se importan. Corrígelas en el archivo y vuelve a subir sólo esas: las aceptadas
                    ya estarán guardadas y se rechazarían como repetidas.
                </span>
            }
            else
            {
                <span>Todas las filas pasaron la revisión.</span>
            }
        </Footer>
    </SectionCard>
}

@if (_imported is { Committed: true } imported)
{
    <SectionCard Title="Importación confirmada" Flush="true" FullHeight="false" Class="mt-4"
                 Subtitle="@(imported.Accepted == 1 ? "Se guardó 1 registro." : $"Se guardaron {imported.Accepted} registros en una sola operación.")"
                 Icon="@Icons.Material.Filled.TaskAlt">
        <Actions>
            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Href="@ConsultUrl"
                       StartIcon="@Icons.Material.Filled.ManageSearch">
                Ver en la consulta
            </MudButton>
        </Actions>
        <ChildContent>
            <MudDataGrid T="ImportRowResult" Items="imported.Rows" Dense="true" Elevation="0" RowsPerPage="15"
                         SortMode="SortMode.None">
                <Columns>
                    <PropertyColumn Property="x => x.Line" Title="Fila" HeaderClass="sipau-cell-end" CellClass="sipau-cell-end" />
                    <PropertyColumn Property="x => x.Key" Title="@KeyTitle" />
                    <PropertyColumn Property="x => x.Name" Title="Nombre" />
                </Columns>
                <PagerContent>
                    <MudDataGridPager T="ImportRowResult" PageSizeOptions="@(new[] { 15, 50, 200 })"
                                      RowsPerPageString="Filas por página"
                                      InfoFormat="{first_item}–{last_item} de {all_items}" />
                </PagerContent>
            </MudDataGrid>
        </ChildContent>
    </SectionCard>
}

@code {
    private const long MaxFileSize = 10 * 1024 * 1024;
    private const string NotACsv = "No reconocemos este archivo como un CSV de la plantilla. Descarga la plantilla, copia tus datos en ella y en Excel usa Guardar como › CSV UTF-8.";
    private static readonly JsonSerializerOptions JsonOptions = new(JsonSerializerDefaults.Web);
    private MudForm _form = null!;
    private IBrowserFile? _file;
    private string _areaKey = string.Empty;
    private bool _busy;
    private string? _message;

    // What the last review found, and the converted requests of the rows it could read.
    private List<ImportRowResult> _review = [];
    private List<(int Line, object Request)> _pending = [];
    private ImportResult? _imported;

    // Catalogues read once per review instead of once per row.
    private List<LookupOption>? _careers;
    private List<PeriodLookupOption>? _periods;

    private int Accepted => _review.Count(r => r.Accepted);
    private int Refused => _review.Count - Accepted;

    private static readonly IReadOnlyDictionary<string, string> StudentHeaders = new Dictionary<string, string>(StringComparer.Ordinal)
    {
        [nameof(CreateStudent.EnrollmentNumber)] = "Matrícula",
        [nameof(CreateStudent.CURP)] = "CURP",
        [nameof(CreateStudent.Name)] = "Nombre",
        [nameof(CreateStudent.MiddleName)] = "Segundo nombre",
        [nameof(CreateStudent.LastName)] = "Apellidos",
        [nameof(CreateStudent.BirthDate)] = "Fecha de nacimiento",
        [nameof(CreateStudent.Gender)] = "Sexo",
        [nameof(CreateStudent.IndigenousLanguages)] = "Lenguas indígenas",
        [nameof(CreateStudent.PostalCode)] = "Código postal",
        [nameof(CreateStudent.EnglishLevel)] = "Nivel de inglés",
        [nameof(CreateStudent.MaritalStatus)] = "Estado civil",
        [nameof(CreateStudent.NumberOfChildren)] = "Número de hijos",
        [nameof(CreateStudent.Works)] = "Trabaja",
        [nameof(CreateStudent.Address)] = "Domicilio",
        [nameof(CreateStudent.CareerId)] = "Carrera",
        [nameof(CreateStudent.PeriodIdStart)] = "Periodo de inicio",
        [nameof(CreateStudent.InscriptionType)] = "Tipo de inscripción",
        [nameof(CreateStudent.Status)] = "Estatus",
        [nameof(CreateStudent.BirthCountry)] = "País de nacimiento",
        [nameof(CreateStudent.BirthState)] = "Estado de nacimiento",
    };

    private static readonly IReadOnlyDictionary<string, string> EmployeeHeaders = new Dictionary<string, string>(StringComparer.Ordinal)
    {
        [nameof(CreateEmployee.EmployeeNumber)] = "Número de empleado",
        [nameof(CreateEmployee.FullName)] = "Nombre completo",
        [nameof(CreateEmployee.Email)] = "Correo electrónico",
        [nameof(CreateEmployee.Rfc)] = "RFC",
        [nameof(CreateEmployee.Curp)] = "CURP",
        [nameof(CreateEmployee.Gender)] = "Sexo",
        [nameof(CreateEmployee.BirthDate)] = "Fecha de nacimiento",
        [nameof(CreateEmployee.HighestEducationLevel)] = "Nivel máximo de estudios",
        [nameof(CreateEmployee.TitleStatus)] = "Estatus de titulación",
        [nameof(CreateEmployee.IndigenousLanguages)] = "Lenguas indígenas",
        [nameof(CreateEmployee.HasDisability)] = "Tiene discapacidad",
        [nameof(CreateEmployee.ExternalXPYears)] = "Años de experiencia externa",
        [nameof(CreateEmployee.FirstHiredDate)] = "Fecha de primera contratación",
        [nameof(CreateEmployee.IsTeacher)] = "Es docente",
    };

    private static readonly IReadOnlyDictionary<string, string> ClassGroupHeaders = new Dictionary<string, string>(StringComparer.Ordinal)
    {
        [nameof(CreateClassGroup.Schedule)] = "Horario",
        [nameof(CreateClassGroup.CourseId)] = "Asignatura",
        [nameof(CreateClassGroup.PeriodId)] = "Periodo",
        [nameof(CreateClassGroup.CareerId)] = "Carrera",
        [nameof(CreateClassGroup.TeacherId)] = "Docente",
        [nameof(CreateClassGroup.FacilityId)] = "Instalación",
        [nameof(CreateClassGroup.IsTheory)] = "Es teórico",
        [nameof(CreateClassGroup.Capacity)] = "Capacidad",
        [nameof(CreateClassGroup.Weekhours)] = "Horas semanales",
    };

    private string TemplateFileName => _areaKey switch
    {
        "students" => "Estudiantes.csv",
        "teachers" => "Empleados.csv",
        //"classgroups" => "GruposClase.csv",
        _ => string.Empty
    };

    private string TemplateUrl => $"/BulkImportTemplates/{TemplateFileName}";

    private string KeyTitle => _areaKey == "teachers" ? "Número de empleado" : "Matrícula";

    private string ConsultUrl => _areaKey == "teachers" ? "/datacapture/teachers/consult" : "/datacapture/students/consult";

    // Another area or another file makes the last review meaningless.
    private void Reset()
    {
        _review = [];
        _pending = [];
        _imported = null;
        _message = null;
    }

    /// <summary>
    /// Reads the whole file and asks the API to check it. Nothing is written: rows the screen
    /// cannot read are refused here, the rest are checked by the API against its rules and what
    /// is already stored.
    /// </summary>
    private async Task ReviewAsync()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid || _file is null || string.IsNullOrWhiteSpace(_areaKey)) return;
        if (!string.Equals(Path.GetExtension(_file.Name), ".csv", StringComparison.OrdinalIgnoreCase))
        {
            Snackbar.Add("Sólo se aceptan archivos .csv. En Excel usa Guardar como › CSV UTF-8.", Severity.Error);
            return;
        }

        Reset();
        if (_file.Size > MaxFileSize)
        {
            _message = $"El archivo pesa {_file.Size / 1024.0 / 1024.0:0.0} MB y el máximo es {MaxFileSize / 1024 / 1024} MB. Divídelo en varios archivos.";
            return;
        }

        _busy = true;
        _careers = null;
        _periods = null;
        try
        {
            var requesterKey = await SecuritySvc.GetRequesterKeyAsync();
            if (requesterKey == Guid.Empty)
            {
                _message = "No se pudo identificar al usuario actual.";
                return;
            }

            var (readable, unreadable) = await ReadFileAsync(requesterKey);
            if (readable.Count + unreadable.Count == 0)
            {
                _message = "El archivo no tiene filas debajo de los encabezados.";
                return;
            }

            var checkedRows = readable.Count == 0 ? new ImportResult(false, []) : await SendAsync(requesterKey, readable, commit: false);
            if (readable.Count > 0 && checkedRows.Rows.Count == 0)
            {
                _message = checkedRows.Message ?? "No se pudo revisar el archivo.";
                return;
            }

            _pending = readable;
            _review = [.. checkedRows.Rows.Concat(unreadable).OrderBy(r => r.Line)];
        }
        catch (InvalidOperationException ex)
        {
            _message = ex.Message;
        }
        catch (Exception ex) when (ex is IOException or CsvHelperException)
        {
            Logger.LogWarning(ex, "A bulk import file could not be read.");
            _message = "No se pudo leer el archivo. Vuelve a seleccionarlo; si sigue igual, copia tus datos en la plantilla.";
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>Stores the accepted rows, all of them or none, after the person confirms.</summary>
    private async Task ImportAsync()
    {
        var accepted = _review.Where(r => r.Accepted).Select(r => r.Line).ToHashSet();
        var rows = _pending.Where(p => accepted.Contains(p.Line)).ToList();
        if (rows.Count == 0) return;

        var left = _review.Count - rows.Count;
        var confirmed = await DialogService.ShowMessageBoxAsync(
            rows.Count == 1 ? "Importar 1 registro" : $"Importar {rows.Count} registros",
            (rows.Count == 1
                ? "Se guardará la fila aceptada."
                : $"Se guardarán las {rows.Count} filas aceptadas en una sola operación; si alguna falla al guardarse, no se guarda ninguna.")
            + (left switch { 0 => string.Empty, 1 => " La fila rechazada no se importa.", _ => $" Las {left} filas rechazadas no se importan." }),
            yesText: "Importar", cancelText: "Cancelar");
        if (confirmed != true) return;

        _busy = true;
        _message = null;
        try
        {
            var requesterKey = await SecuritySvc.GetRequesterKeyAsync();
            var result = await SendAsync(requesterKey, rows, commit: true);

            if (result.Committed)
            {
                _imported = result;
                _review = [];
                _pending = [];
                Snackbar.Add(result.Accepted == 1 ? "Se importó 1 registro." : $"Se importaron {result.Accepted} registros.", Severity.Success);
                return;
            }

            // Nothing was stored. The rows the API refused at this point carry its reason, and
            // the rest stay accepted for another attempt.
            _message = result.Message ?? "No se guardó ninguna fila. Revisa los motivos y vuelve a intentarlo.";
            var byLine = result.Rows.ToDictionary(r => r.Line);
            _review = [.. _review.Select(r => byLine.TryGetValue(r.Line, out var updated) ? updated : r)];
        }
        finally
        {
            _busy = false;
        }
    }

    private Task<ImportResult> SendAsync(Guid requesterKey, IEnumerable<(int Line, object Request)> rows, bool commit) => _areaKey switch
    {
        "students" => CaptureSvc.ImportStudentsAsync(new ImportStudents
        {
            RequesterKey = requesterKey,
            Commit = commit,
            Rows = [.. rows.Select(r => new ImportRow<CreateStudent> { Line = r.Line, Request = (CreateStudent)r.Request })],
        }),
        "teachers" => CaptureSvc.ImportEmployeesAsync(new ImportEmployees
        {
            RequesterKey = requesterKey,
            Commit = commit,
            Rows = [.. rows.Select(r => new ImportRow<CreateEmployee> { Line = r.Line, Request = (CreateEmployee)r.Request })],
        }),
        _ => Task.FromResult(new ImportResult(false, [], "Esta área todavía no se importa por archivo.")),
    };

    /// <summary>Every row of the file: converted into a request, or refused with the reason it could not be read.</summary>
    private async Task<(List<(int Line, object Request)> Readable, List<ImportRowResult> Unreadable)> ReadFileAsync(Guid requesterKey)
    {
        var requestType = RequestTypeFor(_areaKey);
        var properties = requestType.GetProperties(BindingFlags.Public | BindingFlags.Instance)
            .Where(p => p.Name != nameof(CreateStudent.RequesterKey) && p.CanWrite)
            .ToArray();

        await using var stream = _file!.OpenReadStream(MaxFileSize);
        using var buffer = new MemoryStream();
        await stream.CopyToAsync(buffer);

        if (CsvText.IsBinary(buffer.GetBuffer().AsSpan(0, (int)buffer.Length)))
            throw new InvalidOperationException(NotACsv);

        using var reader = new StringReader(CsvText.Decode(buffer.ToArray()));
        using var csv = new CsvReader(reader, new CsvConfiguration(CultureInfo.InvariantCulture)
        {
            HasHeaderRecord = true,
            MissingFieldFound = null,
            BadDataFound = null,
            TrimOptions = TrimOptions.Trim,
            // Excel writes ";" when the computer's list separator is ";".
            DetectDelimiter = true,
        });

        if (!await csv.ReadAsync() || !csv.ReadHeader() || csv.HeaderRecord is null)
            throw new InvalidOperationException("El archivo está vacío: debe tener una fila de encabezados y una fila por registro.");

        var headers = csv.HeaderRecord.Select(h => h.Trim()).ToList();
        var headerMap = properties.ToDictionary(
            property => property.Name,
            property => FindHeader(requestType, property.Name, headers),
            StringComparer.OrdinalIgnoreCase);

        var missing = headerMap.Where(pair => pair.Value is null).Select(pair => CsvHeaderFor(requestType, pair.Key)).ToList();
        if (missing.Count == headerMap.Count)
            throw new InvalidOperationException(NotACsv);
        if (missing.Count > 0)
            throw new InvalidOperationException($"Faltan columnas requeridas: {string.Join(", ", missing)}.");

        var readable = new List<(int Line, object Request)>();
        var unreadable = new List<ImportRowResult>();

        while (await csv.ReadAsync())
        {
            // The row as a spreadsheet numbers it: the header is row 1.
            var line = csv.Context.Parser?.Row ?? readable.Count + unreadable.Count + 2;
            var values = properties.ToDictionary(p => p.Name, p => csv.GetField(headerMap[p.Name]!) ?? string.Empty, StringComparer.OrdinalIgnoreCase);

            var (request, problems) = await BuildRequestAsync(requestType, properties, values, requesterKey);
            if (problems.Count == 0)
                readable.Add((line, request));
            else
                unreadable.Add(new ImportRowResult(line, KeyOf(values), NameOf(values), problems));
        }

        return (readable, unreadable);
    }

    private string KeyOf(IReadOnlyDictionary<string, string> values) =>
        values.GetValueOrDefault(_areaKey == "teachers" ? nameof(CreateEmployee.EmployeeNumber) : nameof(CreateStudent.EnrollmentNumber), "").Trim();

    private string NameOf(IReadOnlyDictionary<string, string> values) => _areaKey == "teachers"
        ? values.GetValueOrDefault(nameof(CreateEmployee.FullName), "").Trim()
        : string.Join(' ', new[] { nameof(CreateStudent.Name), nameof(CreateStudent.MiddleName), nameof(CreateStudent.LastName) }
            .Select(key => values.GetValueOrDefault(key, "").Trim())
            .Where(part => part.Length > 0));

    private static string? FindHeader(Type requestType, string propertyName, IReadOnlyList<string> headers)
    {
        var spanishHeader = CsvHeaderFor(requestType, propertyName);
        return headers.FirstOrDefault(header => string.Equals(NormalizeHeader(header), NormalizeHeader(spanishHeader), StringComparison.Ordinal))
            ?? headers.FirstOrDefault(header => string.Equals(NormalizeHeader(header), NormalizeHeader(propertyName), StringComparison.Ordinal))
            // The column's name in earlier copies of the template: it always held both surnames.
            ?? (propertyName == nameof(CreateStudent.LastName)
                ? headers.FirstOrDefault(header => NormalizeHeader(header) == "apellidopaterno")
                : null);
    }

    private static string CsvHeaderFor(Type requestType, string propertyName) =>
        (requestType == typeof(CreateStudent) ? StudentHeaders :
         requestType == typeof(CreateEmployee) ? EmployeeHeaders : ClassGroupHeaders)
        .GetValueOrDefault(propertyName, propertyName);

    private static string NormalizeHeader(string value)
    {
        var decomposed = value.Normalize(NormalizationForm.FormD);
        return string.Concat(decomposed.Where(character =>
                CharUnicodeInfo.GetUnicodeCategory(character) != UnicodeCategory.NonSpacingMark && char.IsLetterOrDigit(character)))
            .ToLowerInvariant();
    }

    // Every problem of the row at once: stopping at the first one makes the person fix a file once
    // per mistake.
    private async Task<(object Request, List<string> Problems)> BuildRequestAsync(Type requestType, PropertyInfo[] properties, Dictionary<string, string> values, Guid requesterKey)
    {
        var request = Activator.CreateInstance(requestType)!;
        requestType.GetProperty(nameof(CreateStudent.RequesterKey))!.SetValue(request, requesterKey);

        var problems = new List<string>();
        foreach (var property in properties)
        {
            // A quote left open swallows the lines below it into one cell, and those rows would
            // disappear from the review without a word.
            if (values[property.Name].IndexOfAny(['\n', '\r']) >= 0)
            {
                problems.Add($"La celda «{CsvHeaderFor(requestType, property.Name)}» ocupa varias líneas: revisa que sus comillas cierren.");
                continue;
            }

            try
            {
                property.SetValue(request, await ConvertValueAsync(requestType, property.Name, property.PropertyType, values[property.Name], values));
            }
            catch (FormatException ex)
            {
                problems.Add(ex.Message);
            }
        }

        return (request, problems);
    }

    /// <summary>
    /// One cell into the type its field expects. Every failure is a <see cref="FormatException"/>
    /// in Spanish naming the column, so the review can show it next to its row.
    /// </summary>
    private async Task<object?> ConvertValueAsync(Type requestType, string propertyName, Type targetType, string rawValue, IReadOnlyDictionary<string, string> rowValues)
    {
        var value = rawValue.Trim();
        var column = CsvHeaderFor(requestType, propertyName);
        var actualType = Nullable.GetUnderlyingType(targetType) ?? targetType;

        if (actualType == typeof(string)) return value;
        if (actualType == typeof(Guid)) return await ResolveGuidAsync(propertyName, value, rowValues);
        if (actualType == typeof(DateOnly))
        {
            if (value.Length == 0) return default(DateOnly);
            return CsvText.TryParseDate(value, out var date)
                ? date
                : throw new FormatException($"La fecha '{value}' de la columna «{column}» no es válida; usa AAAA-MM-DD o DD/MM/AAAA.");
        }
        if (actualType == typeof(bool))
        {
            return Plain(value) switch
            {
                "true" or "si" or "1" => true,
                "false" or "no" or "0" or "" => false,
                _ => throw new FormatException($"La columna «{column}» debe decir Sí o No; dice '{value}'."),
            };
        }
        if (actualType == typeof(int))
        {
            if (value.Length == 0) return 0;
            return int.TryParse(value, NumberStyles.Integer, CultureInfo.InvariantCulture, out var number)
                ? number
                : throw new FormatException($"La columna «{column}» debe ser un número entero; dice '{value}'.");
        }
        if (actualType == typeof(double))
        {
            return double.TryParse(value, NumberStyles.Float, CultureInfo.InvariantCulture, out var number)
                ? number
                : throw new FormatException($"La columna «{column}» debe ser un número; dice '{value}'.");
        }
        if (actualType == typeof(Gender)) return ParseGender(value);
        if (actualType.IsEnum) return ParseEnum(actualType, column, value);
        if (actualType == typeof(List<string>))
            return string.IsNullOrWhiteSpace(value)
                ? []
                : value.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries).ToList();
        if (actualType == typeof(List<Schedule>))
        {
            try
            {
                return JsonSerializer.Deserialize<List<Schedule>>(value, JsonOptions)
                    ?? throw new FormatException($"La columna «{column}» debe ser un JSON de horarios.");
            }
            catch (JsonException)
            {
                throw new FormatException($"La columna «{column}» debe ser un JSON de horarios.");
            }
        }
        throw new FormatException($"La columna «{column}» no se puede importar.");
    }

    // The enum's own name ("UnionLibre") or the label the screens show ("Unión libre").
    private static object ParseEnum(Type enumType, string column, string value)
    {
        var options = string.Join(", ", Enum.GetValues(enumType).Cast<Enum>().Select(option => option.Label()));
        if (value.Length == 0) throw new FormatException($"Falta «{column}». Los valores válidos son: {options}.");

        var wanted = Plain(value).Replace(" ", "");
        foreach (Enum option in Enum.GetValues(enumType))
        {
            if (Plain(option.ToString()) == wanted || Plain(option.Label()).Replace(" ", "") == wanted) return option;
        }

        throw new FormatException($"'{value}' no es un valor de «{column}». Los válidos son: {options}.");
    }

    private static string Plain(string value)
    {
        var decomposed = value.Trim().Normalize(NormalizationForm.FormD);
        return new string([.. decomposed.Where(c => CharUnicodeInfo.GetUnicodeCategory(c) != UnicodeCategory.NonSpacingMark)])
            .ToLowerInvariant();
    }

    private static Gender ParseGender(string value) => value.Trim().ToLowerInvariant() switch
    {
        "hombre" or "h" => Gender.H,
        "mujer" or "m" => Gender.M,
        "" => throw new FormatException("Falta el sexo: usa Hombre o Mujer."),
        _ => throw new FormatException($"El sexo '{value}' no es válido: usa Hombre o Mujer.")
    };

    private async Task<Guid> ResolveGuidAsync(string propertyName, string value, IReadOnlyDictionary<string, string> rowValues)
    {
        if (Guid.TryParse(value, out var id)) return id;

        // Left empty on purpose: the API's review says "falta" for each one, with the row's other reasons.
        if (value.Length == 0 && propertyName is nameof(CreateStudent.CareerId) or nameof(CreateStudent.PeriodIdStart)) return Guid.Empty;

        if (propertyName == nameof(CreateStudent.CareerId))
        {
            var career = (await CareersAsync()).FirstOrDefault(x =>
                string.Equals(x.Value, value, StringComparison.OrdinalIgnoreCase) || string.Equals(x.Alias, value, StringComparison.OrdinalIgnoreCase));
            return career?.Id ?? throw new FormatException($"No se encontró la carrera '{value}'.");
        }
        if (propertyName is nameof(CreateStudent.PeriodIdStart) or nameof(CreateClassGroup.PeriodId))
        {
            var period = (await PeriodsAsync()).FirstOrDefault(x =>
                string.Equals(x.IdCode, value, StringComparison.OrdinalIgnoreCase) || string.Equals(x.Value, value, StringComparison.OrdinalIgnoreCase));
            return period?.Id ?? throw new FormatException($"No se encontró el periodo '{value}'.");
        }
        if (propertyName == nameof(CreateClassGroup.CourseId))
        {
            if (!rowValues.TryGetValue(nameof(CreateClassGroup.CareerId), out var careerValue))
                throw new FormatException("La columna Carrera es necesaria para resolver la asignatura.");

            var career = (await CareersAsync()).FirstOrDefault(x =>
                string.Equals(x.Value, careerValue.Trim(), StringComparison.OrdinalIgnoreCase) ||
                string.Equals(x.Alias, careerValue.Trim(), StringComparison.OrdinalIgnoreCase));
            if (career is null)
                throw new FormatException($"No se encontró la carrera '{careerValue}'.");

            var course = (await GeneralDataSvc.GetCoursesAsync(career.Id)).FirstOrDefault(x =>
                string.Equals(x.Value, value, StringComparison.OrdinalIgnoreCase));
            return course?.Id ?? throw new FormatException($"No se encontró la asignatura '{value}' para la carrera '{careerValue}'.");
        }
        var lookup = propertyName switch
        {
            nameof(CreateClassGroup.TeacherId) => await GeneralDataSvc.GetTeachersAsync(),
            nameof(CreateClassGroup.FacilityId) => await GeneralDataSvc.GetFacilitiesAsync(),
            _ => []
        };
        var option = lookup.FirstOrDefault(x => string.Equals(x.Value, value, StringComparison.OrdinalIgnoreCase));
        return option?.Id ?? throw new FormatException($"No se encontró '{value}' para {propertyName}.");
    }

    private async Task<List<LookupOption>> CareersAsync() =>
        _careers ??= [.. await GeneralDataSvc.GetCareersSelectableAsync()];

    private async Task<List<PeriodLookupOption>> PeriodsAsync() =>
        _periods ??= [.. await GeneralDataSvc.GetPeriodsAsync()];

    private static Type RequestTypeFor(string areaKey) => areaKey switch
    {
        "students" => typeof(CreateStudent),
        "teachers" => typeof(CreateEmployee),
        "classgroups" => typeof(CreateClassGroup),
        _ => throw new InvalidOperationException("El área de captura no tiene una entidad de captura funcional.")
    };
}
