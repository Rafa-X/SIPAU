@page "/datacapture/bulk"
@attribute [Authorize]
@inject IDataCaptureService CaptureSvc
@inject NavigationManager Nav

<PageTitle>Importación masiva — SIPAU</PageTitle>

<PageHeader Eyebrow="Captura de datos" Title="Importación masiva" Subtitle="Carga un archivo delimitado en lugar de capturar registro por registro" BackHref="/datacapture" />

<MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-4">
    <b>La importación masiva todavía no está conectada.</b>
    El archivo no se envía a ningún lado: falta el endpoint que lo lea y valide contra los catálogos.
    Mientras tanto, la captura registro por registro de Alumnos, Docentes y Grupos sí guarda.
    <MudLink Href="/datacapture" Typo="Typo.body2" Class="ml-1">Volver a captura</MudLink>
</MudAlert>

<MudPaper Elevation="1" Class="pa-6">
    <MudForm @ref="_form">
        <MudGrid>
            <MudItem md="6">
                <MudSelect T="string" @bind-Value="_model.AreaKey" Label="Área destino"
                           Required="true" RequiredError="Selecciona un área.">
                    @foreach (var a in CaptureSvc.BulkAreas) { <MudSelectItem T="string" Value="@a.Value">@a.Text</MudSelectItem> }
                </MudSelect>
            </MudItem>
            <MudItem md="6">
                <MudSelect T="string" @bind-Value="_model.Delimiter" Label="Delimitador">
                    @foreach (var d in CaptureSvc.Delimiters) { <MudSelectItem T="string" Value="@d.Value">@d.Text</MudSelectItem> }
                </MudSelect>
            </MudItem>

            <MudItem xs="12" Class="d-flex align-center">
                <MudSwitch T="bool" @bind-Value="_model.HasHeaderRow" Color="Color.Secondary" Label="El archivo incluye fila de encabezados" />
            </MudItem>

            <MudItem xs="12">
                <MudFileUpload T="IBrowserFile" @bind-Files="_file" Accept=".txt,.csv" Hidden="true">
                    <CustomContent Context="upload">
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AttachFile"
                                   OnClick="@(() => upload.OpenFilePickerAsync())">
                            Seleccionar archivo (.txt / .csv)
                        </MudButton>
                    </CustomContent>
                </MudFileUpload>
                @if (_file is not null)
                {
                    <MudChip T="string" Class="mt-2" Icon="@Icons.Material.Filled.Description" Color="Color.Default">@_file.Name</MudChip>
                }
            </MudItem>
        </MudGrid>

        <MudStack Row="true" Spacing="2" Class="mt-6">
            <MudTooltip Text="Disponible cuando exista el endpoint de importación" Placement="Placement.Top">
                <span>
                    <MudButton Variant="Variant.Filled" Color="Color.Secondary"
                               StartIcon="@Icons.Material.Filled.CloudUpload" Disabled="true">Procesar archivo</MudButton>
                </span>
            </MudTooltip>
            <MudButton Variant="Variant.Outlined" OnClick="@(() => Nav.NavigateTo("/datacapture"))">Cancelar</MudButton>
        </MudStack>
    </MudForm>
</MudPaper>

@code {
    private MudForm _form = null!;
    private BulkImportViewModel _model = new();
    private IBrowserFile? _file;

}
