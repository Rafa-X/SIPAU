@page "/login"
@layout LoginLayout
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Iniciar sesión — SIPAU</PageTitle>
<div class="sipau-login">

    <section class="sipau-login-wall">
        <div class="sipau-login-ambient" aria-hidden="true"></div>
        <canvas id="sipau-login-network" class="sipau-login-network" aria-hidden="true"></canvas>

        <div class="sipau-login-block">
            <div class="sipau-login-identity">
                <span class="sipau-login-artwork">
                    <img src="login.png"
                         alt="Logotipo de la Universidad Politécnica de la Zona Metropolitana de Guadalajara" />
                </span>
            </div>
        </div>
    </section>

    <section class="sipau-login-card">
        <div class="sipau-login-inner">

            <div class="sipau-login-brand">
                <span class="sipau-login-brand-seal">
                    <img src="logo_UPZMG.png" alt="" width="44" height="39" />
                </span>
                <div>
                    <div class="sipau-login-title">
                        Universidad Politécnica de la Zona Metropolitana de Guadalajara
                    </div>
                    <div class="sipau-login-sub">SIPAU · Planeación</div>
                </div>
            </div>

            <h2 class="sipau-login-h1">Iniciar sesión</h2>
            <p class="sipau-login-lead">Usa tus credenciales institucionales.</p>

            @if (_waitMinutes is { } minutes)
            {
                <div class="sipau-login-error" role="alert">
                    Por seguridad, esta cuenta quedó bloqueada unos minutos después de varios intentos fallidos.
                    Vuelve a intentarlo en @minutes minuto@(minutes == 1 ? "" : "s").
                </div>
            }
            else if (_hasError)
            {
                <div class="sipau-login-error" role="alert">
                    No pudimos validar esas credenciales. Revisa tu correo y tu contraseña;
                    si el problema sigue, avisa a Tecnologías.
                </div>
            }

            <form method="post" action="/Account/Login">
                <AntiforgeryToken />

                <label class="sipau-login-label" for="email">Correo electrónico</label>
                <div class="sipau-login-field">
                    <input id="email" name="Email" type="email" class="sipau-login-input"
                           placeholder="usuario@upzmg.edu.mx" autocomplete="username" required autofocus />
                </div>

                <label class="sipau-login-label" for="password">Contraseña</label>
                <div class="sipau-login-field">
                    <input id="password" name="Password" type="password" class="sipau-login-input"
                           autocomplete="current-password" required />

                    <button type="button" class="sipau-login-eye" data-sipau-reveal="password"
                            aria-pressed="false" aria-label="Mostrar contraseña" tabindex="0">
                        <svg class="sipau-eye-on" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
                            <path d="M2.5 12S6 5.5 12 5.5 21.5 12 21.5 12 18 18.5 12 18.5 2.5 12 2.5 12Z"
                                  stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
                            <circle cx="12" cy="12" r="3.1" stroke="currentColor" stroke-width="1.6" />
                        </svg>
                        <svg class="sipau-eye-off" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
                            <path d="M9.9 5.8A9.6 9.6 0 0 1 12 5.5c6 0 9.5 6.5 9.5 6.5a17 17 0 0 1-3.3 4.1M6.2 7.9A17 17 0 0 0 2.5 12S6 18.5 12 18.5c1 0 1.9-.2 2.7-.5"
                                  stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                            <path d="M10 10a2.8 2.8 0 0 0 4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
                            <path d="M4 4 20 20" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
                        </svg>
                    </button>
                </div>

                <button type="submit" class="sipau-login-btn">Entrar</button>
            </form>

            <div class="sipau-login-foot">
                Uso exclusivo del personal autorizado · © @DateTime.Now.Year UPZMG
            </div>
        </div>
    </section>
</div>


@code {
    private bool _hasError;

    // Set when the API answered 429: the password may well be right, the account just has to wait.
    private int? _waitMinutes;

    protected override async Task OnInitializedAsync()
    {
        // Already signed in → go straight to the dashboard.
        var state = await AuthState.GetAuthenticationStateAsync();
        if (state.User.Identity?.IsAuthenticated == true)
        {
            Nav.NavigateTo("/dashboard", forceLoad: true);
            return;
        }

        var query = new Uri(Nav.Uri).Query;
        _hasError = query.Contains("error", StringComparison.OrdinalIgnoreCase);

        var waiting = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(query);
        if (waiting.TryGetValue("minutos", out var value) && int.TryParse(value, out var minutes))
            _waitMinutes = Math.Clamp(minutes, 1, 60);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await JS.InvokeVoidAsync("sipauInitLoginNetwork");
    }
}
