@page "/permissions"
@attribute [Authorize(Policy = AppPermissions.ManageUsers)]
@using UPZMG.Implementations
@using UPZMG.Implementations.Roles
@using UPZMG.Implementations.Permissions
@inject ISecurityService _securityService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Roles y Permisos — SIPAU</PageTitle>

<PageHeader Title="Roles y Permisos" Subtitle="Da de alta roles, asigna permisos y controla el acceso al sistema." BackHref="/settings"/>

<MudGrid>
    <MudItem xs="12" md="6">
        <SectionCard Title="Roles" Subtitle="Roles disponibles para asignar a los usuarios." Flush="true">
            <Actions>
                <MudButton Variant="Variant.Filled" Color="Color.Secondary"
                           StartIcon="@Icons.Material.Filled.AddModerator" OnClick="OpenCreateRole">
                    Nuevo rol
                </MudButton>
            </Actions>
            <ChildContent>
                @if (_isLoading)
                {
                    <LoadingState Text="Cargando roles…" />
                }
                else
                {
                    <DataToolbar @bind-Search="_roleSearch" Placeholder="Buscar rol…"
                                 Count="RolesFiltered.Count" Total="_roles.Count" />

                    <MudDataGrid T="Role" Items="RolesFiltered" Hover="true" Dense="true" Elevation="0"
                                 Filterable="false" SortMode="SortMode.Multiple">
                        <Columns>
                            <PropertyColumn Property="x => x.Name" Title="Rol" />
                            <TemplateColumn Title="Acciones" CellClass="sipau-cell-end" HeaderClass="sipau-cell-end" Sortable="false">
                                <CellTemplate>
                                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Secondary"
                                               StartIcon="@Icons.Material.Filled.Key" Class="mr-2"
                                               OnClick="() => OpenRolePermissions(context.Item)">
                                        Permisos
                                    </MudButton>
                                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                                               StartIcon="@Icons.Material.Filled.Edit" OnClick="() => OpenEditRole(context.Item)">
                                        Editar
                                    </MudButton>
                                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error"
                                               StartIcon="@Icons.Material.Filled.Delete" Class="ml-2"
                                               Disabled="@(context.Item.Name == "Admin")"
                                               OnClick="() => DeleteRoleAsync(context.Item)">
                                        Eliminar
                                    </MudButton>
                                </CellTemplate>
                            </TemplateColumn>
                        </Columns>
                        <NoRecordsContent>
                            <EmptyState Icon="@Icons.Material.Filled.PersonSearch"
                                        Title="Sin roles"
                                        Description="No se encontraron roles con ese criterio." />
                        </NoRecordsContent>
                    </MudDataGrid>
                }
            </ChildContent>
        </SectionCard>
    </MudItem>

    <MudItem xs="12" md="6">
        <SectionCard Title="Permisos"
                     Subtitle="Los define el sistema: cada endpoint y cada pantalla comparan ese nombre exacto. Lo que se administra es qué roles los tienen."
                     Flush="true">
            <Actions>
                <MudButton Variant="Variant.Filled" Color="Color.Secondary" Disabled="_isRestoring"
                           StartIcon="@Icons.Material.Filled.Sync" OnClick="RestoreCatalogueAsync">
                    Restaurar catálogo
                </MudButton>
            </Actions>
            <ChildContent>
                @if (_isLoading)
                {
                    <LoadingState Text="Cargando permisos…" />
                }
                else
                {
                    <DataToolbar @bind-Search="_permissionSearch" Placeholder="Buscar permiso…"
                                 Count="PermissionsFiltered.Count" Total="_permissions.Count" />

                    <MudDataGrid T="Permission" Items="PermissionsFiltered" Hover="true" Dense="true" Elevation="0"
                                 Filterable="false" SortMode="SortMode.Multiple">
                        <Columns>
                            <TemplateColumn Title="Permiso" SortBy="x => x.Name">
                                <CellTemplate>
                                    <div>@(context.Item.DisplayName ?? context.Item.Name)</div>
                                    <div class="sipau-field-empty sipau-mono">@context.Item.Name</div>
                                    @if (!string.IsNullOrWhiteSpace(context.Item.Description))
                                    {
                                        <MudText Typo="Typo.body2" Color="Color.Secondary">@context.Item.Description</MudText>
                                    }
                                </CellTemplate>
                            </TemplateColumn>
                            <TemplateColumn Title="Acciones" CellClass="sipau-cell-end" HeaderClass="sipau-cell-end" Sortable="false">
                                <CellTemplate>
                                    @if (IsSystemPermission(context.Item))
                                    {
                                        <MudTooltip Text="Renombrarlo o borrarlo dejaría sin efecto la autorización que lo revisa.">
                                            <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Default"
                                                     Icon="@Icons.Material.Filled.Lock">Del sistema</MudChip>
                                        </MudTooltip>
                                    }
                                    else
                                    {
                                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error"
                                                   StartIcon="@Icons.Material.Filled.Delete"
                                                   OnClick="() => DeletePermissionAsync(context.Item)">
                                            Eliminar
                                        </MudButton>
                                    }
                                </CellTemplate>
                            </TemplateColumn>
                        </Columns>
                        <NoRecordsContent>
                            <EmptyState Icon="@Icons.Material.Filled.SearchOff"
                                        Title="Sin permisos"
                                        Description="No se encontraron permisos con ese criterio." />
                        </NoRecordsContent>
                    </MudDataGrid>
                }
            </ChildContent>
        </SectionCard>
    </MudItem>
</MudGrid>


@code {
    private IReadOnlyList<Role> _roles = Array.Empty<Role>();
    private IReadOnlyList<Permission> _permissions = Array.Empty<Permission>();
    private string _roleSearch = string.Empty;
    private string _permissionSearch = string.Empty;
    private bool _isLoading = true;
    private bool _isRestoring;

    // A row the code does not declare grants nothing; it can be removed. The declared ones
    // cannot, because the name is what every authorisation check compares.
    private static bool IsSystemPermission(Permission permission) =>
        AppPermissions.All.Any(declared => declared.Name == permission.Name);

    private List<Role> RolesFiltered => string.IsNullOrWhiteSpace(_roleSearch)
        ? _roles.ToList()
        : _roles.Where(r => r.Name.Contains(_roleSearch, StringComparison.OrdinalIgnoreCase)).ToList();

    private List<Permission> PermissionsFiltered => string.IsNullOrWhiteSpace(_permissionSearch)
        ? _permissions.ToList()
        : _permissions.Where(p => p.Name.Contains(_permissionSearch, StringComparison.OrdinalIgnoreCase)
            || (p.DisplayName ?? string.Empty).Contains(_permissionSearch, StringComparison.CurrentCultureIgnoreCase)).ToList();

    protected override async Task OnInitializedAsync()
    {
        var requesterKey = await _securityService.GetRequesterKeyAsync();
        if (requesterKey == Guid.Empty)
        {
            Snackbar.Add("No se pudo identificar al usuario actual.", Severity.Error);
            _isLoading = false;
            return;
        }

        try
        {
            await ReloadAsync(requesterKey);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task ReloadAsync(Guid requesterKey)
    {
        _roles = await _securityService.GetAllRoles(new GetAllRoles { RequesterKey = requesterKey });
        _permissions = await _securityService.GetAllPermissions(new GetAllPermissions { RequesterKey = requesterKey });
    }

/*///////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////*/
    private Task OpenCreateRole() => ShowRoleDialog("Nuevo rol", new RoleFormViewModel());

    private Task OpenEditRole(Role role) => ShowRoleDialog("Editar rol", new RoleFormViewModel
    {
        Id = role.Id,
        Name = role.Name,
    });

    private async Task ShowRoleDialog(string title, RoleFormViewModel model)
    {
        var parameters = new DialogParameters<RoleDialog> { { x => x.Model, model } };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };

        var dialog = await DialogService.ShowAsync<RoleDialog>(title, parameters, options);
        var result = await dialog.Result;

        if (result is null || result.Canceled || result.Data is not RoleFormViewModel saved) return;

        var requesterKey = await _securityService.GetRequesterKeyAsync();
        if (requesterKey == Guid.Empty) return;

        try
        {
            if (saved.IsEditing)
                await _securityService.EditRole(new EditRole { RequesterKey = requesterKey, RoleId = saved.Id, Name = saved.Name });
            else
                await _securityService.CreateRole(new CreateRole { RequesterKey = requesterKey, Name = saved.Name });

            await ReloadAsync(requesterKey);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            return;
        }

        Snackbar.Add(saved.IsEditing
            ? $"Rol '{saved.Name}' actualizado correctamente."
            : $"Rol '{saved.Name}' creado correctamente.", Severity.Success);
    }

    private async Task DeleteRoleAsync(Role role)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Eliminar rol",
            $"Se eliminará el rol '{role.Name}' con sus permisos. Sólo se puede eliminar un rol que ninguna cuenta tiene asignado.",
            yesText: "Eliminar", cancelText: "Conservar");

        if (confirmed != true) return;

        var requesterKey = await _securityService.GetRequesterKeyAsync();
        if (requesterKey == Guid.Empty) return;

        try
        {
            if (!await _securityService.DeleteRole(new DeleteRole
                { RequesterKey = requesterKey, RoleId = role.Id }))
            {
                Snackbar.Add("No se pudo eliminar el rol.", Severity.Error);
                return;
            }

            await ReloadAsync(requesterKey);
            Snackbar.Add($"Rol '{role.Name}' eliminado correctamente.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task OpenRolePermissions(Role role)
    {
        var requesterKey = await _securityService.GetRequesterKeyAsync();
        if (requesterKey == Guid.Empty) return;

        if (_permissions.Count == 0)
        {
            Snackbar.Add("No hay permisos disponibles.", Severity.Warning);
            return;
        }

        var assigned = await _securityService.GetRolePermissions(new GetRolePermissions { RequesterKey = requesterKey, RoleId = role.Id });

        var parameters = new DialogParameters<RolePermissionsDialog>
        {
            { x => x.RoleName, role.Name },
            { x => x.Permissions, _permissions },
            { x => x.SelectedPermissionIds, assigned },
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };

        var dialog = await DialogService.ShowAsync<RolePermissionsDialog>($"Permisos de \"{role.Name}\"", parameters, options);
        var result = await dialog.Result;

        if (result is null || result.Canceled || result.Data is not List<Guid> selected) return;

        try
        {
            await _securityService.SetRolePermissions(new SetRolePermissions { RequesterKey = requesterKey, RoleId = role.Id, PermissionIds = selected });
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            return;
        }

        Snackbar.Add($"Permisos de '{role.Name}' actualizados correctamente.", Severity.Success);
    }

/*///////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////*/
    /// <summary>
    /// Writes back the permissions the code declares and the database is missing. Useful after
    /// an update that adds one: re-running the seed would rebuild the role assignments too and
    /// undo whatever an administrator had customised.
    /// </summary>
    private async Task RestoreCatalogueAsync()
    {
        var requesterKey = await _securityService.GetRequesterKeyAsync();
        if (requesterKey == Guid.Empty) return;

        _isRestoring = true;
        try
        {
            var result = await _securityService.RestorePermissionCatalogue(new GetAllPermissions { RequesterKey = requesterKey });
            await ReloadAsync(requesterKey);

            var message = result.Added == 0 && result.Updated == 0
                ? "El catálogo ya estaba completo."
                : $"Catálogo actualizado: {result.Added} permiso(s) agregado(s) y {result.Updated} redactado(s) de nuevo.";

            Snackbar.Add(message, Severity.Success);

            if (result.Unknown > 0)
            {
                Snackbar.Add(
                    $"Hay {result.Unknown} permiso(s) que el sistema no revisa: no otorgan nada y pueden eliminarse.",
                    Severity.Info);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _isRestoring = false;
        }
    }

    private async Task DeletePermissionAsync(Permission permission)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Eliminar permiso",
            $"Se eliminará el permiso '{permission.Name}', que el sistema no revisa, de todos los roles que lo tengan asignado.",
            yesText: "Eliminar", cancelText: "Conservar");

        if (confirmed != true) return;

        var requesterKey = await _securityService.GetRequesterKeyAsync();
        if (requesterKey == Guid.Empty) return;

        try
        {
            if (!await _securityService.DeletePermission(new DeletePermission
                { RequesterKey = requesterKey, PermissionId = permission.Id }))
            {
                Snackbar.Add("No se pudo eliminar el permiso.", Severity.Error);
                return;
            }

            await ReloadAsync(requesterKey);
            Snackbar.Add($"Permiso '{permission.Name}' eliminado correctamente.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }
}
