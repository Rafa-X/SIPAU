@page "/charts/teachers"
@attribute [Authorize]
@using UPZMG.Implementations.Charts
@inject IChartsService ChartsSvc

<PageTitle>Gráficas de docentes — SIPAU</PageTitle>

<PageHeader Title="Gráficas de docentes"
            Subtitle="Plantilla docente registrada en el sistema, por nivel de estudios y antigüedad" BackHref="/charts" />

@if (_loading)
{
    <LoadingState Text="Contando la plantilla docente…" />
}
else if (_model is null || _model.Teachers == 0)
{
    <SectionCard FullHeight="false">
        <EmptyState Icon="@Icons.Material.Filled.Groups"
                    Title="Todavía no hay docentes registrados"
                    Description="Captura el personal docente en Captura de datos › Docentes y estas gráficas se llenarán solas.">
            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Href="/datacapture/teachers">
                Ir a capturar docentes
            </MudButton>
        </EmptyState>
    </SectionCard>
}
else
{
    <MudGrid>
        <MudItem xs="12" lg="6">
            <SectionCard Title="Docentes por nivel de estudios"
                         Subtitle="Nivel máximo registrado en su expediente"
                         Icon="@Icons.Material.Filled.School" Accent="navy">
                <ChildContent>
                    <BarChart Labels="@Labels(_model.ByDegree)" Series="@Series(_model.ByDegree, ChartPalette.Navy)"
                              Height="290" AriaLabel="Docentes por nivel de estudios" />
                </ChildContent>
                <Footer>
                    Nivel predominante: <b>@Top(_model.ByDegree)</b> · total <b>@_model.Teachers</b> docentes
                </Footer>
            </SectionCard>
        </MudItem>

        <MudItem xs="12" lg="6">
            <SectionCard Title="Docentes por antigüedad"
                         Subtitle="Años desde su primera contratación en la universidad"
                         Icon="@Icons.Material.Filled.WorkHistory" Accent="teal">
                <ChildContent>
                    <BarChart Labels="@Labels(_model.BySeniority)" Series="@Series(_model.BySeniority, ChartPalette.Teal)"
                              Height="290" AriaLabel="Docentes por antigüedad" />
                </ChildContent>
                <Footer>
                    Grupo predominante: <b>@Top(_model.BySeniority)</b>
                </Footer>
            </SectionCard>
        </MudItem>
    </MudGrid>
}

@code {
    private TeachersDistribution? _model;
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        _model = await ChartsSvc.GetTeachersDistributionAsync();
        _loading = false;
    }

    private static List<string> Labels(IReadOnlyList<ChartCategory> categories) =>
        [.. categories.Select(category => category.Label)];

    private static List<ChartSeriesData> Series(IReadOnlyList<ChartCategory> categories, string colour) =>
        [new ChartSeriesData("Docentes", [.. categories.Select(category => (double)category.Value)], colour)];

    private static string Top(IReadOnlyList<ChartCategory> categories) =>
        categories.Count == 0 ? "Sin datos" : categories.MaxBy(category => category.Value)!.Label;
}
