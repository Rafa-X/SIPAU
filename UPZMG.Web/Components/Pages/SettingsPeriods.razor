@page "/settings/periods"
@attribute [Authorize(Policy = AppPermissions.ManagePeriods)]
@using System.Net
@using UPZMG.Implementations.Settings
@inject IPeriodsService PeriodsSvc
@inject ISecurityService SecuritySvc
@inject ISnackbar Snackbar

<PageTitle>Periodos escolares — SIPAU</PageTitle>

<PageHeader Title="Periodos escolares"
            Subtitle="Ciclos y cuatrimestres del sistema. El periodo activo determina a qué ciclo se asocian las capturas y los reportes."
            BackHref="/settings" />

<MudGrid>
    <MudItem xs="12" md="5">
        <SectionCard Title="Agregar periodo" Subtitle="El código identifica el ciclo en capturas y reportes"
                     Icon="@Icons.Material.Filled.EventRepeat">
            <ChildContent>
                <MudTextField @bind-Value="_newCode" Label="Código" Placeholder="2026-MA" MaxLength="20"
                              Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" />
                <MudTextField @bind-Value="_newPeriod" Label="Periodo" Placeholder="May-Ago" MaxLength="8"
                              Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" />
                <MudTextField @bind-Value="_newCycle" Label="Año del periodo" Placeholder="2026" MaxLength="4"
                              Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" />
                <MudDatePicker @bind-Date="_newStart" Label="Inicio"
                               Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" />
                <MudDatePicker @bind-Date="_newEnd" Label="Fin" MinDate="_newStart"
                               Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-4" />
                <MudButton Variant="Variant.Filled" Color="Color.Secondary" FullWidth="true"
                           StartIcon="@Icons.Material.Filled.Add" Disabled="_saving" OnClick="AddPeriodAsync">
                    Agregar periodo
                </MudButton>
            </ChildContent>
        </SectionCard>
    </MudItem>

    <MudItem xs="12" md="7">
        <SectionCard Title="Periodos registrados"
                     Subtitle="@ActiveSummary"
                     Icon="@Icons.Material.Filled.CalendarMonth" Flush="true">
            @if (_loading)
            {
                <LoadingState Text="Cargando periodos…" />
            }
            else
            {
                <MudDataGrid T="PeriodItem" Items="_periods" Hover="true" Dense="true" Elevation="0">
                    <Columns>
                        <PropertyColumn Property="x => x.Code" Title="Código" />
                        <PropertyColumn Property="x => x.Period" Title="Periodo" />
                        <PropertyColumn Property="x => x.SchoolCycle" Title="Año" />
                        <PropertyColumn Property="x => x.StartDate" Title="Inicio" Format="dd/MM/yyyy" />
                        <PropertyColumn Property="x => x.EndDate" Title="Fin" Format="dd/MM/yyyy" />
                        <TemplateColumn Title="Estado" CellClass="sipau-cell-end" HeaderClass="sipau-cell-end" Sortable="false">
                            <CellTemplate>
                                @if (context.Item.IsActive)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Text"
                                             Icon="@Icons.Material.Filled.CheckCircle">Activo</MudChip>
                                }
                                else
                                {
                                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Secondary"
                                               StartIcon="@Icons.Material.Filled.PlayArrow" Disabled="_saving"
                                               OnClick="() => ActivateAsync(context.Item)">
                                        Activar
                                    </MudButton>
                                }
                            </CellTemplate>
                        </TemplateColumn>
                    </Columns>
                    <NoRecordsContent>
                        @if (_loadFailed)
                        {
                            <EmptyState Icon="@Icons.Material.Filled.CloudOff"
                                        Title="No pudimos leer los periodos"
                                        Description="El servicio no respondió, así que esta pantalla no puede afirmar que no haya registros. Vuelve a cargar la página; si sigue así, avisa a Tecnologías." />
                        }
                        else
                        {
                            <EmptyState Title="Sin periodos registrados"
                                        Description="Agrega el primer periodo con el formulario y actívalo para empezar a capturar." />
                        }
                    </NoRecordsContent>
                </MudDataGrid>
            }
        </SectionCard>
    </MudItem>
</MudGrid>

@code {
    private IReadOnlyList<PeriodItem> _periods = [];
    private bool _loading = true;
    private bool _loadFailed;
    private bool _saving;

    private string _newCode = string.Empty;
    private string _newPeriod = string.Empty;
    private string _newCycle = string.Empty;
    private DateTime? _newStart;
    private DateTime? _newEnd;

    protected override Task OnInitializedAsync() => ReloadAsync();

    private async Task ReloadAsync()
    {
        _loading = true;
        try
        {
            _periods = await PeriodsSvc.GetPeriodsAsync();
            _loadFailed = false;
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException)
        {
            _periods = [];
            _loadFailed = true;
        }
        finally
        {
            _loading = false;
        }
    }

    private string ActiveSummary =>
        _loadFailed
            ? "No se pudo saber cuál es el periodo activo."
            : _periods.FirstOrDefault(p => p.IsActive) is { } p
                ? $"Periodo activo: {p.Period} ({p.SchoolCycle})"
                : "No hay ningún periodo activo — actívalo antes de capturar.";

    private async Task AddPeriodAsync()
    {
        if (string.IsNullOrWhiteSpace(_newCode) || string.IsNullOrWhiteSpace(_newPeriod) || string.IsNullOrWhiteSpace(_newCycle))
        {
            Snackbar.Add("Captura el código, el periodo y el año.", Severity.Warning);
            return;
        }

        // periods.SchoolCycle holds a four-digit year.
        var cycle = _newCycle.Trim();
        if (cycle.Length != 4 || !cycle.All(char.IsDigit))
        {
            Snackbar.Add("El año del periodo debe tener cuatro dígitos, por ejemplo 2026.", Severity.Warning);
            return;
        }

        if (_newStart is null || _newEnd is null || _newEnd <= _newStart)
        {
            Snackbar.Add("Indica las fechas de inicio y fin; el fin debe ser posterior al inicio.", Severity.Warning);
            return;
        }

        _saving = true;
        var code = _newCode.Trim();
        var status = await PeriodsSvc.CreatePeriodAsync(new CreatePeriod
        {
            RequesterKey = await SecuritySvc.GetRequesterKeyAsync(),
            Code = code,
            Period = _newPeriod.Trim(),
            SchoolCycle = cycle,
            StartDate = DateOnly.FromDateTime(_newStart.Value),
            EndDate = DateOnly.FromDateTime(_newEnd.Value),
        });
        _saving = false;

        switch (status)
        {
            case HttpStatusCode.Created:
            case HttpStatusCode.OK:
                Snackbar.Add($"Periodo '{code}' agregado. Actívalo cuando corresponda.", Severity.Success);
                _newCode = _newPeriod = _newCycle = string.Empty;
                _newStart = _newEnd = null;
                await ReloadAsync();
                break;
            case HttpStatusCode.Conflict:
                Snackbar.Add($"Ya existe un periodo con el código '{code}'.", Severity.Error);
                break;
            default:
                Snackbar.Add("No se pudo guardar el periodo. Revisa los datos e intenta de nuevo.", Severity.Error);
                break;
        }
    }

    private async Task ActivateAsync(PeriodItem period)
    {
        _saving = true;
        var activated = await PeriodsSvc.ActivatePeriodAsync(new ActivatePeriod
        {
            RequesterKey = await SecuritySvc.GetRequesterKeyAsync(),
            PeriodId = period.Id,
        });
        _saving = false;

        if (!activated)
        {
            Snackbar.Add($"No se pudo activar '{period.Code}'.", Severity.Error);
            return;
        }

        Snackbar.Add($"'{period.Code}' es ahora el periodo activo.", Severity.Success);
        await ReloadAsync();
    }
}
