@page "/charts/students"
@attribute [Authorize(Policy = AppPermissions.ReadIndicators)]
@using UPZMG.Implementations.Charts
@using UPZMG.Shared.Enums
@using UPZMG.Web.Models.Charts
@using UPZMG.Implementations.Intelligence

@using UPZMG.Implementations.DataCapture
@inject IStudentsService _studentsService
@inject IIntelligenceService Ai
@inject IChartsService ChartsSvc

<PageTitle>Gráficas de Alumnos - SIPAU</PageTitle>

<PageHeader Eyebrow="Analítica" Title="Gráficas de Alumnos" BackHref="/charts" />

@if (_loading)
{
    @* Without this the cards drew their empty states first: "sin kardex", "sin alumnos
       activos" and a total of zero, for the second it took the answers to arrive. *@
    <LoadingState Text="Leyendo los datos de alumnos…" />
}
else
{
<MudGrid>
    <MudItem xs="12" lg="6">
        <SectionCard Title="Nuevo ingreso por edad"
                     Subtitle="Alumnos que ingresaron en el periodo activo"
                     Icon="@Icons.Material.Filled.PersonAdd" Accent="teal">
            <ChildContent>
                @if (_agesFailed)
                {
                    <EmptyState Icon="@Icons.Material.Filled.CloudOff"
                                Title="No pudimos leer las edades"
                                Description="El servicio de alumnos no respondió. Vuelve a cargar la página." />
                }
                else if (_model.NewStudents.Labels.Count == 0)
                {
                    <EmptyState Icon="@Icons.Material.Filled.PersonAdd"
                                Title="Sin nuevo ingreso en el periodo activo"
                                Description="La gráfica cuenta a quienes ingresaron en el periodo activo; aparecerán en cuanto se capturen." />
                }
                else
                {
                    <BarChart Id="new-students-chart" Labels="_model.NewStudents.Labels" Series="_model.NewStudentsAges" Height="150"
                              CategoryHeader="Edad" AriaLabel="Estudiantes de nuevo ingreso por edad" />
                }
            </ChildContent>
            <Footer>
                Nuevo ingreso: <b>@_model.NewStudents.Values.Sum().ToString("N0")</b> estudiantes
            </Footer>
            <Actions>
                <MudTooltip Text="Descargar gráfica PNG" Placement="Placement.Top">
                    <MudIconButton Icon="@Icons.Material.Filled.FileDownload"
                                   Color="Color.Secondary"
                                   Size="Size.Small"
                                   data-sipau-chart-download="new-students-chart"
                                   data-sipau-chart-title="Nuevo ingreso por edad"
                                   data-sipau-chart-filename="Edad-estudiantes-nuevo-ingreso.png" />
                </MudTooltip>
            </Actions>
        </SectionCard>
    </MudItem>

    <MudItem xs="12" lg="6">
        <SectionCard Title="Todos los estudiantes por edad"
                     Subtitle="Todos los registrados, con su edad al día de hoy"
                     Icon="@Icons.Material.Filled.Groups" Accent="navy">
            <ChildContent>
                @if (_agesFailed)
                {
                    <EmptyState Icon="@Icons.Material.Filled.CloudOff"
                                Title="No pudimos leer las edades"
                                Description="El servicio de alumnos no respondió. Vuelve a cargar la página." />
                }
                else if (_model.AllStudents.Labels.Count == 0)
                {
                    <EmptyState Icon="@Icons.Material.Filled.Groups"
                                Title="Sin estudiantes registrados"
                                Description="Captura alumnos en Captura de datos › Alumnos y aparecerán aquí por edad." />
                }
                else
                {
                    <BarChart Id="all-students-chart" Labels="_model.AllStudents.Labels" Series="_model.AllStudentsAges" Height="150"
                              CategoryHeader="Edad" AriaLabel="Todos los estudiantes por edad" />
                }
            </ChildContent>
            <Footer>
                Total de estudiantes: <b>@_model.AllStudents.Values.Sum().ToString("N0")</b>
            </Footer>
            <Actions>
                <MudTooltip Text="Descargar gráfica PNG" Placement="Placement.Top">
                    <MudIconButton Icon="@Icons.Material.Filled.FileDownload"
                                   Color="Color.Secondary"
                                   Size="Size.Small"
                                   data-sipau-chart-download="all-students-chart"
                                   data-sipau-chart-title="Todos los estudiantes por edad"
                                   data-sipau-chart-filename="Edad-todos-los-estudiantes.png" />
                </MudTooltip>
            </Actions>
        </SectionCard>
    </MudItem>

    <MudItem xs="12">
        <SectionCard Title="Aprobación vs. reprobación"
                     Subtitle="Índices institucionales de aprovechamiento por periodo"
                     Icon="@Icons.Material.Filled.FactCheck" Accent="navy">
            <ChildContent>
                @if (_historyFailed)
                {
                    <EmptyState Icon="@Icons.Material.Filled.CloudOff"
                                Title="No pudimos leer el historial"
                                Description="El servicio de indicadores no respondió. Vuelve a cargar la página." />
                }
                else if (_graded.Count == 0)
                {
                    <EmptyState Icon="@Icons.Material.Filled.FactCheck"
                                Title="Sin kardex registrado"
                                Description="El índice se calcula de las calificaciones capturadas; en cuanto haya kardex del periodo aparecerá aquí." />
                }
                else
                {
                    <BarChart Id="aprobacion-reprobacion-chart" Labels="_achievementLabels" Series="_achievement" Height="180"
                              ValueFormat="0.#" Unit="%" Max="100" CategoryHeader="Periodo"
                              AriaLabel="Aprobación contra reprobación" />
                }
            </ChildContent>
            <Footer>
                @if (_graded.Count > 0)
                {
                    <span>
                        @_graded[^1].Label: aprobación <b>@($"{_graded[^1].PassRate:0.0}")</b> % sobre
                        @($"{_graded[^1].Passed + _graded[^1].Failed:N0}") oportunidades calificadas
                        @if (_passRateChange is { } change)
                        {
                            <text> · @(change >= 0 ? "sube" : "baja") @($"{Math.Abs(change):0.0}") puntos frente a @_graded[0].Label</text>
                        }
                    </span>
                    @if (_graded.Count < _periods.Count)
                    {
                        <text> · @(_periods.Count - _graded.Count) periodo(s) sin kardex capturado quedan fuera</text>
                    }
                }
            </Footer>
            <Actions>
                <MudTooltip Text="Descargar gráfica PNG" Placement="Placement.Top">
                    <MudIconButton Icon="@Icons.Material.Filled.FileDownload"
                                   Color="Color.Secondary"
                                   Size="Size.Small"
                                   data-sipau-chart-download="aprobacion-reprobacion-chart"
                                   data-sipau-chart-title="Aprobación vs. reprobación"
                                   data-sipau-chart-filename="Aprobacion-vs-reprobacion.png" />
                </MudTooltip>
            </Actions>
        </SectionCard>
    </MudItem>

    <MudItem xs="12" lg="7">
        <SectionCard Title="Matrícula por programa y sexo"
                     Subtitle="Alumnos activos, el desglose que piden el 911 y el SII"
                     Icon="@Icons.Material.Filled.Wc" Accent="teal">
            <ChildContent>
                @if (_gender is null || _gender.Careers.Count == 0)
                {
                    <EmptyState Icon="@Icons.Material.Filled.Wc"
                                Title="Sin alumnos activos"
                                Description="En cuanto haya alumnos activos capturados, el desglose por sexo se calcula solo." />
                }
                else
                {
                    <BarChart Id="gender-chart" Labels="_gender.Careers" Series="_genderSeries" Height="200"
                              CategoryHeader="Programa" AriaLabel="Alumnos activos por programa y sexo" />
                }
            </ChildContent>
            <Footer>
                @if (_gender is { } gender && gender.Careers.Count > 0)
                {
                    var total = gender.TotalWomen + gender.TotalMen;
                    <span>
                        @gender.TotalWomen.ToString("N0") mujeres y @gender.TotalMen.ToString("N0") hombres ·
                        @(total == 0 ? "0" : (100.0 * gender.TotalWomen / total).ToString("0.0")) % de mujeres
                    </span>
                }
                else
                {
                    <span>Calculado de los alumnos con estatus activo.</span>
                }
            </Footer>
        </SectionCard>
    </MudItem>

    <MudItem xs="12" lg="5">
        <SectionCard Title="Becas por fuente"
                     Subtitle="@ScholarshipsSubtitle"
                     Icon="@Icons.Material.Filled.Savings" Accent="gold">
            <ChildContent>
                @if (_scholarships is null || _scholarships.Sources.Count == 0)
                {
                    <EmptyState Icon="@Icons.Material.Filled.Savings"
                                Title="Sin becas registradas"
                                Description="Captura una beca por alumno y periodo, y el desglose por fuente de financiamiento aparece aquí.">
                        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Href="/datacapture/scholarships">
                            Capturar beca
                        </MudButton>
                    </EmptyState>
                }
                else
                {
                    <BarChart Id="scholarships-chart" Labels="_scholarships.Sources" Series="_scholarshipSeries" Height="200"
                              CategoryHeader="Fuente" AriaLabel="Alumnos becados por fuente de financiamiento" />
                }
            </ChildContent>
            <Footer>
                @if (_scholarships is { } becas && becas.Sources.Count > 0)
                {
                    <span>
                        @becas.Beneficiaries.ToString("N0") alumnos becados ·
                        @becas.Grants.ToString("N0") becas ·
                        @becas.TotalAmount.ToString("C0", Mx) en @becas.Scope
                    </span>
                }
                else
                {
                    <span>Padrón de becas por alumno y periodo.</span>
                }
            </Footer>

        </SectionCard>
    </MudItem>
</MudGrid>
}

@code {
    private ChartsStudentsModel _model = new ChartsStudentsModel();
    private bool _loading = true;

    private static readonly System.Globalization.CultureInfo Mx = new("es-MX");

    private GenderDistribution? _gender;
    private ScholarshipsBySource? _scholarships;

    // The chart falls back to the whole history when the active period has no grants yet, so
    // the card says which of the two it is showing instead of always claiming "vigentes".
    private string ScholarshipsSubtitle => _scholarships is { Sources.Count: > 0 } becas
        ? $"Distribución por financiamiento · {becas.Scope}"
        : "Distribución de becas por fuente de financiamiento";

    private List<ChartSeriesData> _scholarshipSeries =>
    [
        new ChartSeriesData("Alumnos becados", [.. (_scholarships?.Students ?? []).Select(v => (double)v)], ChartPalette.Ochre),
    ];

    private List<ChartSeriesData> _genderSeries =>
    [
        new ChartSeriesData("Mujeres", [.. (_gender?.Women ?? []).Select(v => (double)v)], ChartPalette.Ochre),
        new ChartSeriesData("Hombres", [.. (_gender?.Men ?? []).Select(v => (double)v)], ChartPalette.Navy),
    ];
    
    // ── Aprovechamiento, calculado del kardex registrado ────────────────────

    private IReadOnlyList<PeriodStats> _periods = [];
    private bool _historyFailed;
    private bool _agesFailed;

    // Only the periods that have a kardex. A period with no grades has no pass rate: drawing
    // the complement of a missing figure reported it as a period in which everybody failed.
    private List<PeriodStats> _graded => [.. _periods.Where(period => period.HasGrades)];

    private List<ChartSeriesData> _achievement =>
    [
        new ChartSeriesData("Aprobación", [.. _graded.Select(period => Math.Round(period.PassRate!.Value, 1))], ChartPalette.Teal),
        new ChartSeriesData("Reprobación", [.. _graded.Select(period => Math.Round(100 - period.PassRate!.Value, 1))], ChartPalette.Clay),
    ];

    private List<string> _achievementLabels => [.. _graded.Select(period => period.Label)];

    // Points the pass rate moved between the first and the last graded period on record.
    private double? _passRateChange => _graded.Count < 2
        ? null
        : _graded[^1].PassRate - _graded[0].PassRate;

    protected override async Task OnInitializedAsync()
    {
        var newStudentsTask = _studentsService.GetStudentsAgesAsync(newOnly: true);
        var allStudentsTask = _studentsService.GetStudentsAgesAsync();
        var results = await Task.WhenAll(newStudentsTask, allStudentsTask);

        // Each card keeps its own state: null is "this one could not load", not "no students".
        _agesFailed = results[0] is null || results[1] is null;
        _model.NewStudents = MapAges(results[0] ?? []);
        _model.AllStudents = MapAges(results[1] ?? []);
        _model.NewStudentsAges = [new ChartSeriesData("Nuevo ingreso", _model.NewStudents.Values, ChartPalette.Teal)];
        _model.AllStudentsAges = [new ChartSeriesData("Todos los estudiantes", _model.AllStudents.Values, ChartPalette.Navy)];

        var history = await Ai.GetHistoryAsync();
        _historyFailed = history is null;
        _periods = history ?? [];
        _gender = await ChartsSvc.GetGenderDistributionAsync();
        _scholarships = await ChartsSvc.GetScholarshipsBySourceAsync();
        _loading = false;
    }

    private static ChartStudentsAges MapAges(IReadOnlyList<StudentsAges> ages) => new()
    {
        Labels = ages.Select(age => age.Name).ToList(),
        Values = ages.Select(age => (double)age.Values.Count).ToList(),
    };
}
