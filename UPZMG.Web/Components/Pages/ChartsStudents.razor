@page "/charts/students"
@attribute [Authorize]
@using UPZMG.Implementations.Charts
@using UPZMG.Shared.Enums
@using UPZMG.Web.Models.Charts
@using UPZMG.Implementations.Intelligence

@using UPZMG.Implementations.DataCapture
@inject IStudentsService _studentsService
@inject IIntelligenceService Ai
@inject IChartsService ChartsSvc

<PageTitle>Gráficas de Alumnos - SIPAU</PageTitle>

<PageHeader Eyebrow="Analitica" Title="Graficas de Alumnos" BackHref="/charts" />

<MudGrid>
    <MudItem xs="12" lg="6">
        <SectionCard Title="Nuevo ingreso por edad"
                     Icon="@Icons.Material.Filled.PersonAdd" Accent="teal">
            <ChildContent>
                <BarChart Id="new-students-chart" Labels="_model.NewStudents.Labels" Series="_model.NewStudentsAges" Height="150"
                          AriaLabel="Estudiantes de nuevo ingreso por edad" />
            </ChildContent>
            <Footer>
                Total de estudiantes: @_model.NewStudents.Values.Sum()
            </Footer>
            <Actions>
                <MudTooltip Text="Descargar gráfica PNG" Placement="Placement.Top">
                    <MudIconButton Icon="@Icons.Material.Filled.FileDownload"
                                   Color="Color.Secondary"
                                   Size="Size.Small"
                                   data-sipau-chart-download="new-students-chart"
                                   data-sipau-chart-title="Nuevo ingreso por edad"
                                   data-sipau-chart-filename="Edad-estudiantes-nuevo-ingreso.png" />
                </MudTooltip>
            </Actions>
        </SectionCard>
    </MudItem>

    <MudItem xs="12" lg="6">
        <SectionCard Title="Todos los estudiantes por edad"
                     Icon="@Icons.Material.Filled.Groups" Accent="navy">
            <ChildContent>
                <BarChart Id="all-students-chart" Labels="_model.AllStudents.Labels" Series="_model.AllStudentsAges" Height="150"
                          AriaLabel="Todos los estudiantes por edad" />
            </ChildContent>
            <Footer>
                Total de estudiantes: @_model.AllStudents.Values.Sum()
            </Footer>
            <Actions>
                <MudTooltip Text="Descargar gráfica PNG" Placement="Placement.Top">
                    <MudIconButton Icon="@Icons.Material.Filled.FileDownload"
                                   Color="Color.Secondary"
                                   Size="Size.Small"
                                   data-sipau-chart-download="all-students-chart"
                                   data-sipau-chart-title="Todos los estudiantes por edad"
                                   data-sipau-chart-filename="Edad-todos-los-estudiantes.png" />
                </MudTooltip>
            </Actions>
        </SectionCard>
    </MudItem>

    <MudItem xs="12" lg="7">
        <SectionCard Title="Aprobación vs. reprobación"
                     Subtitle="Índices institucionales de aprovechamiento por periodo"
                     Icon="@Icons.Material.Filled.FactCheck" Accent="navy">
            <ChildContent>
                @if (_periods.Count == 0)
                {
                    <EmptyState Icon="@Icons.Material.Filled.FactCheck"
                                Title="Sin kardex registrado"
                                Description="El índice se calcula de las calificaciones capturadas; en cuanto haya kardex del periodo aparecerá aquí." />
                }
                else
                {
                    <BarChart Id="aprobacion-reprobacion-chart" Labels="_achievementLabels" Series="_achievement" Height="160"
                              ValueFormat="0.0" Unit="%" AriaLabel="Aprobación contra reprobación" />
                }
            </ChildContent>
            <Footer>
                @if (_periods.Count > 0)
                {
                    <span>
                        @_periods[^1].Label: aprobación <b>@($"{_periods[^1].PassRate:0.0}")</b> % sobre
                        @($"{_periods[^1].Passed + _periods[^1].Failed:N0}") materias calificadas
                        @if (_passRateChange is { } change)
                        {
                            <text> · @(change >= 0 ? "sube" : "baja") @($"{Math.Abs(change):0.0}") puntos frente a @_periods[0].Label</text>
                        }
                    </span>
                }
            </Footer>
            <Actions>
                <MudTooltip Text="Descargar gráfica PNG" Placement="Placement.Top">
                    <MudIconButton Icon="@Icons.Material.Filled.FileDownload"
                                   Color="Color.Secondary"
                                   Size="Size.Small"
                                   data-sipau-chart-download="aprobacion-reprobacion-chart"
                                   data-sipau-chart-title="Aprobación vs. reprobación"
                                   data-sipau-chart-filename="Aprobacion-vs-reprobacion.png" />
                </MudTooltip>
            </Actions>
        </SectionCard>
    </MudItem>

    <MudItem xs="12" lg="7">
        <SectionCard Title="Matrícula por programa y sexo"
                     Subtitle="Alumnos activos, el desglose que piden el 911 y el SII"
                     Icon="@Icons.Material.Filled.Wc" Accent="teal">
            <ChildContent>
                @if (_gender is null || _gender.Careers.Count == 0)
                {
                    <EmptyState Icon="@Icons.Material.Filled.Wc"
                                Title="Sin alumnos activos"
                                Description="En cuanto haya alumnos activos capturados, el desglose por sexo se calcula solo." />
                }
                else
                {
                    <BarChart Id="gender-chart" Labels="_gender.Careers" Series="_genderSeries" Height="200"
                              AriaLabel="Alumnos activos por programa y sexo" />
                }
            </ChildContent>
            <Footer>
                @if (_gender is { } gender && gender.Careers.Count > 0)
                {
                    var total = gender.TotalWomen + gender.TotalMen;
                    <span>
                        @gender.TotalWomen.ToString("N0") mujeres y @gender.TotalMen.ToString("N0") hombres ·
                        @(total == 0 ? "0" : (100.0 * gender.TotalWomen / total).ToString("0.0")) % de mujeres
                    </span>
                }
                else
                {
                    <span>Calculado de los alumnos con estatus activo.</span>
                }
            </Footer>
        </SectionCard>
    </MudItem>

    <MudItem xs="12" lg="5">
        <SectionCard Title="Becas por fuente"
                     Subtitle="Distribución de becas vigentes por financiamiento"
                     Icon="@Icons.Material.Filled.Savings" Accent="gold">
            <ChildContent>
                @if (_scholarships is null || _scholarships.Sources.Count == 0)
                {
                    <EmptyState Icon="@Icons.Material.Filled.Savings"
                                Title="Sin becas registradas"
                                Description="Captura una beca por alumno y periodo, y el desglose por fuente de financiamiento aparece aquí.">
                        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Href="/datacapture/scholarships">
                            Capturar beca
                        </MudButton>
                    </EmptyState>
                }
                else
                {
                    <BarChart Id="scholarships-chart" Labels="_scholarships.Sources" Series="_scholarshipSeries" Height="200"
                              AriaLabel="Alumnos becados por fuente de financiamiento" />
                }
            </ChildContent>
            <Footer>
                @if (_scholarships is { } becas && becas.Sources.Count > 0)
                {
                    <span>
                        @becas.TotalStudents.ToString("N0") alumnos becados ·
                        @becas.TotalAmount.ToString("C0", Mx) en el periodo activo
                    </span>
                }
                else
                {
                    <span>Padrón de becas por alumno y periodo.</span>
                }
            </Footer>

        </SectionCard>
    </MudItem>
</MudGrid>

@code {
    private ChartsStudentsModel _model = new ChartsStudentsModel();

    private static readonly System.Globalization.CultureInfo Mx = new("es-MX");

    private GenderDistribution? _gender;
    private ScholarshipsBySource? _scholarships;

    private List<ChartSeriesData> _scholarshipSeries =>
    [
        new ChartSeriesData("Alumnos becados", [.. (_scholarships?.Students ?? []).Select(v => (double)v)], ChartPalette.Ochre),
    ];

    private List<ChartSeriesData> _genderSeries =>
    [
        new ChartSeriesData("Mujeres", [.. (_gender?.Women ?? []).Select(v => (double)v)], ChartPalette.Teal),
        new ChartSeriesData("Hombres", [.. (_gender?.Men ?? []).Select(v => (double)v)], ChartPalette.Navy),
    ];
    
    // ── Aprovechamiento, calculado del kardex registrado ────────────────────

    private IReadOnlyList<PeriodStats> _periods = [];

    private List<ChartSeriesData> _achievement =>
    [
        new ChartSeriesData("Aprobación", [.. _periods.Select(period => Math.Round(period.PassRate, 1))], ChartPalette.Teal),
        new ChartSeriesData("Reprobación", [.. _periods.Select(period => Math.Round(100 - period.PassRate, 1))], ChartPalette.Clay),
    ];

    private List<string> _achievementLabels => [.. _periods.Select(period => period.Label)];

    // Points the pass rate moved between the first and the last period on record.
    private double? _passRateChange => _periods.Count < 2 ? null : _periods[^1].PassRate - _periods[0].PassRate;

    protected override async Task OnInitializedAsync()
    {
        var newStudentsTask = _studentsService.GetStudentsAgesAsync(newOnly: true);
        var allStudentsTask = _studentsService.GetStudentsAgesAsync();
        var results = await Task.WhenAll(newStudentsTask, allStudentsTask);

        _model.NewStudents = MapAges(results[0]);
        _model.AllStudents = MapAges(results[1]);
        _model.NewStudentsAges = [new ChartSeriesData("Nuevo ingreso", _model.NewStudents.Values, ChartPalette.Teal)];
        _model.AllStudentsAges = [new ChartSeriesData("Todos los estudiantes", _model.AllStudents.Values, ChartPalette.Navy)];

        _periods = await Ai.GetHistoryAsync();
        _gender = await ChartsSvc.GetGenderDistributionAsync();
        _scholarships = await ChartsSvc.GetScholarshipsBySourceAsync();
    }

    private static ChartStudentsAges MapAges(IReadOnlyList<StudentsAges> ages) => new()
    {
        Labels = ages.Select(age => age.Name).ToList(),
        Values = ages.Select(age => (double)age.Values.Count).ToList(),
    };
}
