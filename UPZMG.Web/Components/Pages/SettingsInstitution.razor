@page "/settings/institution"
@attribute [Authorize(Policy = AppPermissions.AnyAdministration)]
@using UPZMG.Implementations.Institution
@inject IGeneralDataService GeneralDataSvc

@*
    Read-only on purpose. These values are the ones the university reported in the official
    911.10 format, and they are the ones that head the board report. Editing them here would
    create a second version of the same data that could disagree with what was sent.
*@

<PageTitle>Datos de la institución — SIPAU</PageTitle>

<PageHeader Eyebrow="Administración" Title="Datos de la institución"
            Subtitle="Información maestra que encabeza los reportes generados" BackHref="/settings" />

@if (_profile is null)
{
    <SectionCard FullHeight="false">
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
    </SectionCard>
}
else if (!_profile.IsReported)
{
    <SectionCard FullHeight="false">
        <EmptyState Icon="@Icons.Material.Filled.AccountBalance"
                    Title="Todavía no se ha capturado el formato de institución"
                    Description="Estos datos no se escriben aquí: provienen del formato 911.10 — Institución. En cuanto Dirección Académica lo capture, aparecerán en esta pantalla y en el encabezado del informe a la Junta.">
            <MudButton Variant="Variant.Filled" Color="Color.Secondary" Href="/reports"
                       StartIcon="@Icons.Material.Filled.Assignment">Ir a Reportes</MudButton>
        </EmptyState>
    </SectionCard>
}
else
{
    <MudAlert Severity="@(_profile.IsSubmitted ? Severity.Info : Severity.Warning)" Variant="Variant.Outlined" Class="mb-4">
        @if (_profile.IsSubmitted)
        {
            <text>
                Datos tomados del formato <b>911.10 — Institución</b> del ciclo <b>@_profile.SourceCycle</b>, ya enviado.
                Para corregirlos hay que capturar el formato del ciclo siguiente: una captura enviada no se modifica.
            </text>
        }
        else
        {
            <text>
                Datos tomados del formato <b>911.10 — Institución</b> del ciclo <b>@_profile.SourceCycle</b>,
                que todavía está <b>en borrador</b>. Pueden cambiar hasta que el área lo envíe.
            </text>
        }
    </MudAlert>

    <SectionCard Title="Identificación" FullHeight="false">
        <dl class="sipau-datalist">
            <Field Label="Nombre de la institución" Value="@_profile.InstitutionName" />
            <Field Label="Clave institucional" Value="@_profile.InstitutionKey" />
            <Field Label="Rector(a)" Value="@_profile.RectorName" />
            <Field Label="Sostenimiento" Value="@_profile.Sostenimiento" />
            <Field Label="Municipio" Value="@_profile.Municipality" />
            <Field Label="Entidad" Value="@_profile.State" />
            <Field Label="Correo del responsable" Value="@_profile.ResponsibleEmail" />
        </dl>
    </SectionCard>

    <div class="mt-4">
        <MudButton Variant="Variant.Text" Color="Color.Primary" Href="/reports"
                   EndIcon="@Icons.Material.Filled.ArrowForward">Ver la captura de origen</MudButton>
    </div>
}

@code {
    private InstitutionProfile? _profile;

    protected override async Task OnInitializedAsync() => _profile = await GeneralDataSvc.GetInstitutionAsync();
}
