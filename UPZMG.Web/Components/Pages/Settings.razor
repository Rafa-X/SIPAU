@page "/settings"
@attribute [Authorize(Policy = AppPermissions.AnyAdministration)]

<PageTitle>Configuración — SIPAU</PageTitle>

<PageHeader Title="Configuración" Subtitle="Administración de datos maestros del sistema" />

<MudGrid>
    @foreach (var card in _cards)
    {
        <MudItem xs="12" sm="6" md="3">
            <MudCard Elevation="1" Class="d-flex flex-column" Style="height:100%">
                <MudCardContent class="flex-grow-1">
                    <MudAvatar Color="Color.Secondary" Variant="Variant.Filled" Rounded="true" Class="mb-3">
                        <MudIcon Icon="@card.Icon" />
                    </MudAvatar>
                    <MudText Typo="Typo.h6">@card.Title</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@card.Description</MudText>
                </MudCardContent>
                <MudCardActions>
                    <MudButton Variant="Variant.Text" Color="Color.Primary" Href="@card.Href" EndIcon="@Icons.Material.Filled.ArrowForward">Abrir</MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>
    }
</MudGrid>

@code {
    private sealed record Card(string Title, string Description, string Icon, string Href);

    private readonly Card[] _cards =
    {
        new("Datos de la institución", "Nombre, rector, clave y domicilio que encabezan los reportes, tal como se capturaron en el formato 911.10.", Icons.Material.Filled.AccountBalance, "/settings/institution"),
        new("Periodos escolares", "Ciclos y cuatrimestres. Define cuál es el periodo activo del sistema.", Icons.Material.Filled.CalendarMonth, "/settings/periods"),
        new("Plantillas de formatos", "Publica los formatos de un ciclo nuevo y agrega indicadores sin programar: cada formato es un archivo de datos.", Icons.Material.Filled.Tune, "/reports/plantillas"),
        new("Roles y Permisos", "Da de alta roles, asigna permisos y controla el acceso al sistema.", Icons.Material.Filled.People, "/permissions"),
    };
}
