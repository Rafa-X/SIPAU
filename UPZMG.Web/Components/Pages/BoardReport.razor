@page "/boardreport"
@attribute [Authorize(Policy = AppPermissions.ReadBoardReport)]
@using UPZMG.Implementations.BoardReport
@inject IBoardReportService BoardSvc

@*
    One board report per cycle. The report captures nothing of its own: it consolidates the
    official formats each area sent, so this listing is really the state of those formats.
*@

<PageTitle>Informe de Junta — SIPAU</PageTitle>

<PageHeader Title="Informe de Junta Directiva"
            Subtitle="Un informe por ciclo. Reúne las cifras de los formatos oficiales que enviaron las áreas y los textos que redacta la universidad.">
    <Actions>
        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Secondary"
                   StartIcon="@Icons.Material.Filled.Description" Href="/reports">
            Ver formatos
        </MudButton>
    </Actions>
</PageHeader>

@if (_loading)
{
    <LoadingState Text="Revisando los formatos de cada ciclo…" />
}
else if (_loadFailed)
{
    <SectionCard FullHeight="false">
        <EmptyState Icon="@Icons.Material.Filled.CloudOff"
                    Title="No pudimos leer los ciclos"
                    Description="El servicio no respondió, así que esta pantalla no puede afirmar que no haya informes. Vuelve a cargar la página; si sigue así, avisa a Tecnologías." />
    </SectionCard>
}
else if (_cycles.Count == 0)
{
    <SectionCard FullHeight="false">
        <EmptyState Icon="@Icons.Material.Filled.Article"
                    Title="Todavía no hay ciclos que informar"
                    Description="El informe se arma sobre los formatos oficiales publicados. En cuanto exista un formato de un ciclo, aparecerá aquí.">
            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Href="/reports">Ir a los formatos</MudButton>
        </EmptyState>
    </SectionCard>
}
else
{
    <MudGrid>
        @foreach (var cycle in _cycles)
        {
            <MudItem xs="12" md="6" lg="4">
                <SectionCard Title="@($"Ciclo {cycle.Cycle}")"
                             Subtitle="@Subtitle(cycle)"
                             Icon="@Icons.Material.Filled.Article">
                    <ChildContent>
                        <div class="sipau-risk-row">
                            <span class="sipau-risk-label">Formatos enviados</span>
                            <span class="sipau-risk-num">@cycle.SubmittedFormats de @cycle.TotalFormats</span>
                        </div>
                        <Meter Value="@(cycle.TotalFormats == 0 ? 0 : 100.0 * cycle.SubmittedFormats / cycle.TotalFormats)" />
                        <div class="sipau-risk-sub mt-2">
                            @if (cycle.SubmittedFormats < cycle.TotalFormats)
                            {
                                var pending = cycle.TotalFormats - cycle.SubmittedFormats;
                                <text>@(pending == 1 ? "Falta 1 por enviar; ese capítulo saldrá marcado como pendiente." : $"Faltan {pending} por enviar; esos capítulos saldrán marcados como pendientes.")</text>
                            }
                            else
                            {
                                <text>Todas las áreas enviaron su formato.</text>
                            }
                        </div>

                        <div class="sipau-risk-row mt-4">
                            <span class="sipau-risk-label">Textos de la universidad</span>
                            <span class="sipau-risk-num">@(10 - cycle.PendingNarratives) de 10</span>
                        </div>
                        <Meter Value="@(100.0 * (10 - cycle.PendingNarratives) / 10)" />
                        <div class="sipau-risk-sub mt-2">
                            @if (cycle.PendingNarratives > 0)
                            {
                                <text>@cycle.PendingNarratives siguen con la redacción sugerida.</text>
                            }
                            else
                            {
                                <text>Todos los apartados están redactados.</text>
                            }
                        </div>
                    </ChildContent>
                    <Footer>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Style="flex-wrap:wrap">
                            <span class="@StatusClass(cycle.Status)">@StatusLabel(cycle.Status)</span>
                            @if (cycle.LastModified is { } modified)
                            {
                                <span class="sipau-risk-sub">@ReportUi.Local(modified)</span>
                            }
                            <MudSpacer />
                            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Secondary"
                                       StartIcon="@Icons.Material.Filled.Print"
                                       Href="@($"/boardreport/{cycle.Cycle}/documento")">
                                Documento
                            </MudButton>
                            <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.ArrowForward"
                                       Href="@($"/boardreport/{cycle.Cycle}")">
                                Abrir
                            </MudButton>
                        </MudStack>
                    </Footer>
                </SectionCard>
            </MudItem>
        }
    </MudGrid>
}

@code {
    private IReadOnlyList<BoardReportListItem> _cycles = [];
    private bool _loading = true;
    private bool _loadFailed;

    protected override async Task OnInitializedAsync()
    {
        var cycles = await BoardSvc.GetCyclesAsync();
        // Null is "the listing could not be read", which is not the same as having none.
        _loadFailed = cycles is null;
        _cycles = cycles ?? [];
        _loading = false;
    }

    private static string Subtitle(BoardReportListItem cycle) =>
        cycle.Status == BoardReportStatus.Submitted
            ? "Cerrado: sus cifras ya no cambian"
            : "En preparación";

    private static string StatusLabel(string status) =>
        status == BoardReportStatus.Submitted ? "Cerrado" : "Borrador";

    private static string StatusClass(string status) =>
        status == BoardReportStatus.Submitted
            ? "sipau-report-status is-compact is-sent"
            : "sipau-report-status is-compact is-draft";
}
