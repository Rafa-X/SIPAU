@page "/boardreport"
@attribute [Authorize]
@inject IBoardReportService BoardSvc
@inject IJSRuntime JS

<PageTitle>Informe de Junta — SIGIE</PageTitle>

<PageHeader Eyebrow="Junta directiva" Title="Informe de Junta Directiva" Subtitle="Reporte estandarizado presentado a la junta directiva">
    <Actions>
        <MudButton Variant="Variant.Filled" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Add">Generar informe</MudButton>
    </Actions>
</PageHeader>

<SectionCard Flush="true" FullHeight="false">
    <DataToolbar @bind-Search="_search" Placeholder="Buscar periodo…"
                 Count="Filtered.Count" Total="_reports.Count" OnExport="ExportAsync">
        <Filters>
            <MudSelect T="string" Value="_status" ValueChanged="@(v => _status = v)" Dense="true"
                       Variant="Variant.Outlined" Margin="Margin.Dense" Class="sigie-toolbar-filter mt-0"
                       Placeholder="Estado" Clearable="true">
                <MudSelectItem T="string" Value="@(null!)">Todos los estados</MudSelectItem>
                @foreach (var s in _statuses)
                {
                    <MudSelectItem T="string" Value="@s">@s</MudSelectItem>
                }
            </MudSelect>
        </Filters>
    </DataToolbar>

    <MudDataGrid T="BoardReportListItemModel" Items="Filtered" Hover="true" Dense="true" Elevation="0"
                 SortMode="SortMode.Multiple">
        <Columns>
            <PropertyColumn Property="x => x.Period" Title="Periodo" />
            <PropertyColumn Property="x => x.GeneratedDate" Title="Generado" Format="dd/MM/yyyy" />
            <PropertyColumn Property="x => x.PageCount" Title="Páginas" />
            <TemplateColumn Title="Estado" SortBy="x => x.Status">
                <CellTemplate>
                    <StatusChip Status="@context.Item.Status" />
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Acción" CellClass="sigie-cell-end" HeaderClass="sigie-cell-end" Sortable="false">
                <CellTemplate>
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Visibility" Href="@($"/boardreport/{context.Item.Id}")">
                        Ver detalle
                    </MudButton>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <NoRecordsContent>
            <EmptyState Icon="@Icons.Material.Filled.SearchOff"
                        Title="Sin coincidencias"
                        Description="Ningún informe coincide con la búsqueda o el filtro de estado." />
        </NoRecordsContent>
    </MudDataGrid>
</SectionCard>

@code {
    private IReadOnlyList<BoardReportListItemModel> _reports = Array.Empty<BoardReportListItemModel>();
    private string _search = string.Empty;
    private string? _status;

    private string[] _statuses = Array.Empty<string>();

    protected override void OnInitialized()
    {
        _reports = BoardSvc.GetAll();
        _statuses = _reports.Select(r => r.Status).Distinct().OrderBy(s => s).ToArray();
    }

    private List<BoardReportListItemModel> Filtered => _reports.Where(Matches).ToList();

    private bool Matches(BoardReportListItemModel r)
    {
        if (!string.IsNullOrWhiteSpace(_status) && !string.Equals(r.Status, _status, StringComparison.OrdinalIgnoreCase))
            return false;

        if (string.IsNullOrWhiteSpace(_search)) return true;
        var q = _search.Trim();
        return r.Period.Contains(q, StringComparison.OrdinalIgnoreCase)
            || r.Status.Contains(q, StringComparison.OrdinalIgnoreCase);
    }

    private async Task ExportAsync()
    {
        var csv = CsvExport.Build(Filtered,
            ("Periodo", r => r.Period),
            ("Generado", r => r.GeneratedDate),
            ("Páginas", r => r.PageCount),
            ("Estado", r => r.Status));

        await JS.InvokeVoidAsync("sigieDownload", CsvExport.FileName("informes-junta"), csv);
    }
}
