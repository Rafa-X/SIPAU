@page "/error"
@using System.Diagnostics

<PageTitle>Error — SIPAU</PageTitle>

<PageHeader Title="No pudimos completar lo que pediste"
            Subtitle="Fue un error del sistema, no algo que hayas hecho" />

<SectionCard FullHeight="false">
    <EmptyState Icon="@Icons.Material.Filled.ReportProblem"
                Title="Vuelve a intentarlo en un momento"
                Description="@Advice">
        <MudButton Variant="Variant.Filled" Color="Color.Secondary" Href="/dashboard"
                   StartIcon="@Icons.Material.Filled.SpaceDashboard">
            Ir al Tablero de Control
        </MudButton>
    </EmptyState>
</SectionCard>

@code {
    // Reached via app.UseExceptionHandler("/error") when an unhandled exception occurs.
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? _folio;

    // The trace id goes in the message because it is what finds this error in the log.
    private string Advice => string.IsNullOrEmpty(_folio)
        ? "Si sigue pasando, avisa a Tecnologías."
        : $"Si sigue pasando, avisa a Tecnologías y menciona el folio {_folio}.";

    protected override void OnInitialized() =>
        _folio = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
