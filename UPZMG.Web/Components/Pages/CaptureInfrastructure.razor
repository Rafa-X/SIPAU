@page "/datacapture/infrastructure"
@attribute [Authorize]
@inject IDataCaptureService CaptureSvc
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<PageTitle>Captura de Infraestructura — SIGIE</PageTitle>

<PageHeader Title="Captura de Infraestructura" Subtitle="Espacios físicos e inventario TIC" BackHref="/datacapture" />

<MudPaper Elevation="1" Class="pa-6">
    <MudForm @ref="_form">
        <MudText Typo="Typo.h6" Class="mb-3">Espacio físico</MudText>
        <MudGrid>
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="_model.SpaceName" Label="Nombre del espacio"
                              Required="true" RequiredError="Requerido." />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudSelect T="string" @bind-Value="_model.UseType" Label="Tipo de uso">
                    @foreach (var u in CaptureSvc.SpaceUseTypes) { <MudSelectItem T="string" Value="@u">@u</MudSelectItem> }
                </MudSelect>
            </MudItem>

            <MudItem xs="12" md="6">
                <MudNumericField T="decimal" @bind-Value="_model.SquareMeters" Label="Metros cuadrados" Min="0" Format="0.##" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudNumericField T="int" @bind-Value="_model.Capacity" Label="Capacidad (personas)" Min="0" />
            </MudItem>

            <MudItem xs="12" md="6">
                <MudNumericField T="int" @bind-Value="_model.ComputersInOperation" Label="Computadoras en operación" Min="0" />
            </MudItem>

            <MudItem xs="12" md="4" Class="d-flex align-center">
                <MudSwitch T="bool" @bind-Value="_model.HasInternet" Color="Color.Secondary" Label="Cuenta con internet" />
            </MudItem>
            <MudItem xs="12" md="4" Class="d-flex align-center">
                <MudSwitch T="bool" @bind-Value="_model.HasComputerEquipment" Color="Color.Secondary" Label="Equipo de cómputo" />
            </MudItem>
            <MudItem xs="12" md="4" Class="d-flex align-center">
                <MudSwitch T="bool" @bind-Value="_model.IsAdapted" Color="Color.Secondary" Label="Adaptado (accesibilidad)" />
            </MudItem>
        </MudGrid>

        <MudStack Row="true" Spacing="2" Class="mt-6">
            <MudButton Variant="Variant.Filled" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Save" OnClick="Submit">Guardar espacio</MudButton>
            <MudButton Variant="Variant.Outlined" OnClick="@(() => Nav.NavigateTo("/datacapture"))">Cancelar</MudButton>
        </MudStack>
    </MudForm>
</MudPaper>

@code {
    private MudForm _form = null!;
    private InfrastructureFormViewModel _model = new();

    private async Task Submit()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid) return;
        Snackbar.Add($"Espacio físico '{_model.SpaceName}' guardado correctamente.", Severity.Success);
        Nav.NavigateTo("/datacapture");
    }
}
