@page "/reports"
@attribute [Authorize]
@using System.Text.Json
@using UPZMG.Implementations.Reports
@inject IReportsService ReportsSvc
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<PageTitle>Reportes 911 / SII — SIPAU</PageTitle>

<PageHeader Title="Reportes 911 / SII"
            Subtitle="Formatos estadísticos oficiales de la SEP y de la CGUTyP. Cada formato se captura por secciones; el sistema calcula los totales y revisa que las sumas cuadren antes de enviarlo.">
    <Actions>
        @* Authoring a format is an administrative act, so the door only exists
           for the role that can walk through it. *@
        <AuthorizeView Roles="Admin">
            <Authorized>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Tune" Href="/reports/plantillas">
                    Administrar plantillas
                </MudButton>
            </Authorized>
        </AuthorizeView>
    </Actions>
</PageHeader>

@if (_loading)
{
    <LoadingState Text="Cargando formatos y capturas…" />
}
else if (_failed)
{
    <SectionCard FullHeight="false">
        <EmptyState Title="No se pudieron cargar los formatos"
                    Description="El API no respondió. Verifica que esté corriendo y vuelve a intentarlo.">
            <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadAsync">Reintentar</MudButton>
        </EmptyState>
    </SectionCard>
}
else
{
    @if (_templates.Count == 0)
    {
        <SectionCard FullHeight="false" Class="mb-6">
            <EmptyState Title="No hay formatos disponibles"
                        Description="Agrega una plantilla JSON en la carpeta ReportTemplates del API para habilitar un formato oficial." />
        </SectionCard>
    }

    @foreach (var family in Families())
    {
        <SectionCard Title="@family.Title" Subtitle="@family.Subtitle" FullHeight="false" Flush="true" Class="mb-6">
            <ul class="sipau-format-list">
                @foreach (var template in family.Templates)
                {
                    var latest = LatestFor(template);
                    <li class="sipau-format-row @(template.IsValid ? null : "is-broken")">
                        <div>
                            <div class="sipau-format-name">@template.DisplayName</div>
                            <div class="sipau-format-meta">
                                @template.ReportType · versión @template.Version ·
                                @ReportUi.Plural(template.Sections, "sección", "secciones") ·
                                @ReportUi.Plural(template.Questions, "reactivo", "reactivos")
                            </div>
                        </div>

                        <div class="sipau-format-state">
                            @if (!template.IsValid)
                            {
                                <MudTooltip Placement="Placement.Top">
                                    <ChildContent>
                                        <span class="sipau-format-flag" tabindex="0">
                                            Plantilla con @ReportUi.Plural(template.Problems.Count, "error", "errores")
                                        </span>
                                    </ChildContent>
                                    <TooltipContent>
                                        @foreach (var problem in template.Problems.Take(5))
                                        {
                                            <div>@problem</div>
                                        }
                                    </TooltipContent>
                                </MudTooltip>
                            }
                            else if (latest is null)
                            {
                                <span>Sin capturas</span>
                            }
                            else
                            {
                                <span class="sipau-report-status is-compact @ReportUi.StatusClass(latest.Status)">@ReportUi.StatusLabel(latest.Status)</span>
                                <span>@(latest.Status == ReportStatus.draft ? "Editado" : "Enviado") el @ReportUi.Local(latest.LastModified)</span>
                            }
                        </div>

                        <div class="sipau-format-actions">
                            @if (template.IsValid && latest is { Status: ReportStatus.draft })
                            {
                                <MudButton Variant="Variant.Text" Color="Color.Primary" Href="@NewHref(template)">Nueva captura</MudButton>
                                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                           EndIcon="@Icons.Material.Filled.ArrowForward" Href="@($"/reports/{latest.Id}")">Continuar</MudButton>
                            }
                            else if (template.IsValid && latest is not null)
                            {
                                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Href="@($"/reports/{latest.Id}")">Ver envío</MudButton>
                                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                           StartIcon="@Icons.Material.Filled.Add" Href="@NewHref(template)">Nueva captura</MudButton>
                            }
                            else if (template.IsValid)
                            {
                                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                           StartIcon="@Icons.Material.Filled.Add" Href="@NewHref(template)">Iniciar captura</MudButton>
                            }
                        </div>
                    </li>
                }
            </ul>
        </SectionCard>
    }

    <SectionCard Title="Mis capturas" Subtitle="Borradores y formatos enviados con tu cuenta, del más reciente al más antiguo."
                 FullHeight="false" Flush="true">
        @if (_reports.Count == 0)
        {
            <EmptyState Title="Aún no has capturado formatos"
                        Description="Cuando guardes un borrador aparecerá aquí para que lo retomes." />
        }
        else
        {
            <MudDataGrid T="ReportListItem" Items="_reports" Hover="true" Dense="true" Elevation="0">
                <Columns>
                    <TemplateColumn Title="Formato" Sortable="false">
                        <CellTemplate>
                            <div class="sipau-format-name">@NameOf(context.Item)</div>
                            <div class="sipau-format-meta">@context.Item.ReportType · versión @context.Item.Version</div>
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="Estado" Sortable="false">
                        <CellTemplate>
                            <span class="sipau-report-status is-compact @ReportUi.StatusClass(context.Item.Status)">@ReportUi.StatusLabel(context.Item.Status)</span>
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="Última modificación" Sortable="false">
                        <CellTemplate>@ReportUi.Local(context.Item.LastModified)</CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="Acción" CellClass="sipau-cell-end" HeaderClass="sipau-cell-end" Sortable="false">
                        <CellTemplate>
                            <MudTooltip Text="Descargar en Excel" Placement="Placement.Top">
                                <MudIconButton Icon="@Icons.Material.Filled.GridOn" Size="Size.Small"
                                               aria-label="Descargar en Excel" OnClick="() => ExportAsync(context.Item)" />
                            </MudTooltip>
                            <MudTooltip Text="Ver, imprimir o guardar en PDF" Placement="Placement.Top">
                                <MudIconButton Icon="@Icons.Material.Filled.Print" Size="Size.Small"
                                               aria-label="Ver e imprimir" Href="@($"/reports/{context.Item.Id}/impresion")" />
                            </MudTooltip>
                            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary" Href="@($"/reports/{context.Item.Id}")">
                                @(context.Item.Status == ReportStatus.draft ? "Continuar" : "Consultar")
                            </MudButton>
                        </CellTemplate>
                    </TemplateColumn>
                </Columns>
            </MudDataGrid>
        }
    </SectionCard>
}

@code {
    private IReadOnlyList<ReportTemplateItem> _templates = [];
    private IReadOnlyList<ReportListItem> _reports = [];
    private bool _loading = true;
    private bool _failed;

    private sealed record Family(string Title, string Subtitle, IReadOnlyList<ReportTemplateItem> Templates);

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _failed = false;
        try
        {
            _templates = await ReportsSvc.GetTemplatesAsync();
            _reports = await ReportsSvc.GetMyReportsAsync();
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException or JsonException)
        {
            _failed = true;
        }
        finally
        {
            _loading = false;
        }
    }

    // Grouped by issuing body, which is how Planeación refers to the formats.
    private IEnumerable<Family> Families()
    {
        var sii = _templates.Where(t => t.ReportType.StartsWith("SII", StringComparison.OrdinalIgnoreCase)).ToList();
        var sep = _templates.Except(sii).Where(t => t.ReportType.Contains("911", StringComparison.Ordinal)).ToList();
        var other = _templates.Except(sii).Except(sep).ToList();

        if (sii.Count > 0) yield return new Family("Formato SII", "Coordinación General de Universidades Tecnológicas y Politécnicas (CGUTyP)", sii);
        if (sep.Count > 0) yield return new Family("Estadística 911", "Cuestionarios de estadística educativa de la SEP", sep);
        if (other.Count > 0) yield return new Family("Otros formatos", "Anexos y formatos complementarios", other);
    }

    private ReportListItem? LatestFor(ReportTemplateItem template) =>
        _reports.FirstOrDefault(r =>
            r.ReportType.Equals(template.ReportType, StringComparison.OrdinalIgnoreCase) &&
            r.Version.Equals(template.Version, StringComparison.OrdinalIgnoreCase));

    private string NameOf(ReportListItem report) =>
        _templates.FirstOrDefault(t => t.ReportType.Equals(report.ReportType, StringComparison.OrdinalIgnoreCase))?.DisplayName
        ?? report.ReportType;

    /// <summary>Exports a capture from the list without opening it.</summary>
    private async Task ExportAsync(ReportListItem report)
    {
        var detail = await ReportsSvc.GetReportAsync(report.Id);
        var template = detail is null ? null : await ReportsSvc.GetTemplateAsync(detail.ReportType, detail.Version);

        if (detail is null || template is null)
        {
            Snackbar.Add("No se pudo preparar el archivo: falta la captura o su plantilla.", Severity.Error);
            return;
        }

        await JS.InvokeVoidAsync("sigieDownloadBytes",
            XlsxExport.FileName(template.ReportType),
            Convert.ToBase64String(ReportExport.ToWorkbook(new ReportFormState(template, detail.Answers))),
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");

        Snackbar.Add("Se generó el archivo de Excel.", Severity.Success);
    }

    private static string NewHref(ReportTemplateItem template) =>
        $"/reports/new/{Uri.EscapeDataString(template.ReportType)}/{Uri.EscapeDataString(template.Version)}";
}
