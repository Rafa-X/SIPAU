@page "/datacapture/teachers"
@attribute [Authorize]
@inject IDataCaptureService CaptureSvc
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<PageTitle>Captura de Docentes — SIGIE</PageTitle>

<PageHeader Eyebrow="Captura de datos" Title="Captura de Docentes / RRHH" Subtitle="Registro de personal docente y administrativo" BackHref="/datacapture" />

<MudPaper Elevation="1" Class="pa-6">
    <MudForm @ref="_form">
        <MudText Typo="Typo.h6" Class="mb-3">Datos del empleado</MudText>
        <MudGrid>
            <MudItem xs="12" md="4">
                <MudTextField @bind-Value="_model.EmployeeNumber" Label="Número de empleado"
                              Required="true" RequiredError="Requerido." />
            </MudItem>
            <MudItem xs="12" md="4">
                <MudTextField @bind-Value="_model.Rfc" Label="RFC" />
            </MudItem>
            <MudItem xs="12" md="4">
                <MudTextField @bind-Value="_model.Curp" Label="CURP" />
            </MudItem>

            <MudItem xs="12" md="4">
                <MudTextField @bind-Value="_model.FirstName" Label="Nombre(s)" Required="true" RequiredError="Requerido." />
            </MudItem>
            <MudItem xs="12" md="4">
                <MudTextField @bind-Value="_model.LastName" Label="Apellido paterno" Required="true" RequiredError="Requerido." />
            </MudItem>
            <MudItem xs="12" md="4">
                <MudTextField @bind-Value="_model.MiddleName" Label="Apellido materno" />
            </MudItem>

            <MudItem xs="12" md="4">
                <MudSelect T="string" @bind-Value="_model.Gender" Label="Sexo">
                    @foreach (var g in CaptureSvc.Genders) { <MudSelectItem T="string" Value="@g">@g</MudSelectItem> }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="4">
                <MudDatePicker @bind-Date="_model.BirthDate" Label="Fecha de nacimiento" MaxDate="DateTime.Today" />
            </MudItem>
            <MudItem xs="12" md="4">
                <MudSelect T="int" @bind-Value="_model.AreaId" Label="Área de adscripción">
                    @foreach (var a in CaptureSvc.InternalAreas) { <MudSelectItem T="int" Value="@int.Parse(a.Value)">@a.Text</MudSelectItem> }
                </MudSelect>
            </MudItem>

            <MudItem xs="12" md="4">
                <MudSelect T="string" @bind-Value="_model.MaxDegree" Label="Grado máximo de estudios">
                    @foreach (var d in CaptureSvc.MaxDegrees) { <MudSelectItem T="string" Value="@d">@d</MudSelectItem> }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="4">
                <MudSelect T="string" @bind-Value="_model.ContractType" Label="Tipo de contrato">
                    @foreach (var c in CaptureSvc.ContractTypes) { <MudSelectItem T="string" Value="@c">@c</MudSelectItem> }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="4">
                <MudNumericField T="int" @bind-Value="_model.WeeklyHours" Label="Horas semanales" Min="0" Max="48" />
            </MudItem>

            <MudItem xs="12" Class="d-flex align-center">
                <MudSwitch T="bool" @bind-Value="_model.HasPostgraduate" Color="Color.Secondary" Label="Cuenta con posgrado" />
            </MudItem>
        </MudGrid>

        <MudStack Row="true" Spacing="2" Class="mt-6">
            <MudButton Variant="Variant.Filled" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Save" OnClick="Submit">Guardar docente</MudButton>
            <MudButton Variant="Variant.Outlined" OnClick="@(() => Nav.NavigateTo("/datacapture"))">Cancelar</MudButton>
        </MudStack>
    </MudForm>
</MudPaper>

@code {
    private MudForm _form = null!;
    private TeacherFormViewModel _model = new();

    private async Task Submit()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid) return;
        Snackbar.Add($"Docente {_model.FirstName} {_model.LastName} guardado correctamente.", Severity.Success);
        Nav.NavigateTo("/datacapture");
    }
}
