@page "/users"
@attribute [Authorize(Roles = "Admin")]
@inject IUsersService UsersSvc
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthState

<PageTitle>Usuarios y Roles — SIGIE</PageTitle>

<PageHeader Eyebrow="Administración" Title="Usuarios y Roles" Subtitle="Alta de usuarios y asignación de rol de acceso">
    <Actions>
        <MudButton Variant="Variant.Filled" Color="Color.Secondary"
                   StartIcon="@Icons.Material.Filled.PersonAdd" OnClick="OpenCreate">
            Nuevo usuario
        </MudButton>
    </Actions>
</PageHeader>

<SectionCard Flush="true" FullHeight="false">
    <DataToolbar @bind-Search="_search" Placeholder="Buscar usuario, correo o rol…"
                 Count="Filtered.Count" Total="_users.Count" OnExport="ExportAsync">
        <Filters>
            @* The API's users/get-all filters `where su.IsActive`, so an
               "inactive" option here could never match anything. Filtering by
               role is what actually helps on this screen. *@
            <MudSelect T="string" Value="_roleFilter" ValueChanged="@(v => _roleFilter = v)" Dense="true"
                       Variant="Variant.Outlined" Margin="Margin.Dense" Class="sigie-toolbar-filter mt-0"
                       Placeholder="Rol" Clearable="true">
                <MudSelectItem T="string" Value="@(null!)">Todos los roles</MudSelectItem>
                @foreach (var role in _roles)
                {
                    <MudSelectItem T="string" Value="@role.Name">@role.Name</MudSelectItem>
                }
            </MudSelect>
        </Filters>
    </DataToolbar>

    <MudDataGrid T="UserListModel" Items="Filtered" Hover="true" Dense="true" Elevation="0"
                 Filterable="false" SortMode="SortMode.Multiple">
        <Columns>
            <TemplateColumn Title="Usuario" SortBy="x => x.UserName">
                <CellTemplate>
                    <div>
                        <MudText Typo="Typo.body2" Style="font-weight:600">@context.Item.UserName</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@context.Item.Email</MudText>
                    </div>
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Rol" SortBy="x => x.RoleName">
                <CellTemplate>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Secondary">@context.Item.RoleName</MudChip>
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Estado" SortBy="x => x.IsActive">
                <CellTemplate>
                    @if (context.Item.IsActive)
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Success"
                                 Icon="@Icons.Material.Filled.CheckCircle">Activo</MudChip>
                    }
                    else
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Error"
                                 Icon="@Icons.Material.Filled.Cancel">Inactivo</MudChip>
                    }
                </CellTemplate>
            </TemplateColumn>
            <PropertyColumn Property="x => x.LastLogin" Title="Último acceso" Format="dd/MM/yyyy HH:mm" />
            <TemplateColumn Title="Acción" CellClass="d-flex justify-end" Sortable="false">
                <CellTemplate>
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Edit" OnClick="() => OpenEdit(context.Item)">
                        Editar
                    </MudButton>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <NoRecordsContent>
            @if (_users.Count == 0)
            {
                <EmptyState Icon="@Icons.Material.Filled.CloudOff"
                            Title="Sin catálogo de usuarios"
                            Description="No se recibieron usuarios de la API. Verifica que UPZMG.API esté corriendo y que la base de datos tenga los datos de prueba cargados." />
            }
            else
            {
                <EmptyState Icon="@Icons.Material.Filled.PersonSearch"
                            Title="Sin coincidencias"
                            Description="Ningún usuario coincide con la búsqueda o el filtro de rol." />
            }
        </NoRecordsContent>
    </MudDataGrid>
</SectionCard>

@code {
    private IReadOnlyList<UserListModel> _users = Array.Empty<UserListModel>();
    private IReadOnlyList<Role> _roles = Array.Empty<Role>();
    private string _search = string.Empty;
    private string? _roleFilter;

    /// <summary>The signed-in user; every API call is authorised against it.</summary>
    private Guid _requesterKey = Guid.Empty;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        _requesterKey = Guid.TryParse(state.User.FindFirst(ClaimTypes.NameIdentifier)?.Value, out var id)
            ? id : Guid.Empty;

        _roles = await UsersSvc.GetRolesAsync(_requesterKey);
        await ReloadAsync();
    }

    private async Task ReloadAsync() => _users = await UsersSvc.GetUsersAsync(_requesterKey);

    private List<UserListModel> Filtered => _users.Where(Matches).ToList();

    private bool Matches(UserListModel user)
    {
        if (!string.IsNullOrWhiteSpace(_roleFilter) &&
            !string.Equals(user.RoleName, _roleFilter, StringComparison.OrdinalIgnoreCase))
            return false;

        if (string.IsNullOrWhiteSpace(_search)) return true;
        var s = _search.Trim();
        return user.UserName.Contains(s, StringComparison.OrdinalIgnoreCase)
            || user.Email.Contains(s, StringComparison.OrdinalIgnoreCase)
            || user.RoleName.Contains(s, StringComparison.OrdinalIgnoreCase);
    }

    private async Task ExportAsync()
    {
        var csv = CsvExport.Build(Filtered,
            ("Nombre", u => u.UserName),
            ("Correo", u => u.Email),
            ("Rol", u => u.RoleName),
            ("Activo", u => u.IsActive),
            ("Último acceso", u => u.LastLogin));

        await JS.InvokeVoidAsync("sigieDownload", CsvExport.FileName("usuarios"), csv);
    }

    private Task OpenCreate() => ShowDialog("Nuevo Usuario", new UserFormViewModel(), created: true);

    private Task OpenEdit(UserListModel user) => ShowDialog("Editar Usuario", new UserFormViewModel
    {
        Id = user.Id,
        UserName = user.UserName,
        Email = user.Email,
        // The form binds the role by id; the listing only carries its name.
        RoleId = _roles.FirstOrDefault(r => r.Name == user.RoleName)?.Id.ToString() ?? string.Empty,
        IsActive = user.IsActive,
    }, created: false);

    private async Task ShowDialog(string title, UserFormViewModel model, bool created)
    {
        if (_roles.Count == 0)
        {
            Snackbar.Add("No hay roles disponibles. Verifica que la API esté corriendo.", Severity.Warning);
            return;
        }

        var parameters = new DialogParameters<UserDialog>
        {
            { x => x.Model, model },
            { x => x.Roles, _roles },
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true, CloseButton = true };

        var dialog = await DialogService.ShowAsync<UserDialog>(title, parameters, options);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled && result.Data is UserFormViewModel saved)
        {
            // Catch the duplicate before the round-trip: the email is the sign-in
            // identity and the API does not reject a repeat on its own.
            var clash = _users.FirstOrDefault(u =>
                u.Id != saved.Id && string.Equals(u.Email, saved.Email?.Trim(), StringComparison.OrdinalIgnoreCase));

            if (clash is not null)
            {
                Snackbar.Add($"Ya existe un usuario con el correo '{saved.Email}' ({clash.UserName}).", Severity.Error);
                return;
            }

            var outcome = await UsersSvc.SaveAsync(_requesterKey, saved);

            if (!outcome.Success)
            {
                Snackbar.Add(outcome.Error ?? "No se pudo guardar el usuario.", Severity.Error);
                return;
            }

            await ReloadAsync();
            Snackbar.Add(created
                ? $"Usuario '{saved.Email}' creado correctamente."
                : $"Usuario '{saved.Email}' actualizado correctamente.", Severity.Success);
        }
    }
}
