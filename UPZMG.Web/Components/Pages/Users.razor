@page "/users"
@attribute [Authorize(Policy = AppPermissions.ManageUsers)]
@using UPZMG.Implementations
@using UPZMG.Implementations.Users
@inject UsersService _userService
@inject ISecurityService _securityService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<PageTitle>Usuarios y Roles — SIPAU</PageTitle>

<PageHeader Eyebrow="Administración" Title="Usuarios y Roles" Subtitle="Alta de usuarios y asignación de rol de acceso">
    <Actions>
        <MudButton Variant="Variant.Filled" Color="Color.Secondary"
                   StartIcon="@Icons.Material.Filled.PersonAdd" OnClick="OpenCreate">
            Nuevo usuario
        </MudButton>
    </Actions>
</PageHeader>

<SectionCard Flush="true" FullHeight="false">
    @if (_isLoading)
    {
        <LoadingState Text="Cargando usuarios…" />
    }
    else
    {
    <DataToolbar @bind-Search="_search" Placeholder="Buscar usuario, correo o rol…"
                 Count="UsersFiltered.Count" Total="_users.Count">
        <Filters>
            <MudSelect T="string" Value="_roleFilter" ValueChanged="@(v => _roleFilter = v)" Dense="true"
                       Variant="Variant.Outlined" Margin="Margin.Dense" Class="sipau-toolbar-filter mt-0"
                       Placeholder="Rol" Clearable="true">
                <MudSelectItem T="string" Value="@(null!)">Todos los roles</MudSelectItem>
                @foreach (var role in _roles)
                {
                    <MudSelectItem T="string" Value="@role.Name">@role.Name</MudSelectItem>
                }
            </MudSelect>
        </Filters>
    </DataToolbar>

    @* Bound to the filtered list: bound to the full one, the search box and the role filter
       were there and did nothing. *@
    <MudDataGrid T="SystemUser" Items="UsersFiltered" Hover="true" Dense="true" Elevation="0"
                 Filterable="false" SortMode="SortMode.Multiple">
        <Columns>
            <TemplateColumn Title="Usuario" SortBy="x => x.UserName">
                <CellTemplate>
                    <div>
                        <MudText Typo="Typo.body2" Style="font-weight:600">@context.Item.UserName</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@context.Item.Email</MudText>
                    </div>
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Rol" SortBy="@(x => x.Role?.Name ?? string.Empty)">
                <CellTemplate>
                    @if (!string.IsNullOrWhiteSpace(context.Item.Role?.Name))
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Secondary">@context.Item.Role.Name</MudChip>
                    }
                    else
                    {
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Sin rol</MudText>
                    }
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Estado" SortBy="x => x.IsActive">
                <CellTemplate>
                    @if (context.Item.IsActive)
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Success"
                                 Icon="@Icons.Material.Filled.CheckCircle">Activo</MudChip>
                    }
                    else
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Error"
                                 Icon="@Icons.Material.Filled.Cancel">Inactivo</MudChip>
                    }
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Último acceso" SortBy="x => x.LastLogin ?? DateTime.MinValue">
                <CellTemplate>
                    @if (context.Item.LastLogin is { } seen)
                    {
                        @* Stored in UTC; shown in the reader's hour. *@
                        @DateTime.SpecifyKind(seen, DateTimeKind.Utc).ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                    }
                    else
                    {
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Nunca</MudText>
                    }
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Acción" CellClass="sipau-cell-end" HeaderClass="sipau-cell-end" Sortable="false">
                <CellTemplate>
                    <MudStack Row="true" Spacing="1" Justify="Justify.FlexEnd">
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Edit" OnClick="() => OpenEdit(context.Item)">
                            Editar
                        </MudButton>
                        @if (context.Item.IsActive)
                        {
                            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error"
                                       StartIcon="@Icons.Material.Filled.PersonOff"
                                       OnClick="() => SetActiveAsync(context.Item, false)">
                                Dar de baja
                            </MudButton>
                        }
                        else
                        {
                            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Success"
                                       StartIcon="@Icons.Material.Filled.PersonAdd"
                                       OnClick="() => SetActiveAsync(context.Item, true)">
                                Reactivar
                            </MudButton>
                        }
                    </MudStack>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <NoRecordsContent>
            @if (_users.Count == 0)
            {
                <EmptyState Icon="@Icons.Material.Filled.CloudOff"
                            Title="Sin catálogo de usuarios"
                            Description="No se recibieron usuarios de la API. Verifica que UPZMG.API esté corriendo y que la base de datos tenga los datos de prueba cargados." />
            }
            else
            {
                <EmptyState Icon="@Icons.Material.Filled.PersonSearch"
                            Title="Sin coincidencias"
                            Description="Ningún usuario coincide con la búsqueda o el filtro de rol." />
            }
        </NoRecordsContent>
    </MudDataGrid>
    }
</SectionCard>

@code {
    private IReadOnlyList<SystemUser> _users = Array.Empty<SystemUser>();
    private IReadOnlyList<Role> _roles = Array.Empty<Role>();
    private string _search = string.Empty;
    private string? _roleFilter;
    private bool _isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        var requesterKey = await _securityService.GetRequesterKeyAsync();
        if (requesterKey == Guid.Empty)
        {
            Snackbar.Add("No se pudo identificar al usuario actual.", Severity.Error);
            _isLoading = false;
            return;
        }

        try
        {
            _roles = await _securityService.GetAllRoles(new GetAllRoles { RequesterKey = requesterKey });
            await ReloadAsync(requesterKey);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task ReloadAsync(Guid requesterKey) =>
        _users = await _userService.GetAllUsers(new GetAllUsers { RequesterKey = requesterKey });

    private bool Matches(SystemUser user)
    {
        if (!string.IsNullOrWhiteSpace(_roleFilter) &&
            !string.Equals(user.Role?.Name, _roleFilter, StringComparison.OrdinalIgnoreCase))
            return false;

        if (string.IsNullOrWhiteSpace(_search)) return true;
        var s = _search.Trim();
        return user.UserName.Contains(s, StringComparison.OrdinalIgnoreCase)
            || user.Email.Contains(s, StringComparison.OrdinalIgnoreCase)
            || (user.Role?.Name?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false);
    }
    private List<SystemUser> UsersFiltered => _users.Where(Matches).ToList();
    
    /// <summary>
    /// Suspending is the reversible alternative to deleting: the person stops being able to sign
    /// in, and everything they captured stays attributed to them. Asking first, because the
    /// affected person is locked out the moment it is confirmed.
    /// </summary>
    private async Task SetActiveAsync(SystemUser user, bool isActive)
    {
        if (isActive)
        {
            var confirmed = await DialogService.ShowMessageBoxAsync(
                "Reactivar usuario",
                $"«{user.UserName}» volverá a poder iniciar sesión.",
                yesText: "Reactivar", cancelText: "Cancelar");
            if (confirmed != true) return;
        }
        else
        {
            var confirmed = await DialogService.ShowMessageBoxAsync(
                "Dar de baja al usuario",
                $"«{user.UserName}» dejará de poder iniciar sesión. Lo que capturó se conserva y la baja se puede revertir.",
                yesText: "Dar de baja", cancelText: "Cancelar");
            if (confirmed != true) return;
        }

        var requesterKey = await _securityService.GetRequesterKeyAsync();
        var result = await _userService.SetActiveAsync(requesterKey, user.Id, isActive);

        if (!result.Success)
        {
            Snackbar.Add(result.Error ?? "No fue posible cambiar el estatus del usuario.", Severity.Error);
            return;
        }

        await ReloadAsync(requesterKey);
        Snackbar.Add(isActive
            ? $"«{user.UserName}» quedó reactivado."
            : $"«{user.UserName}» quedó dado de baja.", Severity.Success);
    }

    private Task OpenCreate() => ShowDialog("Nuevo Usuario", new UserFormViewModel(), created: true);

    private Task OpenEdit(SystemUser user) => ShowDialog("Editar Usuario", new UserFormViewModel
    {
        Id = user.Id,
        UserName = user.UserName,
        Email = user.Email,
        RoleId = user.Role?.Id.ToString() ?? string.Empty,
        IsActive = user.IsActive,
    }, created: false);

    private async Task ShowDialog(string title, UserFormViewModel model, bool created)
    {
        if (_roles.Count == 0)
        {
            Snackbar.Add("No hay roles disponibles.", Severity.Warning);
            return;
        }

        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true };
        var pending = model;
        string? error = null;

        // The dialog closes before the save is attempted, so a refusal used to leave the
        // administrator with a snackbar and an empty form: everything typed, password included,
        // had to be entered again. It is reopened with the same values and the reason instead.
        while (true)
        {
            var parameters = new DialogParameters<UserDialog>
            {
                { x => x.Model, pending },
                { x => x.Roles, _roles },
                { x => x.Error, error },
            };

            var dialog = await DialogService.ShowAsync<UserDialog>(title, parameters, options);
            var result = await dialog.Result;

            if (result is null || result.Canceled || result.Data is not UserFormViewModel saved) return;

            var requesterKey = await _securityService.GetRequesterKeyAsync();
            if (requesterKey == Guid.Empty) return;

            // The service answers with the reason instead of throwing. This loop used to wait
            // for an exception that never came, so a refused change was announced as saved.
            var outcome = await _userService.SaveAsync(requesterKey, saved);
            if (!outcome.Success)
            {
                pending = saved;
                error = outcome.Error;
                continue;
            }

            await ReloadAsync(requesterKey);

            Snackbar.Add(created
                ? $"Usuario '{saved.Email}' creado correctamente."
                : $"Usuario '{saved.Email}' actualizado correctamente.", Severity.Success);
            return;
        }
    }
}
