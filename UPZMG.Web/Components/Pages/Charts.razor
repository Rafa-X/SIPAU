@page "/charts"
@attribute [Authorize]
@inject IIntelligenceService Ai

<PageTitle>Gráficas — SIGIE</PageTitle>

<PageHeader Eyebrow="Analítica"
            Title="Gráficas"
            Subtitle="Visualización estadística institucional con proyección de tendencias">
    <Actions>
        <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Tertiary"
                 Icon="@Icons.Material.Filled.Functions">Mínimos cuadrados</MudChip>
    </Actions>
</PageHeader>

<MudGrid>
    <MudItem xs="12" lg="6">
        <MudPaper Elevation="0" Class="pa-5" Style="height:100%">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start" Class="mb-2" Wrap="Wrap.Wrap">
                <div>
                    <MudText Typo="Typo.h6">Matrícula histórica y proyección</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        Pronóstico por regresión lineal · los últimos @_forecastAhead periodos son proyección
                    </MudText>
                </div>
                <MudChip T="string" Size="Size.Small" Color="Color.Tertiary" Variant="Variant.Text"
                         Icon="@Icons.Material.Filled.AutoGraph">R² @_fc.R2.ToString("0.00")</MudChip>
            </MudStack>

            <MudChart T="double" ChartType="ChartType.Line" ChartSeries="@_enrollment" ChartLabels="@_fc.Labels"
                      Width="100%" Height="320px" ChartOptions="@_lineOptions" />

            <MudDivider Class="my-3" />
            <MudText Typo="Typo.caption" Color="Color.Secondary">
                Pendiente estimada: <b>@_fc.Slope.ToString("0.0")</b> alumnos por periodo ·
                ordenada al origen <b>@_fc.Intercept.ToString("0.0")</b>
            </MudText>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" lg="6">
        <MudPaper Elevation="0" Class="pa-5" Style="height:100%">
            <MudText Typo="Typo.h6">Distribución de alumnos por carrera</MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary">Matrícula del periodo activo por programa educativo</MudText>

            <MudChart T="double" ChartType="ChartType.Bar" ChartSeries="@_careers" ChartLabels="@_careerLabels"
                      Width="100%" Height="320px" ChartOptions="@_cyanBar" />

            <MudDivider Class="my-3" />
            <MudText Typo="Typo.caption" Color="Color.Secondary">
                Programa con mayor matrícula: <b>@_topCareer</b>
            </MudText>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" lg="6">
        <MudPaper Elevation="0" Class="pa-5" Style="height:100%">
            <MudText Typo="Typo.h6">Aprobación vs. reprobación por periodo</MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary">Índices institucionales de aprovechamiento</MudText>

            <MudChart T="double" ChartType="ChartType.Bar" ChartSeries="@_achievement" ChartLabels="@_achievementLabels"
                      Width="100%" Height="320px" ChartOptions="@_abBar" />

            <MudDivider Class="my-3" />
            <MudText Typo="Typo.caption" Color="Color.Secondary">
                La reprobación acumula cuatro periodos a la baja.
            </MudText>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" lg="6">
        <MudPaper Elevation="0" Class="pa-5" Style="height:100%">
            <MudText Typo="Typo.h6">Becas asignadas por tipo / fuente</MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary">Distribución de becas vigentes por fuente de financiamiento</MudText>

            <MudChart T="double" ChartType="ChartType.Bar" ChartSeries="@_scholarships" ChartLabels="@_scholarshipLabels"
                      Width="100%" Height="320px" ChartOptions="@_goldBar" />

            <MudDivider Class="my-3" />
            <MudText Typo="Typo.caption" Color="Color.Secondary">
                Total de becas vigentes: <b>@_totalScholarships.ToString("N0")</b>
            </MudText>
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    // Palettes mirror the theme accents: cyan = observed, indigo = model,
    // gold = funding, rose = negative indicators.
    private readonly ChartOptions _lineOptions = new() { ChartPalette = new[] { "#22D3BF", "#6D5CE7" } };
    private readonly ChartOptions _cyanBar     = new() { ChartPalette = new[] { "#0FB5A0" } };
    private readonly ChartOptions _goldBar     = new() { ChartPalette = new[] { "#D4A02C" } };
    private readonly ChartOptions _abBar       = new() { ChartPalette = new[] { "#0FB5A0", "#E5484D" } };

    // Matrícula: pronóstico real por regresión lineal (mínimos cuadrados en C#)
    private const int _forecastAhead = 2;
    private EnrollmentForecast _fc = null!;
    private List<ChartSeries<double>> _enrollment = new();

    protected override void OnInitialized()
    {
        _fc = Ai.ForecastEnrollment(_forecastAhead);
        _enrollment = new()
        {
            new ChartSeries<double> { Name = "Matrícula (real + pronóstico)", Data = _fc.Actual },
            new ChartSeries<double> { Name = "Tendencia", Data = _fc.Trend },
        };
    }

    private readonly string[] _careerLabels = { "Sistemas", "Industrial", "Biotecnología", "Admón." };
    private readonly List<ChartSeries<double>> _careers = new()
    {
        new ChartSeries<double> { Name = "Alumnos", Data = new double[] { 420, 355, 210, 260 } },
    };
    private string _topCareer => _careerLabels[
        _careers[0].Data.Select((value, index) => (value, index)).OrderByDescending(t => t.value).First().index];

    private readonly string[] _achievementLabels = { "2024-1", "2024-2", "2025-1", "2025-2" };
    private readonly List<ChartSeries<double>> _achievement = new()
    {
        new ChartSeries<double> { Name = "Aprobación %", Data = new double[] { 84.2, 85.6, 86.9, 87.5 } },
        new ChartSeries<double> { Name = "Reprobación %", Data = new double[] { 15.8, 14.4, 13.1, 12.5 } },
    };

    private readonly string[] _scholarshipLabels = { "Excelencia", "Manutención", "Deportiva", "Federal" };
    private readonly List<ChartSeries<double>> _scholarships = new()
    {
        new ChartSeries<double> { Name = "Becas", Data = new double[] { 180, 260, 65, 340 } },
    };
    private double _totalScholarships => _scholarships[0].Data.Sum();
}
