@page "/charts"
@attribute [Authorize]
@using UPZMG.Web.Models.Charts
@inject IIntelligenceService Ai
@inject IChartsService _chartsService

<PageTitle>Gráficas — SIPAU</PageTitle>

<PageHeader Eyebrow="Analítica" Title="Gráficas">
</PageHeader>

<MudGrid>
    <MudItem xs="12" lg="7">
        <SectionCard Title="Matrícula histórica y proyección"
                     Icon="@Icons.Material.Filled.Timeline" Accent="violet">
            <Actions>
                <MudTooltip Text="Descargar gráfica PNG" Placement="Placement.Top">
                    <MudIconButton Icon="@Icons.Material.Filled.FileDownload"
                                   Color="Color.Secondary"
                                   Size="Size.Small"
                                   data-sipau-chart-download="enrollment-chart"
                                   data-sipau-chart-title="Matrícula histórica y proyección"
                                   data-sipau-chart-filename="Matricula-historica.png" />
                </MudTooltip>
            </Actions>
            <ChildContent>
                <TrendChart Id="enrollment-chart" Labels="_model.Enrollment.Labels" Series="_model.Enrollment.Series" Height="160"
                            ForecastFromIndex="_model.Enrollment.ForecastFromIndex"
                            AriaLabel="Matrícula histórica y su proyección" />
            </ChildContent>
            <Footer>
                    Pendiente estimada: <b>@_model.Enrollment.Slope.ToString("0.0")</b> alumnos por periodo ·
                ordenada al origen <b>@_model.Enrollment.Intercept.ToString("0.0")</b>
            </Footer>
        </SectionCard>
    </MudItem>

    <MudItem xs="12" lg="5">
        <SectionCard Title="Distribución por carrera"
                     Icon="@Icons.Material.Filled.School" Accent="teal">
            <Actions>
                <MudTooltip Text="Descargar gráfica PNG" Placement="Placement.Top">
                    <MudIconButton Icon="@Icons.Material.Filled.FileDownload"
                                   Color="Color.Secondary"
                                   Size="Size.Small"
                                   data-sipau-chart-download="career-chart"
                                   data-sipau-chart-title="Distribución por carrera"
                                   data-sipau-chart-filename="Distribucion-por-carrera.png" />
                </MudTooltip>
            </Actions>
            <ChildContent>
                <BarChart Id="career-chart" Labels="_model.CareerDistribution.Labels" Series="_model.CareerDistribution.Series" Height="160"
                          AriaLabel="Alumnos por carrera" />
            </ChildContent>
            <Footer>
                Programa con mayor matrícula: <b>@_model.CareerDistribution.TopLabel</b> · total <b>@_model.CareerDistribution.Total.ToString("N0")</b> alumnos
            </Footer>
        </SectionCard>
    </MudItem>
</MudGrid>

<MudText Typo="Typo.h5" Class="mt-8 mb-3">Módulos de analítica</MudText>
<MudGrid>
    <MudItem xs="12" sm="6">
        <MudCard Elevation="1" Class="d-flex flex-column" Style="height:100%">
            <MudCardContent Class="flex-grow-1">
                <MudAvatar Color="Color.Secondary" Variant="Variant.Filled" Rounded="true" Class="mb-3">
                    <MudIcon Icon="@Icons.Material.Filled.School" />
                </MudAvatar>
                <MudText Typo="Typo.h6">Alumnos</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    Analiza la edad de los alumnos de nuevo ingreso y de toda la matrícula institucional.
                </MudText>
            </MudCardContent>
            <MudCardActions>
                <MudButton Variant="Variant.Filled" Color="Color.Secondary" FullWidth="true"
                           StartIcon="@Icons.Material.Filled.ArrowForward" Href="/charts/students">
                    Ver gráficas de alumnos
                </MudButton>
            </MudCardActions>
        </MudCard>
    </MudItem>

    <MudItem xs="12" sm="6">
        <MudCard Elevation="1" Class="d-flex flex-column" Style="height:100%">
            <MudCardContent Class="flex-grow-1">
                <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Rounded="true" Class="mb-3">
                    <MudIcon Icon="@Icons.Material.Filled.Groups" />
                </MudAvatar>
                <MudText Typo="Typo.h6">Docentes</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    Consulta la distribución del personal docente por nivel académico y experiencia.
                </MudText>
            </MudCardContent>
            <MudCardActions>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                           StartIcon="@Icons.Material.Filled.ArrowForward" Href="/charts/teachers">
                    Ver gráficas de docentes
                </MudButton>
            </MudCardActions>
        </MudCard>
    </MudItem>
</MudGrid>

@code {
    private const int ForecastAhead = 2;
    private ChartsPageViewModel _model = new();

    protected override async Task OnInitializedAsync()
    {
        var forecast = Ai.ForecastEnrollment(ForecastAhead);
        var careers = await _chartsService.GetCareersDistributionAsync();

        _model.Enrollment.Labels = forecast.Labels;
        _model.Enrollment.Series =
        [
            new ChartSeriesData("Matrícula", forecast.Actual, ChartPalette.Teal, Filled: true),
            new ChartSeriesData("Tendencia del modelo", forecast.Trend, ChartPalette.Indigo, Dashed: true),
        ];
        _model.Enrollment.ForecastFromIndex = forecast.HistoricalCount;
        _model.Enrollment.Slope = forecast.Slope;
        _model.Enrollment.Intercept = forecast.Intercept;

        _model.CareerDistribution.Labels = careers.Select(career => career.Label).ToList();
        _model.CareerDistribution.Series =
        [
            new ChartSeriesData(
                "Alumnos",
                careers.Select(career => (double)career.Value).ToList(),
                ChartPalette.Teal),
        ];

        _model.CareerDistribution.Total = careers.Select(career => (double)career.Value).Sum();
        _model.CareerDistribution.TopLabel = careers.Count == 0
            ? "Sin datos"
            : careers.MaxBy(career => career.Value)?.Label ?? "Sin datos";
    }
}
