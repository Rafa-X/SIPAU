@page "/charts"
@attribute [Authorize]
@using UPZMG.Web.Models.Charts
@using UPZMG.Implementations.Intelligence
@using UPZMG.Implementations.Charts
@inject IIntelligenceService Ai
@inject IChartsService _chartsService

<PageTitle>Gráficas — SIPAU</PageTitle>

<PageHeader Eyebrow="Analítica" Title="Gráficas">
</PageHeader>

<MudGrid>
    <MudItem xs="12" lg="7">
        <SectionCard Title="Matrícula histórica y proyección"
                     Icon="@Icons.Material.Filled.Timeline" Accent="violet">
            <Actions>
                <MudTooltip Text="Descargar gráfica PNG" Placement="Placement.Top">
                    <MudIconButton Icon="@Icons.Material.Filled.FileDownload"
                                   Color="Color.Secondary"
                                   Size="Size.Small"
                                   data-sipau-chart-download="enrollment-chart"
                                   data-sipau-chart-title="Matrícula histórica y proyección"
                                   data-sipau-chart-filename="Matricula-historica.png" />
                </MudTooltip>
            </Actions>
            <ChildContent>
                @if (_model.Enrollment.Labels.Count > 0)
                {
                    <TrendChart Id="enrollment-chart" Labels="_model.Enrollment.Labels" Series="_model.Enrollment.Series" Height="160"
                                ForecastFromIndex="@(_model.Enrollment.HasModel ? _model.Enrollment.ForecastFromIndex : null)"
                                AriaLabel="Matrícula histórica y su proyección" />
                }
                else
                {
                    <EmptyState Icon="@Icons.Material.Filled.Timeline"
                                Title="Aún no hay historial suficiente"
                                Description="Captura inscripciones en al menos un periodo para mostrar el historial." />
                }
            </ChildContent>
            <Footer>
                @if (_model.Enrollment.HasModel)
                {
                    <span>
                        Regresión lineal por mínimos cuadrados ·
                        pendiente <b>@_model.Enrollment.Slope.ToString("+0.0;-0.0")</b> alumnos por periodo ·
                        R² <b>@_model.Enrollment.R2.ToString("0.00")</b>
                        @if (_model.Enrollment.NextValue is { } next)
                        {
                            <text> · @_model.Enrollment.NextLabel: <b>@next.ToString("N0")</b> ± @(_model.Enrollment.NextMargin?.ToString("N0"))</text>
                        }
                    </span>
                }
                else
                {
                    <span>Captura inscripciones por periodo para activar la proyección.</span>
                }
            </Footer>
        </SectionCard>
    </MudItem>

    <MudItem xs="12" lg="5">
        <SectionCard Title="Distribución de Alumnos por carrera"
                     Icon="@Icons.Material.Filled.School" Accent="teal">
            <Actions>
                <MudTooltip Text="Descargar gráfica PNG" Placement="Placement.Top">
                    <MudIconButton Icon="@Icons.Material.Filled.FileDownload"
                                   Color="Color.Secondary"
                                   Size="Size.Small"
                                   data-sipau-chart-download="career-chart"
                                   data-sipau-chart-title="Distribución por carrera"
                                   data-sipau-chart-filename="Distribucion-por-carrera.png" />
                </MudTooltip>
            </Actions>
            <ChildContent>
                <BarChart Id="career-chart" Labels="_model.CareerDistribution.Labels" Series="_model.CareerDistribution.Series" Height="160"
                          AriaLabel="Alumnos por carrera" />
            </ChildContent>
            <Footer>
                Carrera con mayor matrícula: <b>@_model.CareerDistribution.TopLabel</b> · total <b>@_model.CareerDistribution.Total.ToString("N0")</b> alumnos
            </Footer>
        </SectionCard>
    </MudItem>
</MudGrid>

<MudGrid Class="mt-1">
    <MudItem xs="12" lg="7">
        <SectionCard Title="Distribución de grupos"
                     Subtitle="Grupos y alumnos inscritos por carrera en el periodo activo"
                     Icon="@Icons.Material.Filled.Groups" Accent="navy">
            <ChildContent>
                <BarChart Id="groups-chart" Labels="_model.GroupDistributionByCareer.Labels" Series="_model.GroupDistributionByCareer.Series" Height="160"
                          AriaLabel="Grupos y alumnos inscritos por carrera" />
            </ChildContent>
            <Actions>
                <MudTooltip Text="Descargar gráfica PNG" Placement="Placement.Top">
                    <MudIconButton Icon="@Icons.Material.Filled.FileDownload"
                                   Color="Color.Secondary"
                                   Size="Size.Small"
                                   data-sipau-chart-download="groups-chart"
                                   data-sipau-chart-title="Distribución de grupos"
                                   data-sipau-chart-filename="Distribucion-de-grupos.png" />
                </MudTooltip>
            </Actions>
            @* <Footer>
                Carrera con más inscritos: <b>@_model.GroupDistributionByCareer.TopLabel</b> ·
                ocupación <b>@GroupOccupancy.ToString("0.0")%</b>
            </Footer> *@
        </SectionCard>
    </MudItem>
</MudGrid>


<MudText Typo="Typo.h5" Class="mt-8 mb-3">Módulos de analítica</MudText>
<MudGrid>
    <MudItem xs="12" sm="6" md="4">
        <MudCard Elevation="1" Class="d-flex flex-column" Style="height:100%">
            <MudCardContent Class="flex-grow-1">
                <MudAvatar Color="Color.Secondary" Variant="Variant.Filled" Rounded="true" Class="mb-3">
                    <MudIcon Icon="@Icons.Material.Filled.School" />
                </MudAvatar>
                <MudText Typo="Typo.h6">Alumnos</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    Analiza la edad de los alumnos de nuevo ingreso y de toda la matrícula institucional.
                </MudText>
            </MudCardContent>
            <MudCardActions>
                <MudButton Variant="Variant.Filled" Color="Color.Secondary" FullWidth="true"
                           StartIcon="@Icons.Material.Filled.ArrowForward" Href="/charts/students">
                    Ver gráficas de alumnos
                </MudButton>
            </MudCardActions>
        </MudCard>
    </MudItem>

    <MudItem xs="12" sm="6" md="4">
        <MudCard Elevation="1" Class="d-flex flex-column" Style="height:100%">
            <MudCardContent Class="flex-grow-1">
                <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Rounded="true" Class="mb-3">
                    <MudIcon Icon="@Icons.Material.Filled.Groups" />
                </MudAvatar>
                <MudText Typo="Typo.h6">Docentes</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    Consulta la distribución del personal docente por nivel académico y experiencia.
                </MudText>
            </MudCardContent>
            <MudCardActions>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                           StartIcon="@Icons.Material.Filled.ArrowForward" Href="/charts/teachers">
                    Ver gráficas de docentes
                </MudButton>
            </MudCardActions>
        </MudCard>
    </MudItem>

    @* Per-student risk is personal data; the API grants it to these areas only. *@
    <AuthorizeView Roles="@DropoutRoles">
        <MudItem xs="12" sm="6" md="4">
            <MudCard Elevation="1" Class="d-flex flex-column" Style="height:100%">
                <MudCardContent Class="flex-grow-1">
                    <MudAvatar Color="Color.Tertiary" Variant="Variant.Filled" Rounded="true" Class="mb-3">
                        <MudIcon Icon="@Icons.Material.Filled.PsychologyAlt" />
                    </MudAvatar>
                    <MudText Typo="Typo.h6">Riesgo de deserción</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        Árbol de decisión que aprende de las trayectorias terminadas y señala a los alumnos activos que conviene atender.
                    </MudText>
                </MudCardContent>
                <MudCardActions>
                    <MudButton Variant="Variant.Filled" Color="Color.Tertiary" FullWidth="true"
                               StartIcon="@Icons.Material.Filled.ArrowForward" Href="/charts/dropout">
                        Ver riesgo de deserción
                    </MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>
    </AuthorizeView>
</MudGrid>

@code {
    private const int ForecastAhead = 2;
    private const string DropoutRoles = "Admin,Control Escolar,Servicios Estudiantiles,Direccion Academica";
    private ChartsPageViewModel _model = new();
    private readonly double[] _failure = { 15.8, 14.4, 13.1, 12.5 };

    protected override async Task OnInitializedAsync()
    {
        var forecast = await Ai.GetForecastAsync(ForecastAhead);
        var careers = await GetCareersAsync();
        var groupsByCareer = await GetGroupsByCareerAsync();

        EnrollmentChart(_model, forecast);
        CareerDistributionChart(_model, careers);

        _model.GroupDistributionByCareer.Labels = groupsByCareer.Select(group => group.Career).ToList();
        _model.GroupDistributionByCareer.Series =
        [
            new ChartSeriesData("Grupos", groupsByCareer.Select(group => (double)group.Groups).ToList(), ChartPalette.Navy),
            new ChartSeriesData("Alumnos", groupsByCareer.Select(group => (double)group.Students).ToList(), ChartPalette.Clay)
        ];
    }

    /*////////////////////////////////////////////////////////////////////////////////////////////////*/
    #region Chart Creation Methods
    private void EnrollmentChart(ChartsPageViewModel model, EnrollmentForecast forecast)
    {
        _model.Enrollment.HasModel = forecast.HasModel;
        _model.Enrollment.R2 = forecast.R2;
        _model.Enrollment.NextLabel = forecast.NextLabel;
        _model.Enrollment.NextValue = forecast.NextValue;
        _model.Enrollment.NextMargin = forecast.NextMargin;
        _model.Enrollment.Labels = forecast.Labels;
        _model.Enrollment.Series = forecast.HasModel
            ?
            [
                new ChartSeriesData("Matrícula", forecast.Actual, ChartPalette.Teal, Filled: true),
                new ChartSeriesData("Tendencia del modelo", forecast.Trend, ChartPalette.Indigo, Dashed: true),
            ]
            : [new ChartSeriesData("Matrícula", forecast.Actual, ChartPalette.Teal, Filled: true)];
        _model.Enrollment.ForecastFromIndex = forecast.HistoricalCount;
        _model.Enrollment.Slope = forecast.Slope;
        _model.Enrollment.Intercept = forecast.Intercept;
    }

    private void CareerDistributionChart(ChartsPageViewModel model, List<ChartCategory> careers)
    {
        _model.CareerDistribution.Labels = careers.Select(career => career.Label).ToList();
        _model.CareerDistribution.Series =
        [
            new ChartSeriesData(
                "Alumnos",
                careers.Select(career => (double)career.Value).ToList(),
                ChartPalette.Teal),
        ];

        _model.CareerDistribution.Total = careers.Select(career => (double)career.Value).Sum();
        _model.CareerDistribution.TopLabel = careers.Count == 0
            ? "Sin datos"
            : careers.MaxBy(career => career.Value)?.Label ?? "Sin datos";
    }

    // Both charts endpoints are limited to Admin and Recursos Humanos; other areas see the page without them.
    private async Task<List<UPZMG.Implementations.Charts.ChartCategory>> GetCareersAsync()
    {
        try
        {
            return await _chartsService.GetCareersDistributionAsync();
        }
        catch (HttpRequestException)
        {
            return [];
        }
    }

    private async Task<List<GroupDistributionCareer>> GetGroupsByCareerAsync()
    {
        try
        {
            return await _chartsService.GetGroupsDistributionByCareerAsync();
        }
        catch (HttpRequestException)
        {
            return [];
        }
    }
    #endregion
}
