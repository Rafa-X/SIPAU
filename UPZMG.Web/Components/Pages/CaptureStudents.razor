@page "/datacapture/students"
@attribute [Authorize]
@inject IDataCaptureService CaptureSvc
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<PageTitle>Captura de Alumnos — SIGIE</PageTitle>

<PageHeader Title="Captura de Alumnos" Subtitle="Registro individual de alumnos del periodo activo" BackHref="/datacapture" />

<MudPaper Elevation="1" Class="pa-6">
    <MudForm @ref="_form">
        <MudText Typo="Typo.h6" Class="mb-3">Datos del alumno</MudText>
        <MudGrid>
            <MudItem xs="12" md="4">
                <MudTextField @bind-Value="_model.EnrollmentNumber" Label="Matrícula"
                              Required="true" RequiredError="La matrícula es obligatoria." />
            </MudItem>
            <MudItem xs="12" md="4">
                <MudTextField @bind-Value="_model.Curp" Label="CURP"
                              Validation="@(new Func<string, string?>(ValidateCurp))" Immediate="true" />
            </MudItem>
            <MudItem xs="12" md="4">
                <MudDatePicker @bind-Date="_model.BirthDate" Label="Fecha de nacimiento"
                               MaxDate="DateTime.Today" />
            </MudItem>

            <MudItem xs="12" md="4">
                <MudTextField @bind-Value="_model.FirstName" Label="Nombre(s)"
                              Required="true" RequiredError="El nombre es obligatorio." />
            </MudItem>
            <MudItem xs="12" md="4">
                <MudTextField @bind-Value="_model.LastName" Label="Apellido paterno"
                              Required="true" RequiredError="El apellido es obligatorio." />
            </MudItem>
            <MudItem xs="12" md="4">
                <MudTextField @bind-Value="_model.MiddleName" Label="Apellido materno" />
            </MudItem>

            <MudItem xs="12" md="6">
                <MudSelect T="int" @bind-Value="_model.CareerId" Label="Carrera"
                           Required="true" RequiredError="Selecciona una carrera.">
                    @foreach (var c in CaptureSvc.Careers)
                    {
                        <MudSelectItem T="int" Value="@int.Parse(c.Value)">@c.Text</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudSelect T="int" @bind-Value="_model.PeriodId" Label="Periodo"
                           Required="true" RequiredError="Selecciona un periodo.">
                    @foreach (var p in CaptureSvc.Periods)
                    {
                        <MudSelectItem T="int" Value="@int.Parse(p.Value)">@p.Text</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <MudItem xs="12" md="4">
                <MudSelect T="string" @bind-Value="_model.Gender" Label="Sexo">
                    @foreach (var g in CaptureSvc.Genders)
                    {
                        <MudSelectItem T="string" Value="@g">@g</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="4">
                <MudSelect T="string" @bind-Value="_model.MaritalStatus" Label="Estado civil">
                    @foreach (var m in CaptureSvc.MaritalStatuses)
                    {
                        <MudSelectItem T="string" Value="@m">@m</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="4" Class="d-flex align-center">
                <MudSwitch T="bool" @bind-Value="_model.SpeaksIndigenousLanguage"
                           Color="Color.Secondary" Label="Habla lengua indígena" />
            </MudItem>
        </MudGrid>

        <MudStack Row="true" Spacing="2" Class="mt-6">
            <MudButton Variant="Variant.Filled" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Save"
                       OnClick="Submit">Guardar alumno</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Default"
                       OnClick="@(() => Nav.NavigateTo("/datacapture"))">Cancelar</MudButton>
        </MudStack>
    </MudForm>
</MudPaper>

@code {
    private MudForm _form = null!;
    private StudentFormViewModel _model = new();

    private static string? ValidateCurp(string? curp)
    {
        if (string.IsNullOrWhiteSpace(curp)) return null; // optional
        return curp.Trim().Length == 18 ? null : "La CURP debe tener 18 caracteres.";
    }

    private async Task Submit()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid) return;

        CaptureSvc.SaveStudent(_model);
        Snackbar.Add($"Alumno {_model.FirstName} {_model.LastName} guardado correctamente.", Severity.Success);
        Nav.NavigateTo("/datacapture");
    }
}
