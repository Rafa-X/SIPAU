@page "/minutes"
@attribute [Authorize]

@*
    The minutes module is out of scope: signing a board minute requires the advanced electronic
    signature scheme the state and federal authorities have not defined yet. The screen says so
    instead of listing sessions and signatories that do not exist.
*@

<PageTitle>Actas de Junta — SIPAU</PageTitle>

<PageHeader Eyebrow="Junta directiva" Title="Actas de Junta Directiva"
            Subtitle="Seguimiento de firmas de las actas de sesión" />

<SectionCard FullHeight="false">
    <EmptyState Icon="@Icons.Material.Filled.Gavel"
                Title="Módulo fuera del alcance del proyecto"
                Description="El seguimiento de actas depende de la firma electrónica avanzada, cuyo esquema corresponde definir a las autoridades estatales y federales. Mientras no exista, el sistema no registra sesiones ni firmas: el informe que sí produce es el Informe a la Junta Directiva.">
        <MudButton Variant="Variant.Filled" Color="Color.Secondary" Href="/boardreport"
                   StartIcon="@Icons.Material.Filled.Description">Ir al Informe de Junta</MudButton>
    </EmptyState>
</SectionCard>
