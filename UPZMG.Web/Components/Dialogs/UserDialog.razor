@*
    Create / edit a system user. Returns the edited UserFormViewModel on OK.
    Enforces "one user = one role" (single MudSelect).
*@
@using UPZMG.Implementations.Users

<MudDialog>
    <DialogContent>
        @* Why the previous attempt was refused, above the fields it refers to. *@
        @if (!string.IsNullOrWhiteSpace(Error))
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true" Class="mb-4">
                @Error
            </MudAlert>
        }

        <MudForm @ref="_form">
            <MudTextField @bind-Value="_model.UserName" Label="Nombre completo"
                          Required="true" RequiredError="El nombre es obligatorio." MaxLength="100"
                          Immediate="true" Class="mb-3" />

            @* The EditUser contract carries no Email and the repository never
               updates it, so allowing edits here would silently discard them.
               The address also links the account to its employee record. *@
            <MudTextField @bind-Value="_model.Email" Label="Correo electrónico"
                          InputType="InputType.Email" Required="true"
                          ReadOnly="@_model.IsEditing"
                          Validation="@(new Func<string, string?>(ValidateEmail))"
                          Disabled="@_model.IsEditing"
                          HelperText="@(_model.IsEditing ? "El correo no se puede cambiar: identifica la cuenta y su empleado." : "Debe coincidir con el correo de un empleado registrado.")"
                          Immediate="true" Class="mb-3" />

            @* Bound by role id (what the API expects), shown by name. *@
            <MudSelect T="string" @bind-Value="_model.RoleId" Label="Rol"
                       Required="true" RequiredError="Selecciona un rol." Class="mb-3">
                @foreach (var role in Roles)
                {
                    <MudSelectItem T="string" Value="@role.Id.ToString()">@RoleLabels.Of(role.Name)</MudSelectItem>
                }
            </MudSelect>

            @* A user with no password cannot sign in (AccountController rejects a
               blank hash) and the API's CreateUser contract marks it required,
               so it is mandatory on create and "leave blank to keep" on edit. *@
            <MudTextField @bind-Value="_model.Password" Label="@(_model.IsEditing ? "Nueva contraseña (opcional)" : "Contraseña")"
                          InputType="InputType.Password"
                          Required="@(!_model.IsEditing)" RequiredError="La contraseña es obligatoria."
                          Validation="@(new Func<string, string?>(ValidatePassword))"
                          HelperText="@(_model.IsEditing ? "Déjala en blanco para conservar la contraseña actual." : $"Mínimo {PasswordRules.MinimumLength} caracteres.")"
                          Immediate="true" Class="mb-3" />

            <MudSwitch T="bool" @bind-Value="_model.IsActive" Color="Color.Secondary" Label="Usuario activo" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancelar</MudButton>
        <MudButton Color="Color.Secondary" Variant="Variant.Filled" OnClick="Submit">
            @(_model.IsEditing ? "Guardar cambios" : "Crear usuario")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public UserFormViewModel Model { get; set; } = new();
    [Parameter] public IReadOnlyList<Role> Roles { get; set; } = Array.Empty<Role>();

    /// <summary>Why the previous attempt was refused, shown above the actions.</summary>
    [Parameter] public string? Error { get; set; }

    private MudForm _form = null!;
    private UserFormViewModel _model = new();

    protected override void OnInitialized()
    {
        // Work on a copy so a cancel leaves the source untouched.
        _model = new UserFormViewModel
        {
            Id = Model.Id,
            UserName = Model.UserName,
            Email = Model.Email,
            RoleId = Model.RoleId,
            IsActive = Model.IsActive,
            // Carried over when the dialog reopens after a refused save, so nothing typed is
            // lost; it is still never read back from the database.
            Password = Model.Password,
        };
    }

    private static string? ValidateEmail(string? email)
    {
        if (string.IsNullOrWhiteSpace(email)) return "El correo es obligatorio.";
        if (!email.Contains('@') || !email.Contains('.')) return "Correo no válido.";
        return null;
    }

    private string? ValidatePassword(string? password)
    {
        // Blank on edit means "unchanged"; blank on create means an account
        // nobody can sign in with.
        return string.IsNullOrWhiteSpace(password) && _model.IsEditing ? null : PasswordRules.Problem(password);
    }

    private async Task Submit()
    {
        await _form.ValidateAsync();
        if (_form.IsValid)
            MudDialog.Close(DialogResult.Ok(_model));
    }

    private void Cancel() => MudDialog.Cancel();
}
