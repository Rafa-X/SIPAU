<div class="sipau-pagehead">
    <div class="sipau-pagehead-main">
        @if (!string.IsNullOrEmpty(BackHref))
        {
            <MudButton Class="sipau-pagehead-back mb-3" Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.ArrowBackIosNew"
                       OnClick="@(() => Nav.NavigateTo(BackHref))">Volver</MudButton>
        }

        <MudText Typo="Typo.h4" Class="sipau-title">@Title</MudText>

        @if (!string.IsNullOrEmpty(Subtitle))
        {
            <p class="sipau-pagehead-sub">@Subtitle</p>
        }
    </div>

    @if (Actions is not null)
    {
        <div class="sipau-pagehead-actions">@Actions</div>
    }
</div>

@code {
    [Inject] private NavigationManager Nav { get; set; } = null!;

    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Subtitle { get; set; }

    [Parameter] public string? Eyebrow { get; set; }

    [Parameter] public string? BackHref { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
}
