@*
    Reusable page header: optional back button, title, subtitle and an
    actions slot on the right.
*@
<MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-4" Style="flex-wrap:wrap">
    @if (!string.IsNullOrEmpty(BackHref))
    {
        <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Color="Color.Default"
                       OnClick="@(() => Nav.NavigateTo(BackHref))" aria-label="Volver" />
    }
    <div class="flex-grow-1">
        <MudText Typo="Typo.h4" Style="font-weight:700">@Title</MudText>
        @if (!string.IsNullOrEmpty(Subtitle))
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary">@Subtitle</MudText>
        }
    </div>
    @Actions
</MudStack>

@code {
    [Inject] private NavigationManager Nav { get; set; } = null!;

    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public string? BackHref { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
}
