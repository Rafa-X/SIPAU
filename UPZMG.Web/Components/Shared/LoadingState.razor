<div class="sipau-loading" role="status" aria-live="polite">
    <div class="sipau-loading-track" aria-hidden="true"></div>
    @if (!string.IsNullOrEmpty(Text))
    {
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="sipau-loading-text">@Text</MudText>
    }
</div>

@code {
    [Parameter] public string? Text { get; set; } = "Cargando…";
}
