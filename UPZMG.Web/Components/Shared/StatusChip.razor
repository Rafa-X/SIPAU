@*
    Renders a domain status label with its canonical colour.

    Pages must not call SigieUi.StatusColor themselves: routing every status
    through this component keeps the colour mapping in exactly one place, so a
    change to what "En progreso" looks like is a one-line edit.
*@
<MudChip T="string" Size="@Size" Variant="Variant.Text" Color="@SigieUi.StatusColor(Status)">
    @Status
</MudChip>

@code {
    [Parameter, EditorRequired] public string Status { get; set; } = string.Empty;
    [Parameter] public Size Size { get; set; } = Size.Small;
}
