<MudPaper Elevation="0" Class="@RootClass" Style="@Style">

    @if (HasHeader)
    {
        <div class="sipau-card-head">
            @if (!string.IsNullOrEmpty(Icon))
            {
                <span class="sipau-icon-badge"><MudIcon Icon="@Icon" /></span>
            }
            <div class="sipau-card-titles">
                <MudText Typo="Typo.h6">@Title</MudText>
                @if (!string.IsNullOrEmpty(Subtitle))
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@Subtitle</MudText>
                }
            </div>
            @if (Actions is not null)
            {
                <div class="sipau-card-actions">@Actions</div>
            }
        </div>
    }

    <div class="sipau-card-body">@ChildContent</div>

    @if (Footer is not null)
    {
        <div class="sipau-card-foot">@Footer</div>
    }

</MudPaper>

@code {
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Subtitle { get; set; }

    [Parameter] public string? Icon { get; set; }

    [Parameter] public RenderFragment? Actions { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter] public RenderFragment? Footer { get; set; }

    [Parameter] public bool FullHeight { get; set; } = true;

    [Parameter] public bool Flush { get; set; }

    [Parameter] public string? Class { get; set; }
    [Parameter] public string? Style { get; set; }

    private bool HasHeader => !string.IsNullOrEmpty(Title) || !string.IsNullOrEmpty(Icon) || Actions is not null;

    private string RootClass => string.Join(' ', new[]
    {
        "sipau-card",
        FullHeight ? "sipau-card-fill" : null,
        Flush ? "sipau-card-flush" : null,
        Class,
    }.Where(c => !string.IsNullOrEmpty(c)));
}
