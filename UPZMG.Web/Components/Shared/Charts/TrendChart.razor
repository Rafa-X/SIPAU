@*
    Interactive line / area chart drawn as plain SVG from C#.

    No JavaScript and no charting library: hover is handled by Blazor event
    callbacks on transparent bands, which is why the tooltip works without any
    interop.

    Axis labels are HTML positioned over the plot (a CSS grid keeps them in
    register). That keeps text crisp at every size instead of scaling with the
    viewBox — and sidesteps Razor reserving the <text> tag.

    Height is the least the plot takes: inside a card the chart grows to use the
    room the card has, so everything here is positioned in percentages.
*@
@using System.Globalization
@using UPZMG.Web.Components.Shared.Charts

<div id="@Id" class="sipau-chart" style="@($"--sipau-chart-h:{Height}px")">

    @if (ShowLegend && Series.Count > 0)
    {
        <div class="sipau-chart-legend">
            @foreach (var s in Series)
            {
                <span class="sipau-chart-key">
                    <i class="@(s.Dashed ? "dash" : null)" style="@($"color:{s.Color};background-color:{s.Color}")"></i>@s.Name
                </span>
            }
            @if (HasBand)
            {
                <span class="sipau-chart-key">
                    <i class="band" style="@($"background-color:color-mix(in srgb, {BandColor} 26%, transparent)")"></i>@BandName
                </span>
            }
        </div>
    }

    <div class="sipau-chart-yaxis">
        @foreach (var tick in _ticks)
        {
            <span style="@Pct("top", _scale.Y(tick) / Height * 100)">
                @tick.ToString(ValueFormat, CultureInfo.CurrentCulture)
            </span>
        }
    </div>

    <div class="sipau-chart-plot" @onmouseleave="() => _hover = null">
        <svg class="sipau-chart-svg" viewBox="@($"0 0 {VbW} {Height}")" preserveAspectRatio="none"
             role="img" aria-label="@AriaLabel">

            <defs>
                @foreach (var (s, i) in Series.Select((s, i) => (s, i)).Where(t => t.s.Filled))
                {
                    <linearGradient id="@($"{_id}-fill-{i}")" x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0%" stop-color="@s.Color" stop-opacity="0.28" />
                        <stop offset="100%" stop-color="@s.Color" stop-opacity="0" />
                    </linearGradient>
                }
            </defs>

            @* ---- grid ---- *@
            @foreach (var tick in _ticks)
            {
                var y = ChartScale.N(_scale.Y(tick));
                <line class="sipau-chart-grid" x1="0" x2="@VbW" y1="@y" y2="@y" vector-effect="non-scaling-stroke" />
            }

            @* ---- modelled region ---- *@
            @if (ForecastX is { } fx)
            {
                <rect class="sipau-chart-forecast" x="@ChartScale.N(fx)" y="0"
                      width="@ChartScale.N(VbW - fx)" height="@Height" />
                <line class="sipau-chart-divider" x1="@ChartScale.N(fx)" x2="@ChartScale.N(fx)"
                      y1="0" y2="@Height" vector-effect="non-scaling-stroke" />
            }

            @* ---- band, then areas, then strokes: what was measured ends on top ---- *@
            @if (HasBand)
            {
                <path class="sipau-chart-range" d="@BandPath()" fill="@BandColor" fill-opacity="0.13" />
            }

            @foreach (var (s, i) in Series.Select((s, i) => (s, i)).Where(t => t.s.Filled))
            {
                <path class="sipau-chart-area" d="@AreaPath(s)" fill="@($"url(#{_id}-fill-{i})")" />
            }

            @foreach (var s in Series.Where(s => s.Dashed))
            {
                <path class="sipau-chart-line dashed" d="@LinePath(s, 0, Labels.Count - 1)"
                      stroke="@s.Color" fill="none" vector-effect="non-scaling-stroke" />
            }

            @foreach (var s in Series.Where(s => !s.Dashed))
            {
                <path class="sipau-chart-line" d="@LinePath(s, 0, LastObserved)"
                      stroke="@s.Color" fill="none" vector-effect="non-scaling-stroke" />

                @if (LastObserved < Labels.Count - 1)
                {
                    <path class="sipau-chart-line projected" d="@LinePath(s, LastObserved, Labels.Count - 1)"
                          stroke="@s.Color" fill="none" vector-effect="non-scaling-stroke" />
                }
            }

            @* ---- hover guide ---- *@
            @if (_hover is { } h)
            {
                var hx = ChartScale.N(_scale.X(h, Labels.Count));
                <line class="sipau-chart-guide" x1="@hx" x2="@hx" y1="0" y2="@Height" vector-effect="non-scaling-stroke" />
            }

            @* ---- transparent hover bands, on top so they catch the pointer ---- *@
            @for (int i = 0; i < Labels.Count; i++)
            {
                var index = i;
                var bw = _scale.Width / Math.Max(1, Labels.Count - 1);
                <rect class="sipau-chart-band" x="@ChartScale.N(_scale.X(i, Labels.Count) - bw / 2)" y="0"
                      width="@ChartScale.N(bw)" height="@Height"
                      @onmouseenter="() => _hover = index" />
            }
        </svg>

        @* Hover dots are HTML so they stay round despite the stretched viewBox. *@
        @if (_hover is { } hd)
        {
            @foreach (var s in Series.Where(s => Has(s, hd)))
            {
                <span class="sipau-chart-dot"
                      style="@($"{Pct("left", _scale.X(hd, Labels.Count) / VbW * 100)};{Pct("top", _scale.Y(s.Values[hd]) / Height * 100)};background:{s.Color}")"></span>
            }

            <div class="sipau-chart-tip" style="@Pct("left", Math.Clamp(_scale.X(hd, Labels.Count) / VbW * 100, 6, 94))">
                <div class="sipau-chart-tip-head">@Labels[hd]@(IsProjected(hd) ? " · pronóstico" : null)</div>
                @foreach (var s in Series.Where(s => Has(s, hd)))
                {
                    <div class="sipau-chart-tip-row">
                        <i style="@($"background:{s.Color}")"></i>
                        <span>@s.Name</span>
                        <b>@s.Values[hd].ToString(ValueFormat, CultureInfo.CurrentCulture)@Unit</b>
                    </div>
                }
                @if (HasBand && double.IsFinite(BandLower![hd]) && double.IsFinite(BandUpper![hd]))
                {
                    <div class="sipau-chart-tip-row">
                        <i style="@($"background:{BandColor};opacity:0.45")"></i>
                        <span>@BandName</span>
                        <b>@BandLower[hd].ToString(ValueFormat, CultureInfo.CurrentCulture) a @BandUpper[hd].ToString(ValueFormat, CultureInfo.CurrentCulture)@Unit</b>
                    </div>
                }
            </div>
        }

        @if (ForecastX is { } tagX)
        {
            @* Near the right edge the tag hangs from that edge, so it never leaves the plot. *@
            var atEnd = tagX / VbW > 0.6;
            <span class="@(atEnd ? "sipau-chart-tag is-end" : "sipau-chart-tag")"
                  style="@(atEnd ? null : Pct("left", tagX / VbW * 100))">Pronóstico</span>
        }
    </div>

    <div class="@($"sipau-chart-xaxis {_axis.RowClass}")">
        @for (int i = 0; i < _axis.Labels.Count; i++)
        {
            var label = _axis.Labels[i];
            <span class="@(_hover == i ? $"{label.Class} on" : label.Class)" style="@label.Style">@label.Text</span>
        }
    </div>
</div>

@if (ShowData && Labels.Count > 0)
{
    <ChartDataTable Labels="Labels" Series="_tableSeries" ValueFormat="@ValueFormat" Unit="@Unit"
                    CategoryHeader="@CategoryHeader" Caption="@AriaLabel"
                    ForecastFromIndex="@(ForecastX is null ? null : ForecastFromIndex)" />
}

@code {
    /// <summary>Category labels along the X axis.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<string> Labels { get; set; } = Array.Empty<string>();

    /// <summary>
    /// Series to plot. Values are matched to <see cref="Labels"/> by index; a series may be
    /// shorter than the labels, and NaN leaves a gap in the line.
    /// </summary>
    [Parameter, EditorRequired] public IReadOnlyList<ChartSeriesData> Series { get; set; } = Array.Empty<ChartSeriesData>();

    /// <summary>Least height of the plot, in pixels.</summary>
    [Parameter] public int Height { get; set; } = 280;

    /// <summary>
    /// Index from which the data stops being observed and becomes modelled. From there on
    /// every line is drawn dashed and without its fill: a projection must not look measured.
    /// </summary>
    [Parameter] public int? ForecastFromIndex { get; set; }

    /// <summary>Edges of an uncertainty band, one value per label; drawn as a tinted area.</summary>
    [Parameter] public IReadOnlyList<double>? BandUpper { get; set; }
    [Parameter] public IReadOnlyList<double>? BandLower { get; set; }
    [Parameter] public string BandName { get; set; } = "Intervalo";
    [Parameter] public string BandColor { get; set; } = ChartPalette.Indigo;

    /// <summary>Top of the axis when the measure has one, such as 100 for a percentage.</summary>
    [Parameter] public double? Max { get; set; }

    [Parameter] public string ValueFormat { get; set; } = "N0";
    [Parameter] public string? Unit { get; set; }
    [Parameter] public bool ShowLegend { get; set; } = true;
    [Parameter] public string AriaLabel { get; set; } = "Gráfica de tendencia";
    [Parameter] public string? Id { get; set; }

    /// <summary>The figures as a table under the drawing; the tooltip needs a mouse.</summary>
    [Parameter] public bool ShowData { get; set; } = true;

    /// <summary>What the categories are, for the table's first column.</summary>
    [Parameter] public string CategoryHeader { get; set; } = "Periodo";

    private const int VbW = 1000;

    private readonly string _id = $"tc{Guid.NewGuid():N}"[..10];
    private int? _hover;
    private ChartScale _scale = null!;
    private IReadOnlyList<double> _ticks = Array.Empty<double>();
    private ChartAxisLayout _axis = ChartAxisLayout.Empty;
    private IReadOnlyList<ChartSeriesData> _tableSeries = Array.Empty<ChartSeriesData>();

    protected override void OnParametersSet()
    {
        // The plot fills the whole viewBox; axis labels live outside it in HTML.
        var values = Series.SelectMany(s => s.Values);
        if (HasBand) values = values.Concat(BandUpper!).Concat(BandLower!);

        _scale = new ChartScale(values, left: 4, right: VbW - 4, top: 10, bottom: Height - 10, fixedMax: Max);
        _ticks = _scale.Ticks();
        _axis = ChartAxis.Layout(Labels, i => _scale.X(i, Labels.Count) / VbW, stagger: false);

        // The table carries the same figures as the drawing, band included.
        _tableSeries = HasBand
            ?
            [
                .. Series,
                new ChartSeriesData($"{BandName}: mínimo", BandLower!, BandColor),
                new ChartSeriesData($"{BandName}: máximo", BandUpper!, BandColor),
            ]
            : Series;

        _hover = null;
    }

    private bool HasBand =>
        BandUpper is { Count: > 0 } && BandLower is { Count: > 0 }
        && BandUpper.Count == Labels.Count && BandLower.Count == Labels.Count;

    // The modelled region opens at the last observed point: everything to its right, the
    // stretch that joins it to the first projected period included, is not measured.
    private double? ForecastX =>
        ForecastFromIndex is { } fi && fi > 0 && fi < Labels.Count
            ? _scale.X(fi - 1, Labels.Count)
            : null;

    // Index of the last observed point: the projection starts from it, so the two join.
    private int LastObserved => ForecastX is null ? Labels.Count - 1 : ForecastFromIndex!.Value - 1;

    private bool IsProjected(int index) => ForecastX is not null && index >= ForecastFromIndex;

    private static bool Has(ChartSeriesData s, int index) =>
        index < s.Values.Count && double.IsFinite(s.Values[index]);

    private string Point(int index, double value) =>
        $"{ChartScale.N(_scale.X(index, Labels.Count))},{ChartScale.N(_scale.Y(value))}";

    // A gap (NaN, or a series shorter than the labels) lifts the pen instead of drawing through it.
    private string LinePath(ChartSeriesData s, int from, int to)
    {
        var path = new System.Text.StringBuilder();
        bool pen = false;

        for (int i = Math.Max(0, from); i <= to; i++)
        {
            if (!Has(s, i)) { pen = false; continue; }
            path.Append(pen ? 'L' : 'M').Append(Point(i, s.Values[i]));
            pen = true;
        }

        return path.ToString();
    }

    // Only under what was observed, and one closed shape per unbroken run.
    private string AreaPath(ChartSeriesData s)
    {
        var path = new System.Text.StringBuilder();
        var baseline = ChartScale.N(Height);
        int start = -1;

        for (int i = 0; i <= LastObserved + 1; i++)
        {
            bool has = i <= LastObserved && Has(s, i);
            if (has && start < 0) start = i;
            if (has || start < 0) continue;

            path.Append(LinePath(s, start, i - 1))
                .Append($"L{ChartScale.N(_scale.X(i - 1, Labels.Count))},{baseline}")
                .Append($"L{ChartScale.N(_scale.X(start, Labels.Count))},{baseline}Z");
            start = -1;
        }

        return path.ToString();
    }

    // Upper edge left to right, then the lower edge back.
    private string BandPath()
    {
        var indexes = Enumerable.Range(0, Labels.Count)
            .Where(i => double.IsFinite(BandUpper![i]) && double.IsFinite(BandLower![i]))
            .ToList();
        if (indexes.Count < 2) return string.Empty;

        var upper = indexes.Select((i, n) => $"{(n == 0 ? 'M' : 'L')}{Point(i, BandUpper![i])}");
        var lower = indexes.AsEnumerable().Reverse().Select(i => $"L{Point(i, BandLower![i])}");
        return string.Concat(upper) + string.Concat(lower) + "Z";
    }

    /// <summary>Culture-invariant percentage declaration for inline positioning.</summary>
    private static string Pct(string property, double value) =>
        $"{property}:{value.ToString("0.##", CultureInfo.InvariantCulture)}%";
}
