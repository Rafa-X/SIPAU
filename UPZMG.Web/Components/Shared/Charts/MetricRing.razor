@*
    Radial gauge for a single percentage. SVG rather than MudProgressCircular so
    the arc can carry a gradient and animate its sweep from zero.
*@
@using System.Globalization
@using UPZMG.Web.Components.Shared.Charts

<div class="sigie-ring" style="@($"max-width:{Size}px")">
    <svg viewBox="0 0 120 120" role="img" aria-label="@($"{Label}: {Value.ToString(ValueFormat, CultureInfo.CurrentCulture)}")">
        <defs>
            <linearGradient id="@($"{_id}-arc")" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0%" stop-color="@FromColor" />
                <stop offset="100%" stop-color="@ToColor" />
            </linearGradient>
        </defs>

        @* Track *@
        <circle class="sigie-ring-track" cx="60" cy="60" r="@R" fill="none" stroke-width="@Stroke" />

        @* Value arc — rotated so it starts at 12 o'clock *@
        <circle class="sigie-ring-arc" cx="60" cy="60" r="@R" fill="none"
                stroke="@($"url(#{_id}-arc)")" stroke-width="@Stroke" stroke-linecap="round"
                transform="rotate(-90 60 60)"
                stroke-dasharray="@ChartScale.N(_circumference)"
                style="@($"--sigie-ring-offset:{ChartScale.N(_offset)}")" />
    </svg>

    <div class="sigie-ring-center">
        <div class="sigie-ring-value">@Value.ToString(ValueFormat, CultureInfo.CurrentCulture)@Unit</div>
        @if (!string.IsNullOrEmpty(Label))
        {
            <div class="sigie-ring-label">@Label</div>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public double Value { get; set; }
    [Parameter] public double Max { get; set; } = 100;
    [Parameter] public string? Label { get; set; }
    [Parameter] public string Unit { get; set; } = "%";
    [Parameter] public string ValueFormat { get; set; } = "0.#";

    /// <summary>Rendered width in pixels (the ring is always square).</summary>
    [Parameter] public int Size { get; set; } = 190;

    [Parameter] public string FromColor { get; set; } = "#22D3BF";
    [Parameter] public string ToColor { get; set; } = "#6D5CE7";

    private const string R = "52";
    private const string Stroke = "9";

    private readonly string _id = $"mr{Guid.NewGuid():N}"[..10];
    private double _circumference;
    private double _offset;

    protected override void OnParametersSet()
    {
        _circumference = 2 * Math.PI * 52;
        var ratio = Max <= 0 ? 0 : Math.Clamp(Value / Max, 0, 1);
        _offset = _circumference * (1 - ratio);
    }
}
