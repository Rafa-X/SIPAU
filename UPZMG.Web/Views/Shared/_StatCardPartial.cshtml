@* ============================================================
   SIGIE — Stat Card Partial
   ViewData keys: CardTitle, CardValue, CardSubtitle,
   CardIcon (icon name), CardColor ("navy","teal","gold","red").
   ============================================================ *@
@{
    var title = ViewData["CardTitle"]?.ToString() ?? "";
    var value = ViewData["CardValue"]?.ToString() ?? "0";
    var subtitle = ViewData["CardSubtitle"]?.ToString() ?? "";
    var icon = ViewData["CardIcon"]?.ToString() ?? "chart";
    var color = ViewData["CardColor"]?.ToString() ?? "navy";
}

<div class="stat-card" data-color="@color">
    <div class="stat-card-content">
        <div class="stat-card-title">@title</div>
        <div class="stat-card-value">@value</div>
        @if (!string.IsNullOrEmpty(subtitle))
        {
            <div class="stat-card-subtitle">@subtitle</div>
        }
    </div>
    <div class="stat-card-icon @color">
        <icon name="@icon" />
    </div>
</div>
