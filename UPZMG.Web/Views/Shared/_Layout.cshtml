<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="SIGIE — Sistema Inteligente de Gestión de Información Estadística — UPZMG" />
    <title>@ViewData["Title"] — SIGIE</title>

    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <!-- Design System -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />

    <!-- Page-specific styles -->
    @await RenderSectionAsync("PageStyles", required: false)
</head>
<body>
    @if (User.Identity?.IsAuthenticated == true)
    {
        @* Authenticated: sidebar + main content *@
        <div class="app-layout">
            @{
                ViewData["UserName"] = ViewData["UserName"] ?? User.Identity?.Name ?? "Usuario";
                ViewData["UserRole"] = ViewData["UserRole"] ?? "—";
                ViewData["UserInitials"] = ViewData["UserInitials"] ?? "U";
            }
            <partial name="_SidebarPartial" />

            <main class="app-main">
                @RenderBody()
            </main>
        </div>
    }
    else
    {
        @* Not authenticated: full-page layout (login) *@
        @RenderBody()
    }

    <!-- Core JS -->
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
