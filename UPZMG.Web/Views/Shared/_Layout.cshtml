<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="SIGIE — Sistema Inteligente de Gestión de Información Estadística — UPZMG" />
    <title>@ViewData["Title"] — SIGIE</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("PageStyles", required: false)
</head>
<body>
    @if (User.Identity?.IsAuthenticated == true)
    {
        ViewData["UserName"] = ViewData["UserName"] ?? User.Identity?.Name ?? "Usuario";
        ViewData["UserRole"] = ViewData["UserRole"] ?? "—";
        ViewData["UserInitials"] = ViewData["UserInitials"] ?? "U";

        <div class="app-layout" id="appLayout">
            <partial name="_TopbarPartial" />
            <partial name="_SidebarPartial" />
            <div class="app-backdrop" id="appBackdrop"></div>

            <main class="app-main">
                @RenderBody()
            </main>
        </div>
    }
    else
    {
        @RenderBody()
    }

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
