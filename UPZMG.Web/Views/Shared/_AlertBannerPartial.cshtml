@model UPZMG.Web.Models.AlertBannerModel

@* ============================================================
   SIGIE — Alert Banner Partial (info / warning / success)
   ============================================================ *@
@{
    var (cssClass, iconName) = Model.Type switch
    {
        "warning" => ("alert-banner-warning", "warning"),
        "success" => ("alert-banner-success", "check"),
        _         => ("alert-banner-info", "info")
    };

    var priorityClass = Model.Priority?.ToLower() switch
    {
        "alta" => "priority-alta",
        "baja" => "priority-baja",
        _ => "priority-media"
    };
}

<div class="alert-banner @cssClass">
    <span class="alert-banner-icon"><icon name="@iconName" /></span>
    <span class="alert-banner-text">@Model.Message</span>
    @if (!string.IsNullOrEmpty(Model.Priority))
    {
        <span class="alert-banner-priority @priorityClass">@Model.Priority</span>
    }
</div>
