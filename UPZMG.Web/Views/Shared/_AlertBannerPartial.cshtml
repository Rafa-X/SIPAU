@model UPZMG.Web.Models.AlertBannerModel

@* ============================================================
   SIGIE — Alert Banner Partial
   Reusable component for info/warning/success banners.
   ============================================================ *@

@{
    var cssClass = Model.Type switch
    {
        "warning" => "alert-banner-warning",
        "success" => "alert-banner-success",
        _ => "alert-banner-info"
    };

    var priorityClass = Model.Priority?.ToLower() switch
    {
        "alta" => "priority-alta",
        "baja" => "priority-baja",
        _ => "priority-media"
    };
}

<div class="alert-banner @cssClass">
    <span class="alert-banner-icon">ℹ</span>
    <span class="alert-banner-text">@Model.Message</span>
    @if (!string.IsNullOrEmpty(Model.Priority))
    {
        <span class="alert-banner-priority @priorityClass">@Model.Priority</span>
    }
</div>
