@* ============================================================
   SIGIE — Sidebar Navigation Partial
   Receives user name, role, and initials via ViewData.
   ============================================================ *@

@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var userName = ViewData["UserName"]?.ToString() ?? "Usuario";
    var userRole = ViewData["UserRole"]?.ToString() ?? "—";
    var userInitials = ViewData["UserInitials"]?.ToString() ?? "U";
}

<button class="sidebar-toggle" id="sidebarToggle" aria-label="Open menu">
    ☰
</button>
<div class="sidebar-overlay" id="sidebarOverlay"></div>

<aside class="sidebar" id="sidebar">
    <!-- Brand -->
    <div class="sidebar-brand">
        <div class="sidebar-brand-title">SIGIE</div>
        <div class="sidebar-brand-subtitle">Sistema de Gestión Estadística</div>
    </div>

    <!-- Navigation -->
    <ul class="sidebar-nav">
        <li class="sidebar-nav-section">Operación</li>
        <li class="sidebar-nav-item">
            <a asp-controller="Dashboard" asp-action="Index"
               class="sidebar-nav-link @(currentController == "Dashboard" ? "active" : "")">
                <span class="sidebar-nav-icon">📊</span>
                Tablero de Control
            </a>
        </li>
        <li class="sidebar-nav-item">
            <a asp-controller="DataCapture" asp-action="Index"
               class="sidebar-nav-link @(currentController == "DataCapture" ? "active" : "")">
                <span class="sidebar-nav-icon">📋</span>
                Captura de Datos
            </a>
        </li>
        <li class="sidebar-nav-item">
            <a asp-controller="Charts" asp-action="Index"
               class="sidebar-nav-link @(currentController == "Charts" ? "active" : "")">
                <span class="sidebar-nav-icon">📈</span>
                Gráficas
            </a>
        </li>

        <li class="sidebar-nav-section">Reportes</li>
        <li class="sidebar-nav-item">
            <a asp-controller="Reports" asp-action="Index"
               class="sidebar-nav-link @(currentController == "Reports" ? "active" : "")">
                <span class="sidebar-nav-icon">📄</span>
                Reportes 911 / SII
            </a>
        </li>
        <li class="sidebar-nav-item">
            <a asp-controller="BoardReport" asp-action="Index"
               class="sidebar-nav-link @(currentController == "BoardReport" ? "active" : "")">
                <span class="sidebar-nav-icon">📑</span>
                Informe de Junta
            </a>
        </li>
        <li class="sidebar-nav-item">
            <a asp-controller="Minutes" asp-action="Index"
               class="sidebar-nav-link @(currentController == "Minutes" ? "active" : "")">
                <span class="sidebar-nav-icon">🖋️</span>
                Actas de Junta
            </a>
        </li>

        @if (User.IsInRole("Admin"))
        {
            <li class="sidebar-nav-section">Administración</li>
            <li class="sidebar-nav-item">
                <a asp-controller="Settings" asp-action="Index"
                   class="sidebar-nav-link @(currentController == "Settings" ? "active" : "")">
                    <span class="sidebar-nav-icon">⚙️</span>
                    Configuración
                </a>
            </li>
            <li class="sidebar-nav-item">
                <a asp-controller="Users" asp-action="Index"
                   class="sidebar-nav-link @(currentController == "Users" ? "active" : "")">
                    <span class="sidebar-nav-icon">👥</span>
                    Usuarios
                </a>
            </li>
            <li class="sidebar-nav-item">
                <a asp-controller="Security" asp-action="Index"
                   class="sidebar-nav-link @(currentController == "Security" ? "active" : "")">
                    <span class="sidebar-nav-icon">🔐</span>
                    Seguridad
                </a>
            </li>
        }
    </ul>

    <!-- User Profile Footer -->
    <div class="sidebar-footer">
        <div class="sidebar-profile">
            <div class="sidebar-avatar">@userInitials</div>
            <div class="sidebar-profile-info">
                <div class="sidebar-profile-name">@userName</div>
                <div class="sidebar-profile-role">@userRole</div>
            </div>
        </div>
        <form method="post" asp-controller="Account" asp-action="Logout" style="margin-top: 10px;">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-outline" style="width:100%; font-size: 0.8125rem; padding: 8px;">
                Cerrar sesión
            </button>
        </form>
    </div>
</aside>
