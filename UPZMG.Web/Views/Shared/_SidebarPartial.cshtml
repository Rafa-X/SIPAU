@* ============================================================
   SIGIE — Sidebar (navigation only; identity lives in the top bar).
   ============================================================ *@
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    string Active(string controller) => currentController == controller ? "active" : "";
}

<aside class="sidebar" id="sidebar">
    <nav class="sidebar-nav">
        <span class="sidebar-nav-section">Operación</span>
        <a href="/dashboard" class="sidebar-nav-link @Active("Dashboard")">
            <icon name="dashboard" /> Tablero de Control
        </a>
        <a href="/datacapture" class="sidebar-nav-link @Active("DataCapture")">
            <icon name="capture" /> Captura de Datos
        </a>
        <a href="/charts" class="sidebar-nav-link @Active("Charts")">
            <icon name="chart" /> Gráficas
        </a>

        <span class="sidebar-nav-section">Reportes</span>
        <a href="/reports" class="sidebar-nav-link @Active("Reports")">
            <icon name="report" /> Reportes 911 / SII
        </a>
        <a href="/boardreport" class="sidebar-nav-link @Active("BoardReport")">
            <icon name="board" /> Informe de Junta
        </a>
        <a href="/minutes" class="sidebar-nav-link @Active("Minutes")">
            <icon name="minutes" /> Actas de Junta
        </a>

        @if (User.IsInRole("Admin"))
        {
            <span class="sidebar-nav-section">Administración</span>
            <a href="/settings" class="sidebar-nav-link @Active("Settings")">
                <icon name="settings" /> Configuración
            </a>
            <a href="/users" class="sidebar-nav-link @Active("Users")">
                <icon name="users" /> Usuarios
            </a>
        }
    </nav>
</aside>
