@model UPZMG.Web.Models.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

@section PageStyles {
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
}

<!-- Page Header -->
<div class="page-header animate-fade-in">
    <div class="page-header-left">
        <h1>Dashboard — SIGIE</h1>
        <p>Panel de Control Institucional</p>
    </div>
    <div class="page-header-right">
        <div class="period-badge">
            <span>@Model.ActivePeriod</span>
            @if (Model.IsPeriodActive)
            {
                <span class="period-badge-dot"></span>
                <span class="period-badge-label">Periodo Activo</span>
            }
        </div>
    </div>
</div>

<!-- Alert Banners -->
@if (Model.Alerts.Any())
{
    <div class="dashboard-alerts">
        @foreach (var alert in Model.Alerts)
        {
            <partial name="_AlertBannerPartial" model="alert" />
        }
    </div>
}

<!-- Summary Banner -->
<div class="summary-banner-section">
    <div class="summary-banner">
        <span class="summary-banner-icon">ℹ</span>
        <span class="summary-banner-text">
            @Model.CompletedAreas de @Model.TotalAreas áreas han completado su captura del periodo
        </span>
    </div>
</div>

<!-- Stat Cards -->
<div class="stat-cards-grid">
    <partial name="_StatCardPartial"
             view-data='@(new ViewDataDictionary(ViewData) {
                 { "CardTitle", "Total Alumnos" },
                 { "CardValue", Model.TotalStudents.ToString("N0") },
                 { "CardSubtitle", $"+ {Model.NewEnrollments} nuevos ingresos" },
                 { "CardIcon", "👥" },
                 { "CardColor", "blue" }
             })' />

    <partial name="_StatCardPartial"
             view-data='@(new ViewDataDictionary(ViewData) {
                 { "CardTitle", "Índice Aprobación" },
                 { "CardValue", Model.ApprovalRate.ToString("0.0") + "%" },
                 { "CardSubtitle", $"Reprobación: {Model.FailureRate:0.0}%" },
                 { "CardIcon", "✅" },
                 { "CardColor", "green" }
             })' />

    <partial name="_StatCardPartial"
             view-data='@(new ViewDataDictionary(ViewData) {
                 { "CardTitle", "Ingresos Totales" },
                 { "CardValue", "$" + Model.TotalRevenue.ToString("N0") },
                 { "CardSubtitle", Model.RevenuePeriod },
                 { "CardIcon", "💰" },
                 { "CardColor", "gold" }
             })' />

    <partial name="_StatCardPartial"
             view-data='@(new ViewDataDictionary(ViewData) {
                 { "CardTitle", "Total Docentes" },
                 { "CardValue", Model.TotalTeachers.ToString() },
                 { "CardSubtitle", $"{Model.TeachersWithPostgrad} con posgrado" },
                 { "CardIcon", "🎓" },
                 { "CardColor", "purple" }
             })' />
</div>

<!-- Capture Progress Section -->
<div class="capture-section">
    <div class="capture-header">
        <div class="capture-header-left">
            <h3>Estado de Capturas por Área</h3>
            <p>Progreso de captura de información del periodo actual</p>
        </div>
        <a asp-controller="Reports" asp-action="Index" class="btn btn-accent">Generar Reporte 911</a>
    </div>

    <table class="capture-table">
        <thead>
            <tr>
                <th>Área</th>
                <th>Progreso</th>
                <th>Estado</th>
                <th style="text-align: right;">Porcentaje</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var area in Model.AreaProgress)
            {
                var fillClass = area.Percentage == 100 ? "complete"
                    : area.Percentage >= 50 ? "warning"
                    : "danger";

                var dotClass = area.Status switch
                {
                    "Completo" => "complete",
                    "En progreso" => "in-progress",
                    _ => "pending"
                };

                <tr>
                    <td>
                        <div class="capture-area-name">@area.AreaName</div>
                        <div class="capture-area-responsible">Responsable: @area.ResponsiblePerson</div>
                    </td>
                    <td>
                        <div class="capture-progress-bar">
                            <div class="capture-progress-fill @fillClass"
                                 style="width: 0%"
                                 data-width="@area.Percentage%"></div>
                        </div>
                    </td>
                    <td>
                        <span class="badge @(area.Status == "Completo" ? "badge-success" : area.Status == "En progreso" ? "badge-warning" : "badge-danger")">
                            <span class="status-dot @dotClass"></span>
                            @area.Status
                        </span>
                    </td>
                    <td class="capture-percentage" style="text-align: right;">
                        @area.Percentage%
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
