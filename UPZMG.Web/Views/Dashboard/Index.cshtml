@model UPZMG.Web.Models.DashboardViewModel
@{
    ViewData["Title"] = "Tablero de Control";
}

<page-header title="Tablero de Control" subtitle="Panel de indicadores institucionales del periodo activo" />

@if (Model.Alerts.Any())
{
    <div class="dashboard-alerts">
        @foreach (var alert in Model.Alerts)
        {
            <partial name="_AlertBannerPartial" model="alert" />
        }
    </div>
}

<div class="summary-banner">
    <icon name="info" />
    <span>@Model.CompletedAreas de @Model.TotalAreas áreas han completado su captura del periodo</span>
</div>

<div class="stat-cards-grid">
    <partial name="_StatCardPartial" view-data='@(new ViewDataDictionary(ViewData) {
        { "CardTitle", "Total Alumnos" },
        { "CardValue", Model.TotalStudents.ToString("N0") },
        { "CardSubtitle", $"+ {Model.NewEnrollments} nuevos ingresos" },
        { "CardIcon", "users" }, { "CardColor", "navy" } })' />

    <partial name="_StatCardPartial" view-data='@(new ViewDataDictionary(ViewData) {
        { "CardTitle", "Índice de Aprobación" },
        { "CardValue", Model.ApprovalRate.ToString("0.0") + "%" },
        { "CardSubtitle", $"Reprobación: {Model.FailureRate:0.0}%" },
        { "CardIcon", "check" }, { "CardColor", "teal" } })' />

    <partial name="_StatCardPartial" view-data='@(new ViewDataDictionary(ViewData) {
        { "CardTitle", "Ingresos Totales" },
        { "CardValue", "$" + Model.TotalRevenue.ToString("N0") },
        { "CardSubtitle", Model.RevenuePeriod },
        { "CardIcon", "money" }, { "CardColor", "gold" } })' />

    <partial name="_StatCardPartial" view-data='@(new ViewDataDictionary(ViewData) {
        { "CardTitle", "Total Docentes" },
        { "CardValue", Model.TotalTeachers.ToString() },
        { "CardSubtitle", $"{Model.TeachersWithPostgrad} con posgrado" },
        { "CardIcon", "teacher" }, { "CardColor", "navy" } })' />
</div>

<section class="capture-section">
    <div class="capture-header">
        <div class="capture-header-left">
            <h3>Estado de Capturas por Área</h3>
            <p>Progreso de captura de información del periodo actual</p>
        </div>
        <a asp-controller="Reports" asp-action="Index" class="btn btn-accent">
            <icon name="report" /> Generar Reporte 911
        </a>
    </div>

    <table class="data-table">
        <thead>
            <tr>
                <th>Área</th>
                <th>Progreso</th>
                <th>Estado</th>
                <th class="col-actions">Porcentaje</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var area in Model.AreaProgress)
            {
                var fillClass = area.Percentage == 100 ? "complete" : area.Percentage >= 50 ? "warning" : "danger";
                var dotClass = area.Status switch { "Completo" => "complete", "En progreso" => "in-progress", _ => "pending" };
                var badgeClass = area.Status == "Completo" ? "badge-success" : area.Status == "En progreso" ? "badge-warning" : "badge-danger";

                <tr>
                    <td>
                        <div class="capture-area-name">@area.AreaName</div>
                        <div class="capture-area-responsible">Responsable: @area.ResponsiblePerson</div>
                    </td>
                    <td>
                        <div class="capture-progress-bar">
                            <div class="capture-progress-fill @fillClass" style="width: @area.Percentage%"></div>
                        </div>
                    </td>
                    <td>
                        <span class="badge @badgeClass"><span class="status-dot @dotClass"></span> @area.Status</span>
                    </td>
                    <td class="capture-percentage col-actions">@area.Percentage%</td>
                </tr>
            }
        </tbody>
    </table>
</section>
