@model UPZMG.Web.Models.Users.UserFormViewModel
@{
    ViewData["Title"] = "Editar Usuario";
}

@section PageStyles {
    <link rel="stylesheet" href="~/css/data-capture.css" asp-append-version="true" />
}

<!-- Page Header -->
<div class="page-header animate-fade-in">
    <div class="page-header-left">
        <h1>Editar Usuario</h1>
        <p>Actualiza el rol y el estado de acceso del usuario</p>
    </div>
    <div class="page-header-right">
        <a asp-controller="Users" asp-action="Index" class="btn btn-outline">← Volver a Usuarios</a>
    </div>
</div>

<partial name="_UserForm" model="Model" />
