@model UPZMG.Web.Models.Users.UsersIndexViewModel
@{
    ViewData["Title"] = "Usuarios y Roles";
}

@section PageStyles {
    <link rel="stylesheet" href="~/css/data-capture.css" asp-append-version="true" />
}

<!-- Page Header -->
<div class="page-header animate-fade-in">
    <div class="page-header-left">
        <h1>Usuarios y Roles</h1>
        <p>Alta de usuarios y asignación de rol de acceso</p>
    </div>
    <div class="page-header-right">
        <a asp-controller="Users" asp-action="Create" class="btn btn-accent">+ Nuevo usuario</a>
    </div>
</div>

@if (ViewData["UsersStatus"] is string statusMessage)
{
    <div class="dashboard-alerts">
        <partial name="_AlertBannerPartial" model='new AlertBannerModel { Message = statusMessage, Type = "success", Priority = "" }' />
    </div>
}

<div class="capture-section">
    <table class="capture-table">
        <thead>
            <tr>
                <th>Usuario</th>
                <th>Correo</th>
                <th>Rol</th>
                <th>Estado</th>
                <th>Último acceso</th>
                <th style="text-align: right;">Acción</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model.Users)
            {
                <tr>
                    <td class="capture-area-name">@user.FullName</td>
                    <td class="text-muted" style="font-size: var(--font-size-sm);">@user.Email</td>
                    <td><span class="badge badge-info">@user.RoleName</span></td>
                    <td>
                        @if (user.IsActive)
                        {
                            <span class="badge badge-success"><span class="status-dot complete"></span>Activo</span>
                        }
                        else
                        {
                            <span class="badge badge-danger"><span class="status-dot pending"></span>Inactivo</span>
                        }
                    </td>
                    <td class="text-muted" style="font-size: var(--font-size-sm);">
                        @(user.LastLogin?.ToString("dd/MM/yyyy HH:mm") ?? "—")
                    </td>
                    <td style="text-align: right;">
                        <a asp-controller="Users" asp-action="Edit" asp-route-id="@user.Id" class="btn btn-outline btn-sm">Editar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
