@model UPZMG.Web.Models.Users.UsersIndexViewModel
@{
    ViewData["Title"] = "Usuarios y Roles";
}

<page-header title="Usuarios y Roles" subtitle="Alta de usuarios y asignación de rol de acceso">
    <a asp-controller="Users" asp-action="CreateTemplate" class="btn btn-accent">
        <icon name="plus" /> Nuevo usuario
    </a>
</page-header>

@if (ViewData["UsersStatus"] is string statusMessage)
{
    <div class="dashboard-alerts">
        <partial name="_AlertBannerPartial" model='new AlertBannerModel { Message = statusMessage, Type = "success", Priority = "" }' />
    </div>
}

<section class="table-section">
    <table class="data-table">
        <thead>
            <tr>
                <th>Usuario</th>
                <th>Correo</th>
                <th>Rol</th>
                <th>Estado</th>
                <th>Último acceso</th>
                <th class="col-actions">Acción</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model.Users)
            {
                <tr>
                    <td class="capture-area-name">@user.UserName</td>
                    <td class="text-muted">@user.Email</td>
                    <td><span class="badge badge-teal">@user.Role?.Name</span></td>
                    <td>
                        @if (user.IsActive)
                        {
                            <span class="badge badge-success"><span class="status-dot complete"></span> Activo</span>
                        }
                        else
                        {
                            <span class="badge badge-danger"><span class="status-dot pending"></span> Inactivo</span>
                        }
                    </td>
                    <td class="text-muted">@(user.LastLogin?.ToString("dd/MM/yyyy HH:mm") ?? "—")</td>
                    <td class="col-actions">
                        <a asp-controller="Users" asp-action="EditTemplate" asp-route-userId="@user.Id" class="btn btn-outline btn-sm">
                            <icon name="edit" /> Editar
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</section>
