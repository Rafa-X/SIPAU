@model UPZMG.Web.Models.Users.UserFormViewModel
@{
    var action = Model.IsEditing ? "EditAction" : "CreateAction";
}

@if (Model.IsEditing)
{
    ViewData["Title"] = "Editar usuario";
}
else
{
    ViewData["Title"] = "Nuevo usuario";
}

<page-header title="@(Model.IsEditing ? "Editar Usuario" : "Nuevo Usuario")" 
    subtitle="@(Model.IsEditing ? "Actualiza el rol y el estado de acceso del usuario" : "Da de alta un usuario y asígnale un rol de acceso")">
    <a asp-controller="Users" asp-action="Index" class="btn btn-outline">
        <icon name="arrow-left" /> Volver a Usuarios
    </a>
</page-header>

<div class="card animate-slide-up">
    <form method="post" asp-controller="Users" asp-action="@action">
        @Html.AntiForgeryToken()
        @if (Model.IsEditing)
        {
            <input type="hidden" asp-for="Id" />
        }

        <h3>Datos del usuario</h3>

        <div class="form-grid">
            <form-field label="Nombre completo" for="UserName">
                <input asp-for="UserName" class="form-control" required autocomplete="off" />
            </form-field>

            <form-field label="Correo electrónico de empleado" for="Email">
                @if (Model.IsEditing)
                {
                    <input asp-for="Email" type="email" class="form-control" readonly />
                }
                else
                {
                    <input asp-for="Email" type="email" class="form-control" required />
                }
            </form-field>

            <form-field label="Rol" for="RoleId">
                <select asp-for="RoleId" class="form-control" asp-items="Model.Roles" required>
                    <option value="">Selecciona...</option>
                </select>
            </form-field>

            <div class="form-group form-group-checkbox">
                <label for="IsActive">
                    <input asp-for="IsActive" type="checkbox" />
                    Usuario activo
                </label>
            </div>

            <form-field label="Contraseña" for="Password">
                <input asp-for="Password" type="password" class="form-control" required="@(!Model.IsEditing)" autocomplete="new-password" placeholder="Dejar en blanco para mantener la contraseña actual."/>
            </form-field>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-accent">@(Model.IsEditing ? "Guardar cambios" : "Crear usuario")</button>
            <a asp-controller="Users" asp-action="Index" class="btn btn-outline">Cancelar</a>
        </div>
    </form>
</div>