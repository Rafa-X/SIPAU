@model UPZMG.Web.Models.MinuteDetailViewModel
@{
    ViewData["Title"] = "Detalle de Acta";

    var badgeClass = Model.Status switch
    {
        "Firmada" => "badge-success",
        "En revisión gobierno" => "badge-info",
        _ => "badge-warning"
    };
}

<page-header title="@($"Acta — {Model.SessionName}")" subtitle="@($"{Model.Date:dd/MM/yyyy}")">
    <span class="badge @badgeClass">@Model.Status</span>
    <a asp-controller="Minutes" asp-action="Index" class="btn btn-outline">
        <icon name="arrow-left" /> Volver a Actas
    </a>
</page-header>

<div class="card animate-slide-up delay-1">
    <div class="signatories-header">
        <div>
            <h3>Firmantes</h3>
            <p class="section-subtitle">Estatus de firma de cada integrante de la junta directiva</p>
        </div>
        <button type="button" class="btn btn-accent" disabled title="Próximamente — requiere integración de firma electrónica avanzada">
            <icon name="edit" /> Solicitar firma electrónica
        </button>
    </div>

    <div class="signatories-list">
        @foreach (var signatory in Model.Signatories)
        {
            var signatoryBadge = signatory.Status == "Firmado" ? "badge-success" : "badge-warning";
            var dotClass = signatory.Status == "Firmado" ? "complete" : "pending";

            <div class="signatory">
                <div class="signatory-avatar">@signatory.Initials</div>
                <div class="signatory-info">
                    <div class="signatory-name">@signatory.Name</div>
                    <div class="signatory-title">@signatory.Title</div>
                </div>
                @if (signatory.SignedDate.HasValue)
                {
                    <span class="signatory-date">@signatory.SignedDate.Value.ToString("dd/MM/yyyy")</span>
                }
                <span class="badge @signatoryBadge">
                    <span class="status-dot @dotClass"></span> @signatory.Status
                </span>
            </div>
        }
    </div>
</div>
