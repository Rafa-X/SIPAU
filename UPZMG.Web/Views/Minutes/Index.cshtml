@model UPZMG.Web.Models.MinutesIndexViewModel
@{
    ViewData["Title"] = "Actas de Junta Directiva";
}

@section PageStyles {
    <link rel="stylesheet" href="~/css/minutes.css" asp-append-version="true" />
}

<!-- Page Header -->
<div class="page-header animate-fade-in">
    <div class="page-header-left">
        <h1>Actas de Junta Directiva</h1>
        <p>Seguimiento de firmas y estatus de actas institucionales</p>
    </div>
</div>

<div class="capture-section">
    <table class="capture-table">
        <thead>
            <tr>
                <th>Sesión</th>
                <th>Fecha</th>
                <th>Estado</th>
                <th style="text-align: right;">Acción</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var minute in Model.Minutes)
            {
                var badgeClass = minute.Status switch
                {
                    "Firmada" => "badge-success",
                    "En revisión gobierno" => "badge-info",
                    _ => "badge-warning"
                };

                <tr>
                    <td class="capture-area-name">@minute.SessionName</td>
                    <td>@minute.Date.ToString("dd/MM/yyyy")</td>
                    <td><span class="badge @badgeClass">@minute.Status</span></td>
                    <td style="text-align: right;">
                        <a asp-controller="Minutes" asp-action="Detail" asp-route-id="@minute.Id" class="btn btn-outline btn-sm">Ver firmantes</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
