@model UPZMG.Web.Models.ReportsTemplateViewModel
@{
    ViewData["Title"] = "Reportes 911";

    var reportOptions = new[]
    {
        new { Value = ReportType.AnexoTI, Label = "Anexo Tecnologias de la informacion" },
        new { Value = ReportType.Carrera911, Label = "Carrera 911" },
        new { Value = ReportType.FormatoSII, Label = "Formato SII" }
    };

    var selectedLabel = reportOptions
        .FirstOrDefault(x => Model.ReportType.HasValue && x.Value == Model.ReportType.Value)
        ?.Label;
}

@section PageStyles {
    <link rel="stylesheet" href="~/css/reports.css" asp-append-version="true" />
}

<div class="reports-shell">
    <section class="reports-header">
        <h1>Plantilla de Reportes 911</h1>
        <p>
            Selecciona el tipo de reporte que deseas crear. Esta vista queda como base para
            renderizar formularios dinamicos versionados por JSON en la siguiente etapa.
        </p>
    </section>

    <section class="reports-card">
        <h2>Nuevo Reporte</h2>
        <p>Elige una plantilla para iniciar la captura.</p>

        <form method="get" asp-controller="Reports" asp-action="LoadTemplate">
            <label class="reports-field-label" asp-for="ReportType">Tipo de reporte</label>
            <div class="reports-select-row">
                <select asp-for="ReportType" class="reports-select" required>
                    <option value="">Selecciona una opcion...</option>
                    @foreach (var option in reportOptions)
                    {
                        if (Model.ReportType.HasValue && option.Value == Model.ReportType.Value)
                        {
                            <option value="@option.Value" selected>@option.Label</option>
                        }
                        else
                        {
                            <option value="@option.Value">@option.Label</option>
                        }
                    }
                </select>
                <button type="submit" class="reports-btn">Preparar plantilla</button>
            </div>
        </form>

        @if (!string.IsNullOrWhiteSpace(selectedLabel))
        {
            <div class="reports-selected">
                Plantilla seleccionada: <strong>@selectedLabel</strong>
            </div>
        }

        <div class="reports-hint">
            Proximo paso: cargar la definicion versionada (JSON) de cada plantilla para construir
            el formulario HTML en tiempo de ejecucion.
        </div>
    </section>
</div>
