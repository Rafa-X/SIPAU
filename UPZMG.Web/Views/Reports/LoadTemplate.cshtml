@using UPZMG.Persistence.Models
@model UPZMG.Web.Models.ReportTemplateViewModel
@{
    ViewData["Title"] = "Reportes";

    var sectionCount = Model.Template?.Sections.Count ?? 0;
    var sectionIndex = sectionCount == 0 ? 0 : Math.Clamp(Model.SectionIndex, 0, sectionCount - 1);
    var currentSection = Model.Template?.Sections[sectionIndex];
    var isLastSection = sectionCount > 0 && sectionIndex >= sectionCount - 1;
    var actionLabel = isLastSection ? "Terminar Reporte" : "Siguiente seccion";

    string? GetAnswer(string key)
    {
        return Model.Answers.TryGetValue(key, out var value) ? value : null;
    }
}

@section PageStyles {
    <link rel="stylesheet" href="~/css/reports.css" asp-append-version="true" />
}

<div class="reports-shell">
    <section class="reports-header">
        <h1>@Model.Template?.ReportType</h1>
        <p>
            Reporte: @Model.Template?.ReportType | Version: @Model.Template?.Version | Estado: @Model.Template?.Status
        </p>
        <div class="reports-step-badge">
            Sección @(sectionIndex + 1) de @sectionCount
        </div>
    </section>

    <form class="reports-form-builder" method="post" asp-controller="Reports" asp-action="SaveDraft"
          id="reportForm"
          data-report-type="@Model.ReportType"
          data-template-key="@Model.Template?.ReportType"
          data-template-version="@Model.Template?.Version"
          data-report-id="@Model.Id">
        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="ReportType" />
        <input type="hidden" asp-for="TemplateVersion" />
        <input type="hidden" asp-for="SectionIndex" />
        <input type="hidden" id="SessionAnswersJson" name="sessionAnswersJson" value="" />

        @if (currentSection is not null)
        {
            <section class="reports-card reports-template-section">
                <h2>@(sectionIndex + 1). @(currentSection.Title)</h2>
                @if (!string.IsNullOrWhiteSpace(currentSection.Description))
                {
                    <p>@(currentSection.Description)</p>
                }

                @foreach (var question in currentSection.Questions)
                {
                    <div class="reports-question-block">
                        <label class="reports-field-label" for="@question.Key">
                            @question.Text
                            @if (question.Required)
                            {
                                <span class="reports-required">*</span>
                            }
                        </label>

                        @if (!string.IsNullOrWhiteSpace(question.HelpText))
                        {
                            <div class="reports-help-text">@question.HelpText</div>
                        }

                        @switch (question.Type.ToLowerInvariant())
                        {
                            case "boolean":
                                var boolAnswerKey = $"answers[{question.Key}]";
                                var boolAnswer = GetAnswer(boolAnswerKey);
                                <select id="@question.Key" name="answers[@question.Key]" class="reports-select" @(question.Required ? "required" : null)>
                                    <option value="">Selecciona...</option>
                                    @if (string.Equals(boolAnswer, "true", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <option value="true" selected>Si</option>
                                    }
                                    else
                                    {
                                        <option value="true">Si</option>
                                    }

                                    @if (string.Equals(boolAnswer, "false", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <option value="false" selected>No</option>
                                    }
                                    else
                                    {
                                        <option value="false">No</option>
                                    }
                                </select>
                                break;

                            case "number":
                                var numberAnswer = GetAnswer($"answers[{question.Key}]");
                                <input id="@question.Key"
                                       name="answers[@question.Key]"
                                       type="number"
                                       min="0"
                                       step="1"
                                       class="reports-input"
                                       value="@numberAnswer"
                                       @(question.Required ? "required" : null) />
                                break;

                            case "matrix":
                                <div class="reports-matrix-wrap">
                                    <table class="reports-matrix-table">
                                        <thead>
                                            <tr>
                                                <th>Concepto</th>
                                                @foreach (var col in question.Columns)
                                                {
                                                    <th>@col</th>
                                                }
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var row in question.Rows)
                                            {
                                                <tr>
                                                    <td>@row</td>
                                                    @foreach (var col in question.Columns)
                                                    {
                                                        var key = $"answers[{question.Key}][{row}][{col}]";
                                                        var matrixAnswer = GetAnswer(key);
                                                        <td>
                                                            <input type="number"
                                                                   min="0"
                                                                   step="1"
                                                                   name="@key"
                                                                   class="reports-input reports-input-sm"
                                                                   value="@matrixAnswer"
                                                                   @(question.Required ? "required" : null) />
                                                        </td>
                                                    }
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                                break;

                            default:
                                var textAnswer = GetAnswer($"answers[{question.Key}]");
                                <input id="@question.Key"
                                       name="answers[@question.Key]"
                                       type="text"
                                       class="reports-input"
                                    value="@textAnswer"
                                       @(question.Required ? "required" : null) />
                                break;
                        }
                    </div>
                }
            </section>
        }
        else
        {
            <section class="reports-card">
                <p>Este template no contiene secciones configuradas.</p>
            </section>
        }
        <!--ACTION BUTTONS-->
        <section class="reports-card">
            <div class="reports-actions">
                <div class="reports-actions-top">
                    @if (sectionIndex > 0)
                    {
                        <a class="reports-btn reports-btn-1"
                            asp-controller="Reports"
                            asp-action="LoadTemplate"
                            asp-route-ReportType="@Model.ReportType"
                            asp-route-Id="@Model.Id"
                            asp-route-SectionIndex="@(sectionIndex - 1)"
                            asp-route-TemplateVersion="@Model.TemplateVersion">
                            Seccion anterior
                        </a>
                    }
                    else
                    {
                        <button type="button" class="reports-btn reports-btn-1" disabled>Seccion anterior</button>
                    }

                    @if (isLastSection)
                    {
                        <button type="submit" name="submitAction" value="@ReportStatus.submitted.ToString()" class="reports-btn reports-btn-2">@actionLabel</button>
                    }
                    else
                    {
                        <button type="button"
                                id="ContinueSectionButton"
                                class="reports-btn reports-btn-2"
                                data-next-url="@Url.Action("LoadTemplate", "Reports", 
                                new { 
                                    ReportType = Model.ReportType, 
                                    Id = Model.Id, 
                                    SectionIndex = sectionIndex + 1, 
                                    TemplateVersion = Model.TemplateVersion 
                                })">
                            @actionLabel
                        </button>
                    }
                </div>

                <div class="reports-actions-bottom">
                    <a asp-controller="Reports" asp-action="Index" class="reports-btn reports-btn-3">Volver a selector</a>
                    <button type="submit" name="submitAction" value="@ReportStatus.draft.ToString()" class="reports-btn reports-btn-4">Guardar borrador</button>
                </div>
            </div>
        </section>
    </form>
</div>



@section Scripts {
  <script>
    @* window.addEventListener("load", function () {
      const cleanUrl = window.location.pathname;
      window.history.replaceState({}, document.title, cleanUrl);
    }); *@

    (function () {
      const form = document.getElementById('reportForm');
      if (!form) return;

      const reportType = form.dataset.reportType || 'unknown';
      const templateVersion = form.dataset.templateVersion || 'unknown';
      const reportId = form.dataset.reportId || 'new';
      const storageKey = `reports-template-json:${reportType}:${templateVersion}:${reportId}`;

      const answerFieldsSelector = '[name^="answers["]';
      const hiddenPayload = document.getElementById('SessionAnswersJson');
      const continueButton = document.getElementById('ContinueSectionButton');

      const safeParse = (raw) => {
        try {
          const parsed = JSON.parse(raw || '{}');
          return parsed && typeof parsed === 'object' ? parsed : {};
        } catch {
          return {};
        }
      };

      const collectCurrentFormAnswers = () => {
        const fields = form.querySelectorAll(answerFieldsSelector);
        const answers = {};

        fields.forEach((field) => {
          if (!field.name) return;
          answers[field.name] = field.value;
        });

        return answers;
      };

      const readStoredPayload = () => {
        try {
          const parsed = JSON.parse( sessionStorage.getItem(storageKey) || '{}');
          const mergedAnswers = {
            ...(parsed.answers || {})
          };

          return {
            meta: {
              reportType,
              templateVersion,
              reportId,
              updatedAt: new Date().toISOString()
            },
            answers: mergedAnswers
          };
        } catch {
          return {
            meta: {
              reportType,
              templateVersion,
              reportId,
              updatedAt: new Date().toISOString()
            },
            answers: {}
          };
        }
      };

      const persistAnswers = () => {
        const current = collectCurrentFormAnswers();
        const stored = readStoredPayload();
        const merged = {
          meta: {
            reportType,
            templateVersion,
            reportId,
            updatedAt: new Date().toISOString()
          },
          answers: {
            ...(stored.answers || {}),
            ...current
          }
        };

        sessionStorage.setItem(storageKey, JSON.stringify(merged));
        return merged;
      };

      const hydrateFormFromStorage = () => {
        const stored = readStoredPayload();
        const answers = stored.answers || {};

        Object.entries(answers).forEach(([name, value]) => {
          const field = form.querySelector(`[name="${CSS.escape(name)}"]`);
          if (!field) return;
          field.value = value ?? '';
        });
      };

      const updateHiddenPayload = () => {
        if (!hiddenPayload) return;
        const merged = persistAnswers();
        hiddenPayload.value = JSON.stringify(merged.answers || {});
      };

      hydrateFormFromStorage();

      const schedulePersist = (() => {
        let timer;
        return () => {
          window.clearTimeout(timer);
          timer = window.setTimeout(() => {
            persistAnswers();
          }, 300);
        };
      })();

      form.addEventListener('input', schedulePersist);
      form.addEventListener('change', schedulePersist);

      form.addEventListener('submit', (event) => {
        const submitter = event.submitter;
        const submitAction = submitter?.value || '';

        updateHiddenPayload();

        if (submitAction.toLowerCase() === 'submitted') {
          sessionStorage.removeItem(storageKey);
        }
      });

      if (continueButton) {
        continueButton.addEventListener('click', () => {
          persistAnswers();
          const nextUrl = continueButton.dataset.nextUrl;
          if (nextUrl) {
            window.location.assign(nextUrl);
          }
        });
      }
    })();
  </script>
}
