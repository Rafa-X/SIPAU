@model UPZMG.Web.Models.LoginViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Iniciar sesión — SIGIE — UPZMG" />
    <title>Iniciar Sesión — SIGIE</title>

    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <!-- Styles -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
</head>
<body>
    <div class="login-page">
        <!-- Branding Panel -->
        <div class="login-brand">
            <div class="login-brand-content">
                <div class="login-brand-logo">SIGIE</div>
                <div class="login-brand-version">1.0</div>
                <div class="login-brand-divider"></div>
                <div class="login-brand-name">
                    Sistema Inteligente de Gestión de Información Estadística
                </div>
                <div class="login-brand-subtitle">
                    Universidad Politécnica de la Zona Metropolitana de Guadalajara
                </div>
                <div class="login-brand-badge">
                    <span class="login-brand-badge-dot"></span>
                    Sistema en línea
                </div>
            </div>
        </div>

        <!-- Form Panel -->
        <div class="login-form-panel">
            <div class="login-form-container">
                <div class="login-form-header">
                    <h1>Bienvenido</h1>
                    <p>Ingresa tus credenciales para acceder al sistema</p>
                </div>

                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="login-error">
                        <span class="login-error-icon">⚠</span>
                        <span class="login-error-text">@Model.ErrorMessage</span>
                    </div>
                }

                <form method="post" asp-controller="Account" asp-action="Login" id="loginForm">
                    @Html.AntiForgeryToken()

                    <div class="login-input-group">
                        <label for="email">Correo electrónico</label>
                        <div class="login-input-wrapper">
                            <input
                                id="email"
                                name="Email"
                                type="email"
                                autocomplete="username"
                                placeholder="usuario@upzmg.edu.mx"
                                value="@Model.Email"
                                required />
                            <span class="input-icon">✉</span>
                        </div>
                    </div>

                    <div class="login-input-group">
                        <label for="password">Contraseña</label>
                        <div class="login-input-wrapper">
                            <input
                                id="password"
                                name="Password"
                                type="password"
                                autocomplete="current-password"
                                placeholder="••••••••"
                                required />
                            <span class="input-icon">🔒</span>
                        </div>
                    </div>

                    <button type="submit" class="login-submit-btn" id="loginBtn">
                        Iniciar Sesión
                    </button>
                </form>

                <div class="login-footer">
                    &copy; @DateTime.Now.Year — UPZMG · Todos los derechos reservados
                </div>
            </div>
        </div>
    </div>

    <script>
        // Add loading state on form submit
        document.getElementById('loginForm').addEventListener('submit', function () {
            var btn = document.getElementById('loginBtn');
            btn.classList.add('loading');
            btn.textContent = '';
        });
    </script>
</body>
</html>
