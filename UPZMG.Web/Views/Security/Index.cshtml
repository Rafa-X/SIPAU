@model UPZMG.Web.Models.Security.SecurityPageViewModel
@{
    ViewData["Title"] = "Security";
}

@section PageStyles {
    <link rel="stylesheet" href="~/css/security.css" asp-append-version="true" />
}

<div class="security-header">
    <h1>Security</h1>
    <p>Administra la asignacion de permisos por rol.</p>
</div>

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="security-status">@Model.StatusMessage</div>
}

<div class="security-layout">
    <section class="security-roles card">
        <h2>Role List</h2>

        @if (Model.Roles.Count == 0)
        {
            <p class="security-empty">No hay roles registrados.</p>
        }
        else
        {
            <ul class="security-role-list">
                @foreach (var role in Model.Roles)
                {
                    var selected = role.Id == Model.SelectedRoleId;
                    <li>
                        <a asp-controller="Security"
                           asp-action="Index"
                           asp-route-roleId="@role.Id"
                           class="security-role-item @(selected ? "active" : string.Empty)">
                            <span class="security-role-name">@role.Name</span>
                            <span class="security-role-count">@role.PermissionCount permisos</span>
                        </a>
                    </li>
                }
            </ul>
        }
    </section>

    <section class="security-permissions card">
        <h2>Permisos de @Model.SelectedRoleName</h2>

        @if (Model.SelectedRoleId is null)
        {
            <p class="security-empty">Selecciona un rol para gestionar sus permisos.</p>
        }
        else if (Model.Permissions.Count == 0)
        {
            <p class="security-empty">No hay permisos definidos en el sistema todavia.</p>
        }
        else
        {
            <div class="security-permission-list">
                @foreach (var permission in Model.Permissions)
                {
                    <article class="security-permission-row">
                        <div class="security-permission-main">
                            <div class="security-permission-title">@permission.Name</div>
                            <div class="security-permission-assigned">
                                Asignado en: @(permission.AssignedRoleNames.Count == 0
                                    ? "Ningun rol"
                                    : string.Join(", ", permission.AssignedRoleNames))
                            </div>
                        </div>
                        <form asp-controller="Security" asp-action="TogglePermission" method="post" class="security-toggle-form">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="roleId" value="@Model.SelectedRoleId" />
                            <input type="hidden" name="permissionName" value="@permission.Name" />
                            <input type="hidden" name="isEnabled" value="@(!permission.IsAssignedToSelectedRole).ToString().ToLowerInvariant()" />
                            <button type="submit"
                                    class="toggle @(permission.IsAssignedToSelectedRole ? "on" : "off")"
                                    role="switch"
                                    aria-checked="@permission.IsAssignedToSelectedRole.ToString().ToLowerInvariant()"
                                    aria-label="Cambiar permiso @permission.Name">
                                <span class="toggle-handle"></span>
                            </button>
                        </form>
                    </article>
                }
            </div>
        }
    </section>
</div>
