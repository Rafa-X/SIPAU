@model UPZMG.Web.Models.TeacherFormViewModel
@{
    ViewData["Title"] = "Registrar Docente";
}

<page-header title="Registrar Docente / Personal" subtitle="Captura de datos — Área de Recursos Humanos">
    <a asp-controller="DataCapture" asp-action="Index" class="btn btn-outline">
        <icon name="arrow-left" /> Volver a Capturas
    </a>
</page-header>

<div class="card animate-slide-up">
    <form method="post" asp-controller="DataCapture" asp-action="Teachers">
        @Html.AntiForgeryToken()

        <h3>Datos generales</h3>

        <div class="form-grid">
            <form-field label="Número de empleado" for="EmployeeNumber">
                <input asp-for="EmployeeNumber" class="form-control" placeholder="Ej. EMP-0421" required />
            </form-field>

            <form-field label="RFC" for="Rfc">
                <input asp-for="Rfc" class="form-control" maxlength="13" required />
            </form-field>

            <form-field label="Nombre(s)" for="FirstName">
                <input asp-for="FirstName" class="form-control" required />
            </form-field>

            <form-field label="Apellido paterno" for="LastName">
                <input asp-for="LastName" class="form-control" required />
            </form-field>

            <form-field label="Apellido materno" for="MiddleName">
                <input asp-for="MiddleName" class="form-control" />
            </form-field>

            <form-field label="CURP" for="Curp">
                <input asp-for="Curp" class="form-control" maxlength="18" required />
            </form-field>

            <form-field label="Fecha de nacimiento" for="BirthDate">
                <input asp-for="BirthDate" type="date" class="form-control" required />
            </form-field>

            <form-field label="Sexo" for="Gender">
                <select asp-for="Gender" class="form-control" required>
                    <option value="">Selecciona...</option>
                    <option value="Mujer">Mujer</option>
                    <option value="Hombre">Hombre</option>
                </select>
            </form-field>

            <form-field label="Máximo grado de estudios" for="MaxDegree">
                <select asp-for="MaxDegree" class="form-control" required>
                    <option value="">Selecciona...</option>
                    <option value="Licenciatura">Licenciatura</option>
                    <option value="Maestría">Maestría</option>
                    <option value="Doctorado">Doctorado</option>
                </select>
            </form-field>

            <form-field label="Tipo de contratación" for="ContractType">
                <select asp-for="ContractType" class="form-control" required>
                    <option value="">Selecciona...</option>
                    <option value="Tiempo Completo">Tiempo Completo</option>
                    <option value="Medio Tiempo">Medio Tiempo</option>
                    <option value="Asignatura">Asignatura</option>
                </select>
            </form-field>

            <form-field label="Área de adscripción" for="AreaId">
                <select asp-for="AreaId" class="form-control" asp-items="Model.Areas" required>
                    <option value="">Selecciona...</option>
                </select>
            </form-field>

            <form-field label="Horas semanales" for="WeeklyHours">
                <input asp-for="WeeklyHours" type="number" min="0" max="48" class="form-control" required />
            </form-field>

            <div class="form-group form-group-checkbox">
                <label for="HasPostgraduate">
                    <input asp-for="HasPostgraduate" type="checkbox" />
                    Cuenta con posgrado titulado
                </label>
            </div>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-accent">Guardar docente</button>
            <a asp-controller="DataCapture" asp-action="Index" class="btn btn-outline">Cancelar</a>
        </div>
    </form>
</div>
