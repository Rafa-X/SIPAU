@model UPZMG.Web.Models.FinanceFormViewModel
@{
    ViewData["Title"] = "Registrar Resumen Financiero";
}

<page-header title="Registrar Resumen Financiero Anual" subtitle="Captura de datos — Área de Finanzas">
    <a asp-controller="DataCapture" asp-action="Index" class="btn btn-outline">
        <icon name="arrow-left" /> Volver a Capturas
    </a>
</page-header>

<div class="card animate-slide-up">
    <form method="post" asp-controller="DataCapture" asp-action="Finance">
        @Html.AntiForgeryToken()

        <div class="form-group" style="max-width: 220px;">
            <label class="form-label" for="FiscalYear">Año fiscal</label>
            <input asp-for="FiscalYear" type="number" min="2000" max="2100" class="form-control" required />
        </div>

        <h3 class="mt-4">Ingresos por fuente (MXN)</h3>
        <div class="form-grid">
            <form-field label="Ingreso federal" for="FederalIncome">
                <input asp-for="FederalIncome" type="number" step="0.01" min="0" class="form-control" required />
            </form-field>
            <form-field label="Ingreso estatal" for="StateIncome">
                <input asp-for="StateIncome" type="number" step="0.01" min="0" class="form-control" required />
            </form-field>
            <form-field label="Ingreso propio — inscripciones" for="OwnIncomeEnrollment">
                <input asp-for="OwnIncomeEnrollment" type="number" step="0.01" min="0" class="form-control" required />
            </form-field>
            <form-field label="Ingreso propio — servicios" for="OwnIncomeServices">
                <input asp-for="OwnIncomeServices" type="number" step="0.01" min="0" class="form-control" required />
            </form-field>
        </div>

        <h3 class="mt-4">Egresos por tipo (MXN)</h3>
        <div class="form-grid">
            <form-field label="Gasto en nómina" for="PayrollExpense">
                <input asp-for="PayrollExpense" type="number" step="0.01" min="0" class="form-control" required />
            </form-field>
            <form-field label="Gasto en materiales" for="MaterialsExpense">
                <input asp-for="MaterialsExpense" type="number" step="0.01" min="0" class="form-control" required />
            </form-field>
            <form-field label="Gasto en servicios" for="ServicesExpense">
                <input asp-for="ServicesExpense" type="number" step="0.01" min="0" class="form-control" required />
            </form-field>
            <form-field label="Gasto en inversión" for="InvestmentExpense">
                <input asp-for="InvestmentExpense" type="number" step="0.01" min="0" class="form-control" required />
            </form-field>
        </div>

        <form-field label="Observaciones" for="Notes">
            <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
        </form-field>

        <div class="form-actions">
            <button type="submit" class="btn btn-accent">Guardar resumen</button>
            <a asp-controller="DataCapture" asp-action="Index" class="btn btn-outline">Cancelar</a>
        </div>
    </form>
</div>
