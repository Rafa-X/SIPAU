@model UPZMG.Web.Models.DataCaptureIndexViewModel
@{
    ViewData["Title"] = "Captura de Datos";

    string IconFor(string action) => action switch
    {
        "Students"       => "student",
        "Teachers"       => "teacher",
        "Infrastructure" => "building",
        "Extension"      => "link",
        "Finance"        => "money",
        _                => "student"
    };
}

<page-header title="Captura de Datos" subtitle="Registro y actualización de información estadística por área">
    <a asp-controller="DataCapture" asp-action="BulkImport" class="btn btn-outline">
        <icon name="upload" /> Importación masiva
    </a>
</page-header>

@if (ViewData["SuccessMessage"] is string successMessage)
{
    <div class="dashboard-alerts">
        <partial name="_AlertBannerPartial" model='new UPZMG.Web.Models.AlertBannerModel { Message = successMessage, Type = "success", Priority = "" }' />
    </div>
}

<section class="capture-section">
    <div class="capture-header">
        <div class="capture-header-left">
            <h3>Áreas de Captura</h3>
            <p>Estado de captura de información del periodo actual</p>
        </div>
    </div>

    <table class="data-table">
        <thead>
            <tr>
                <th>Área</th>
                <th>Progreso</th>
                <th>Estado</th>
                <th>Última actualización</th>
                <th class="col-actions">Acción</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var area in Model.Areas)
            {
                var fillClass = area.Percentage == 100 ? "complete" : area.Percentage >= 50 ? "warning" : "danger";
                var dotClass = area.Status switch { "Completo" => "complete", "En progreso" => "in-progress", _ => "pending" };
                var badgeClass = area.Status == "Completo" ? "badge-success" : area.Status == "En progreso" ? "badge-warning" : "badge-danger";

                <tr>
                    <td>
                        <div class="capture-area-name">
                            <icon name="@IconFor(area.ActionName)" class="icon--area" /> @area.AreaName
                        </div>
                        <div class="capture-area-responsible">Responsable: @area.ResponsiblePerson</div>
                    </td>
                    <td>
                        <div class="capture-progress-bar">
                            <div class="capture-progress-fill @fillClass" style="width: @area.Percentage%"></div>
                        </div>
                    </td>
                    <td>
                        <span class="badge @badgeClass"><span class="status-dot @dotClass"></span> @area.Status</span>
                    </td>
                    <td class="text-muted">@area.LastUpdated.ToString("dd/MM/yyyy")</td>
                    <td class="col-actions">
                        @if (area.IsCaptureAvailable)
                        {
                            <a asp-controller="DataCapture" asp-action="@area.ActionName" class="btn btn-accent btn-sm">Capturar</a>
                        }
                        else
                        {
                            <button type="button" class="btn btn-outline btn-sm" disabled title="Próximamente">Capturar</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</section>
