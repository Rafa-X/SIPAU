# Ejemplo de .env. No hace falta copiarlo a mano: despliegue/1-instalar.bat crea el .env con valores nuevos.
# El .env real no se sube a git.

# Contraseña de SQL Server para sa y dev_user: mínimo 8 caracteres con mayúsculas, minúsculas y números.
MSSQL_DEV_PASSWORD=
MSSQL_PID=Developer

# Secretos de la aplicación, de al menos 32 caracteres. Los usan los scripts de despliegue/.
SIPAU_JWT_KEY=
SIPAU_SHARED_SECRET=

# Opcionales
# Si el puerto 1433 ya está ocupado en esta computadora:
# SIPAU_DB_PORT=14333
# Otro nombre de contenedor:
# SIPAU_DB_CONTAINER=upzmg_db
# Memoria máxima de SQL Server, en MB:
# MSSQL_MEMORY_LIMIT_MB=2048
# Para usar un SQL Server propio en lugar de Docker:
# SIPAU_CONNECTION=Server=localhost;Database=upzmg;User Id=...;Password=...;TrustServerCertificate=True;Encrypt=True
